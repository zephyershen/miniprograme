{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "envId": "hyyc-1gi3f5sqc5becabf",
  "functionRoot": "hyyc/cloudfunctions",
  "functions": [
    {
      "name": "knowledgeFeed",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 300,
      "memorySize": 512,
      "installDependency": true,
      "triggers": [
        {
          "name": "knowledge-feed-source-sync",
          "type": "timer",
          "config": "0 * * * * * *"
        },
        {
          "name": "knowledge-feed-visual-worker",
          "type": "timer",
          "config": "10,25,40,55 * * * * * *"
        },
        {
          "name": "knowledge-feed-intelligence-worker",
          "type": "timer",
          "config": "30 */10 * * * * *"
        },
        {
          "name": "knowledge-feed-profile-review-worker",
          "type": "timer",
          "config": "20 * * * * * *"
        },
        {
          "name": "knowledge-feed-archive-maintenance",
          "type": "timer",
          "config": "0 15 * * * * *"
        },
        {
          "name": "knowledge-feed-legacy-visual-maintenance",
          "type": "timer",
          "config": "0 45 * * * * *"
        },
        {
          "name": "knowledge-feed-daily-digest",
          "type": "timer",
          "config": "0 0 8 * * * *"
        },
        {
          "name": "knowledge-feed-weekly-digest",
          "type": "timer",
          "config": "0 5 8 ? * 1 *"
        },
        {
          "name": "knowledge-feed-monthly-digest",
          "type": "timer",
          "config": "0 10 8 1 * ? *"
        }
      ],
      "ignore": [
        "node_modules/**",
        "config.local.js"
      ],
      "description": "Runs isolated source, profile review, archive, visual, intelligence, and calendar digest schedules."
    },
    {
      "name": "sourcePreviewWorker",
      "dir": "hyyc/cloudrun/source-preview-renderer",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 90,
      "memorySize": 2048,
      "installDependency": true,
      "ignore": [
        "node_modules/**",
        "Dockerfile",
        "README.md"
      ],
      "description": "Captures reviewed source-page visuals inside CloudBase and writes JPEG files directly to cloud storage."
    },
    {
      "name": "knowledgeOps",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 60,
      "memorySize": 256,
      "installDependency": true,
      "ignore": [
        "node_modules/**",
        "config.local.js"
      ],
      "description": "Private token-protected membership grants and knowledge operations status."
    },
    {
      "name": "membershipBilling",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 30,
      "memorySize": 256,
      "installDependency": true,
      "triggers": [
        {
          "name": "membership-billing-reconcile",
          "type": "timer",
          "config": "0 */15 * * * * *"
        }
      ],
      "ignore": [
        "node_modules/**",
        "config.local.js"
      ],
      "description": "Signs WeChat virtual purchases, verifies official order state, and grants membership idempotently."
    }
  ]
}
