@import "styles/shadcn.wxss";

/* 全局页面样式 - 现代 Lottie 风格 */
page {
  background: #F5F6F8;
  color: #1F2328;
  /* 让 iOS / 安卓 都尽量用各自更顺眼的系统字体（没有就自动用下一个） */
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'HarmonyOS Sans SC', 'Noto Sans SC', Roboto, 'Droid Sans Fallback', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
  /* 禁止全局左右滚动，只允许上下滚动 */
  overflow-x: hidden;
}

/* 安全区域适配 */
.safe {
  padding-bottom: env(safe-area-inset-bottom);
}
