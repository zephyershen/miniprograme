@import "./styles/editorial-tokens.wxss";

page {
  min-height: 100%;
  background: var(--editorial-paper);
  color: var(--editorial-ink);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

button {
  border-radius: 2rpx;
  font-size: 28rpx;
  font-weight: 600;
}

button::after {
  border: none;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 34rpx var(--editorial-gutter) 80rpx;
}

.page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.eyebrow {
  color: var(--editorial-muted);
  font-size: 22rpx;
  font-weight: 650;
  letter-spacing: 3rpx;
}

.page-title {
  margin-top: 8rpx;
  font-size: 50rpx;
  font-weight: 780;
  letter-spacing: -2rpx;
}

.page-subtitle {
  margin-top: 12rpx;
  color: var(--editorial-muted);
  font-size: 26rpx;
  line-height: 1.6;
}

.card {
  box-sizing: border-box;
  border-top: 1rpx solid var(--editorial-rule);
  border-bottom: 1rpx solid var(--editorial-rule);
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.primary-button {
  background: var(--editorial-ink);
  color: #ffffff;
}

.secondary-button {
  border: 1rpx solid var(--editorial-ink);
  background: transparent;
  color: var(--editorial-ink);
}

.danger-button {
  border: 1rpx solid #d9a9a2;
  background: transparent;
  color: var(--editorial-danger);
}

.ghost-button {
  padding: 0 22rpx;
  background: transparent;
  color: var(--editorial-ink);
  line-height: 64rpx;
}

.empty-state {
  padding: 92rpx 44rpx;
  text-align: center;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
}

.empty-copy {
  margin-top: 18rpx;
  color: var(--editorial-muted);
  line-height: 1.7;
}

.loading-copy {
  padding: 80rpx 0;
  color: var(--editorial-muted);
  text-align: center;
}

.modal-mask {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(17, 17, 17, 0.46);
}

.modal-panel {
  box-sizing: border-box;
  width: 100%;
  max-height: 88vh;
  padding: 34rpx 28rpx calc(34rpx + env(safe-area-inset-bottom));
  border-top: 8rpx solid var(--editorial-blue);
  border-radius: 0;
  background: var(--editorial-surface);
}

.modal-title {
  font-size: 36rpx;
  font-weight: 750;
}

.modal-copy {
  margin-top: 12rpx;
  color: var(--editorial-muted);
  line-height: 1.6;
}

.input {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  margin-top: 28rpx;
  padding: 24rpx;
  border: 1rpx solid var(--editorial-rule);
  border-radius: 0;
  background: var(--editorial-paper);
  line-height: 1.55;
}

.button-row {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.button-row button {
  flex: 1;
}
