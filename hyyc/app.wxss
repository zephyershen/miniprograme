page {
  min-height: 100%;
  background: #f7f4ed;
  color: #20231f;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

button {
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
}

button::after {
  border: none;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 28rpx 72rpx;
}

.page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.eyebrow {
  color: #887f72;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.page-title {
  margin-top: 8rpx;
  font-size: 50rpx;
  font-weight: 750;
  letter-spacing: -2rpx;
}

.page-subtitle {
  margin-top: 12rpx;
  color: #6e6a62;
  font-size: 26rpx;
  line-height: 1.6;
}

.card {
  box-sizing: border-box;
  border: 1rpx solid rgba(64, 58, 49, 0.08);
  border-radius: 26rpx;
  background: #fffdf8;
  box-shadow: 0 12rpx 36rpx rgba(57, 49, 38, 0.06);
}

.primary-button {
  background: #1f5b45;
  color: #ffffff;
}

.secondary-button {
  background: #e9e4d9;
  color: #283129;
}

.danger-button {
  background: #f6dfda;
  color: #963f32;
}

.ghost-button {
  padding: 0 22rpx;
  background: transparent;
  color: #1f5b45;
  line-height: 64rpx;
}

.empty-state {
  padding: 92rpx 44rpx;
  text-align: center;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
}

.empty-copy {
  margin-top: 18rpx;
  color: #777168;
  line-height: 1.7;
}

.loading-copy {
  padding: 80rpx 0;
  color: #777168;
  text-align: center;
}

.modal-mask {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(25, 28, 24, 0.42);
}

.modal-panel {
  box-sizing: border-box;
  width: 100%;
  max-height: 88vh;
  padding: 34rpx 28rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: #fffdf8;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 750;
}

.modal-copy {
  margin-top: 12rpx;
  color: #777168;
  line-height: 1.6;
}

.input {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  margin-top: 28rpx;
  padding: 24rpx;
  border: 1rpx solid #ded8cc;
  border-radius: 20rpx;
  background: #f8f5ef;
  line-height: 1.55;
}

.button-row {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.button-row button {
  flex: 1;
}
