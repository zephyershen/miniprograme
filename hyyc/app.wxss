@import "./styles/design-tokens.wxss";

page {
  min-height: 100%;
  background: var(--ui-canvas);
  color: var(--ui-ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

button {
  box-sizing: border-box;
  min-height: 88rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 88rpx;
  transition: opacity 160ms ease, transform 160ms ease;
}

button::after { border: none; }
button:active { opacity: 0.82; transform: scale(0.985); }

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 38rpx var(--ui-gutter) 96rpx;
}

.page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 34rpx;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--ui-muted);
  font-family: "DIN Alternate", -apple-system, "PingFang SC", sans-serif;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.eyebrow::before {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--ui-accent);
  content: "";
}

.page-title {
  margin-top: 14rpx;
  font-size: 52rpx;
  font-weight: 760;
  letter-spacing: -2rpx;
  line-height: 1.16;
}

.page-subtitle {
  max-width: 600rpx;
  margin-top: 12rpx;
  color: var(--ui-muted);
  font-size: 25rpx;
  line-height: 1.62;
}

.card {
  box-sizing: border-box;
  border: 1rpx solid var(--ui-hairline);
  border-radius: var(--ui-radius-lg);
  background: var(--ui-surface);
}

.primary-button {
  background: var(--ui-accent);
  color: #ffffff;
}

.secondary-button {
  border: 1rpx solid var(--ui-hairline);
  background: var(--ui-surface-solid);
  color: var(--ui-ink);
}

.danger-button {
  border: 1rpx solid rgba(182, 76, 75, 0.16);
  background: var(--ui-danger-soft);
  color: var(--ui-danger);
}

.ghost-button {
  min-height: 72rpx;
  padding: 0 26rpx;
  border: 1rpx solid var(--ui-hairline);
  background: var(--ui-surface-solid);
  color: var(--ui-ink);
  line-height: 72rpx;
}

.empty-state {
  padding: 86rpx 42rpx;
  text-align: center;
}

.empty-title { font-size: 34rpx; font-weight: 730; line-height: 1.4; }

.empty-copy {
  margin-top: 18rpx;
  color: var(--ui-muted);
  line-height: 1.7;
}

.loading-copy {
  padding: 82rpx 0;
  color: var(--ui-muted);
  text-align: center;
}

.modal-mask {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.4);
}

.modal-panel {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  max-height: 88vh;
  padding: 48rpx 30rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: var(--ui-radius-xl) var(--ui-radius-xl) 0 0;
  background: var(--ui-surface-solid);
  box-shadow: 0 -12rpx 40rpx rgba(15, 20, 25, 0.12);
}

.modal-panel::before {
  position: absolute;
  top: 16rpx;
  left: 50%;
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: rgba(23, 24, 29, 0.14);
  content: "";
  transform: translateX(-50%);
}

.modal-title { font-size: 36rpx; font-weight: 740; }

.modal-copy {
  margin-top: 12rpx;
  color: var(--ui-muted);
  line-height: 1.62;
}

.input {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  margin-top: 28rpx;
  padding: 24rpx;
  border: 1rpx solid var(--ui-hairline);
  border-radius: var(--ui-radius-md);
  background: var(--ui-surface-solid);
  box-shadow: inset 0 2rpx 8rpx rgba(24, 27, 36, 0.04);
  line-height: 1.55;
}

.button-row { display: flex; gap: 18rpx; margin-top: 24rpx; }
.button-row button { flex: 1; }
