<template name="commentInner">
  <view class="comment-meta">
    <view class="comment-author">
      <text class="comment-author-name">{{c.author.nickname}}</text>
      <block wx:if="{{c.replyToNickname && c.replyToCommentId !== c.parentCommentId}}">
        <text class="comment-reply-connector">›</text>
        <text class="comment-reply-target">{{c.replyToNickname}}</text>
      </block>
      <text wx:if="{{c.isMine}}" class="comment-mine">我</text>
      <text wx:if="{{c.statusLabel}}" class="comment-status">{{c.statusLabel}}</text>
    </view>
    <view class="comment-meta-actions">
      <text
        wx:if="{{c.canDelete}}"
        class="comment-action {{busy === c.id ? 'is-disabled' : ''}}"
        data-comment-id="{{c.id}}"
        data-action="delete"
        aria-role="button"
        aria-label="删除这条评论"
        aria-disabled="{{busy === c.id}}"
        catchtap="handleCommentAction"
      >删除</text>
      <text
        wx:if="{{c.canReport}}"
        class="comment-action {{c.reported || busy === c.id ? 'is-disabled' : ''}}"
        data-comment-id="{{c.id}}"
        data-action="report"
        aria-role="button"
        aria-label="{{c.reported ? '这条评论已举报' : '举报这条评论'}}"
        aria-disabled="{{c.reported || busy === c.id}}"
        catchtap="handleCommentAction"
      >{{c.reported ? '已举报' : '举报'}}</text>
      <text
        wx:if="{{c.canAppeal}}"
        class="comment-action {{busy === c.id ? 'is-disabled' : ''}}"
        data-comment-id="{{c.id}}"
        data-action="appeal"
        aria-role="button"
        aria-label="申诉这条被隐藏的评论"
        aria-disabled="{{busy === c.id}}"
        catchtap="handleCommentAction"
      >申诉</text>
      <text
        wx:if="{{c.canRestore}}"
        class="comment-action {{busy === c.id ? 'is-disabled' : ''}}"
        data-comment-id="{{c.id}}"
        data-action="restore"
        aria-role="button"
        aria-label="恢复这条评论"
        aria-disabled="{{busy === c.id}}"
        catchtap="handleCommentAction"
      >恢复</text>
    </view>
  </view>
  <view wx:if="{{detached}}" class="comment-detached-context">原评论暂不可见</view>
  <view wx:if="{{c.content}}" class="comment-copy">{{c.content}}</view>
  <view wx:if="{{c.attachmentCount}}" class="comment-media-grid count-{{c.attachmentCount}}">
    <block
      wx:for="{{c.attachments}}"
      wx:for-item="attachment"
      wx:for-index="attachmentIndex"
      wx:key="fileId"
    >
      <image
        wx:if="{{attachment.url}}"
        class="comment-media"
        src="{{attachment.url}}"
        mode="aspectFill"
        lazy-load="{{true}}"
        data-comment-id="{{c.id}}"
        data-file-id="{{attachment.fileId}}"
        data-attachment-index="{{attachmentIndex}}"
        bindtap="previewCommentImage"
        binderror="handleCommentImageError"
      />
      <view
        wx:else
        class="comment-media comment-media-placeholder {{c.reviewPending ? 'is-reviewing' : ''}}"
        aria-label="{{c.reviewPending ? '图片审核中' : '图片暂时无法显示'}}"
      >
        <view wx:if="{{c.reviewPending}}" class="comment-media-spinner"></view>
        <text>{{c.reviewPending ? '图片审核中' : '图片暂时无法显示'}}</text>
      </view>
    </block>
  </view>
  <view class="comment-foot">
    <text class="comment-time">{{c.createdLabel}}</text>
    <text
      wx:if="{{c.canReply}}"
      class="comment-reply-btn"
      data-comment-id="{{c.id}}"
      aria-role="button"
      aria-label="回复 {{c.author.nickname}}"
      bindtap="beginReply"
    >回复</text>
  </view>
</template>

<view wx:if="{{visible}}" class="comments-mask" bindtap="close">
  <view class="comments-sheet {{keyboardOpen ? 'comments-sheet-keyboard' : ''}}" style="{{sheetStyle}}" catchtap="noop">
    <view class="comments-head">
      <view class="comments-title">评论 {{displayCommentCount || ''}}</view>
      <view class="comments-close" bindtap="close">关闭</view>
    </view>
    <scroll-view
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      scroll-into-view="{{scrollIntoCommentId}}"
      scroll-with-animation="{{true}}"
      class="comments-list"
    >
      <view wx:if="{{commentsLoading}}" class="comments-state">正在读取评论…</view>
      <view wx:elif="{{!comments.length}}" class="comments-state">
        <view class="comments-empty-title">{{canParticipate ? '还没有评论' : '没有待处理的评论'}}</view>
        <view>{{canParticipate ? '从一个具体判断开始，会更容易聊下去。' : '会员到期后，你仍可在这里查看、申诉或删除自己被隐藏的评论。'}}</view>
      </view>
      <block wx:else>
        <view
          wx:for="{{commentThreads}}"
          wx:key="id"
          id="comment-{{item.root.id}}"
          class="comment-row {{item.root.isHidden ? 'is-hidden' : ''}} {{item.root.reviewPending ? 'is-reviewing' : ''}}"
        >
          <view class="comment-avatar-wrap">
            <image wx:if="{{item.root.author.avatarUrl}}" class="comment-avatar" src="{{item.root.author.avatarUrl}}" mode="aspectFill" lazy-load="{{true}}" data-comment-id="{{item.root.id}}" binderror="handleCommentAvatarError" />
            <view wx:else class="comment-avatar comment-avatar-empty">{{item.root.author.initial}}</view>
          </view>
          <view class="comment-body">
            <template is="commentInner" data="{{c: item.root, busy: commentActionBusyId, detached: item.isDetachedReply}}" />
            <view wx:if="{{item.replyCount}}" class="comment-replies">
              <block wx:for="{{item.visibleReplies}}" wx:for-item="reply" wx:key="id">
                <view
                  id="comment-{{reply.id}}"
                  class="comment-reply {{reply.isHidden ? 'is-hidden' : ''}} {{reply.reviewPending ? 'is-reviewing' : ''}}"
                >
                  <view class="comment-avatar-wrap">
                    <image wx:if="{{reply.author.avatarUrl}}" class="comment-avatar comment-avatar-sm" src="{{reply.author.avatarUrl}}" mode="aspectFill" lazy-load="{{true}}" data-comment-id="{{reply.id}}" binderror="handleCommentAvatarError" />
                    <view wx:else class="comment-avatar comment-avatar-sm comment-avatar-empty">{{reply.author.initial}}</view>
                  </view>
                  <view class="comment-body">
                    <template is="commentInner" data="{{c: reply, busy: commentActionBusyId}}" />
                  </view>
                </view>
              </block>
              <view
                wx:if="{{item.hiddenReplyCount}}"
                class="comment-reply-more"
                data-root-id="{{item.root.id}}"
                aria-role="button"
                aria-label="展开剩余 {{item.hiddenReplyCount}} 条回复"
                bindtap="expandReplies"
              ><text class="comment-reply-more-line"></text><text>展开 {{item.hiddenReplyCount}} 条回复</text><text class="comment-reply-more-caret">⌄</text></view>
              <view
                wx:elif="{{item.visibleReplies.length && !item.isCollapsed}}"
                class="comment-reply-more"
                data-root-id="{{item.root.id}}"
                aria-role="button"
                aria-label="收起回复"
                bindtap="collapseReplies"
              ><text class="comment-reply-more-line"></text><text>收起</text><text class="comment-reply-more-caret">⌃</text></view>
            </view>
          </view>
        </view>
      </block>
    </scroll-view>
    <view wx:if="{{canParticipate}}" class="comment-compose">
      <view wx:if="{{composerExpanded && !viewerProfile.isComplete}}" class="comment-profile-reminder" bindtap="openProfileEditor">
        <view class="reminder-avatar">{{viewerProfile.initial}}</view>
        <view wx:if="{{viewerProfile.reviewPending}}"><view class="reminder-title">资料审核中</view><view class="reminder-copy">审核通过后即可发布评论</view></view>
        <view wx:else><view class="reminder-title">先设置头像和昵称</view><view class="reminder-copy">发布时会显示在你的评论旁边</view></view>
        <text>→</text>
      </view>
      <view wx:if="{{replyTarget}}" class="comment-replying">
        <view>
          <text>回复 @{{replyTarget.nickname}}</text>
          <text class="comment-replying-preview">{{replyTarget.preview}}</text>
        </view>
        <text class="comment-replying-close" bindtap="cancelReply">取消</text>
      </view>
      <view wx:if="{{commentDraftImages.length}}" class="comment-draft-media">
        <view wx:for="{{commentDraftImages}}" wx:key="tempFilePath" class="comment-draft-image-wrap">
          <image class="comment-draft-image" src="{{item.tempFilePath}}" mode="aspectFill" data-path="{{item.tempFilePath}}" bindtap="previewDraftImage" />
          <view class="comment-image-remove" data-index="{{index}}" catchtap="removeCommentImage">×</view>
        </view>
      </view>
      <textarea
        class="comment-input"
        maxlength="280"
        auto-height="{{true}}"
        focus="{{commentInputFocus}}"
        adjust-position="{{false}}"
        cursor-spacing="24"
        show-confirm-bar="{{false}}"
        value="{{commentDraft}}"
        placeholder="{{replyTarget ? ('回复 @' + replyTarget.nickname + '…') : '写下你看到的变化或判断…'}}"
        bindinput="onCommentInput"
        bindfocus="onCommentFocus"
        bindblur="onCommentBlur"
        bindkeyboardheightchange="onKeyboardHeightChange"
      />
      <view wx:if="{{composerExpanded}}" class="comment-compose-foot">
        <view class="comment-tools">
          <view class="comment-tool" bindtap="chooseCommentImages"><view class="comment-photo-icon"></view><text>图片</text></view>
          <view class="comment-tool {{emojiOpen ? 'is-active' : ''}}" bindtap="toggleEmojiPanel"><text class="comment-emoji-icon">☺</text><text>表情</text></view>
        </view>
        <text class="comment-count {{commentSubmitting ? 'is-reviewing' : ''}}">{{commentSubmitting ? commentSubmitStatus : (commentDraft.length + ' / 280')}}</text>
        <button
          class="comment-submit"
          disabled="{{(!commentDraft.length && !commentDraftImages.length) || commentSubmitting}}"
          loading="{{commentSubmitting}}"
          bindtap="submitComment"
        >发送</button>
      </view>
      <scroll-view wx:if="{{composerExpanded && emojiOpen}}" scroll-y enhanced show-scrollbar="{{false}}" class="comment-emojis">
        <view class="comment-emoji-grid">
          <view wx:for="{{emojiOptions}}" wx:key="*this" class="comment-emoji" data-emoji="{{item}}" bindtap="insertEmoji">{{item}}</view>
        </view>
      </scroll-view>
    </view>
    <view wx:elif="{{commentsResolved}}" class="comment-governance-footer">
      <view>这里只显示需要你处理的历史评论。</view>
      <button class="comment-governance-benefits" bindtap="showMembershipBenefits">查看会员评论权益</button>
    </view>
    <canvas
      type="2d"
      id="commentMediaCompressor"
      class="media-compressor-canvas"
    />
  </view>
</view>
