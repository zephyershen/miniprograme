<view wx:if="{{show}}" class="loading-mask">
  <view class="loading-card card">
    <view class="spinner" aria-hidden="true">
      <view class="spinner-wheel">
        <view
          wx:for="{{spokes}}"
          wx:key="id"
          class="spinner-spoke {{item.className}}">
        </view>
      </view>
    </view>
    <text class="loading-text">{{text}}</text>
    <text class="loading-subtext">请稍候片刻</text>
  </view>
</view>
