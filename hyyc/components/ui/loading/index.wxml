<!--
  不要用 wx:if 反复创建/销毁节点：
  在开发者工具里频繁 show/hide 可能会累计事件监听，出现“possibly causing memory leak”的提示。
  用 hidden 保留节点，配合 JS 里 pause/resume 动画即可。
-->
<view class="loading-mask" hidden="{{!show}}">
  <view class="loading-card card">
    <view class="lottie-box">
      <canvas type="2d" id="loading-canvas" class="lottie-canvas"></canvas>
    </view>
    <view class="loading-text-row">
      <text class="loading-text">{{text}}</text>
      <view class="dots">
        <view class="dot d1"></view>
        <view class="dot d2"></view>
        <view class="dot d3"></view>
      </view>
    </view>
  </view>
</view>
