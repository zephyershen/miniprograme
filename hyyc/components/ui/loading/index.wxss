@import "../../../styles/shadcn.wxss";

/* 全屏遮罩 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  background: rgba(246, 247, 249, 0.96);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 中间卡片，沿用 card 风格 */
.loading-card {
  min-width: 260rpx;
  max-width: 420rpx;
  padding: 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* Lottie 动画容器 */
.lottie-box {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lottie-canvas {
  width: 200rpx;
  height: 200rpx;
}

/* 文案 + 跳动的点 */
.loading-text-row {
  display: flex;
  align-items: center;
}

.loading-text {
  font-size: 28rpx;
  color: #4b5563;
}

.dots {
  display: flex;
  margin-left: 8rpx;
  align-items: baseline;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  background: #9ca3af;
  border-radius: 50%;
  margin: 0 3rpx;
  animation: bounce 1.4s infinite ease-in-out both;
}

.d1 { animation-delay: -0.32s; }
.d2 { animation-delay: -0.16s; }
.d3 { animation-delay: 0s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}
