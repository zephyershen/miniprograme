@import "../../../styles/shadcn.wxss";

.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  background: rgba(246, 247, 249, 0.96);
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-card {
  min-width: 260rpx;
  max-width: 420rpx;
  padding: 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.spinner {
  width: 136rpx;
  height: 136rpx;
  position: relative;
  margin-bottom: 24rpx;
}

.spinner-ring {
  position: absolute;
  inset: 0;
  border-radius: 999rpx;
  border: 10rpx solid transparent;
  animation: spinner-rotate 1.15s linear infinite;
}

.spinner-ring-a {
  border-top-color: #b95e49;
  border-right-color: rgba(185, 94, 73, 0.4);
}

.spinner-ring-b {
  inset: 18rpx;
  border-width: 8rpx;
  border-bottom-color: #e3b5a8;
  border-left-color: rgba(227, 181, 168, 0.45);
  animation-direction: reverse;
  animation-duration: 1.5s;
}

.loading-text-row {
  display: flex;
  align-items: center;
}

.loading-text {
  font-size: 28rpx;
  color: #4b5563;
}

.dots {
  display: flex;
  margin-left: 8rpx;
  align-items: baseline;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  background: #9ca3af;
  border-radius: 50%;
  margin: 0 3rpx;
  animation: bounce 1.4s infinite ease-in-out both;
}

.d1 { animation-delay: -0.32s; }
.d2 { animation-delay: -0.16s; }
.d3 { animation-delay: 0s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

@keyframes spinner-rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
