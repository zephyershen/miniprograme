@import "../../../styles/shadcn.wxss";

.error-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  background: rgba(246, 247, 249, 0.96);
  display: flex;
  align-items: center;
  justify-content: center;
}

.error-card {
  min-width: 260rpx;
  max-width: 520rpx;
  padding: 32rpx 40rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.lottie-box {
  width: 280rpx;
  height: 280rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lottie-canvas {
  width: 280rpx;
  height: 280rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 8rpx;
}

.message {
  font-size: 30rpx;
  color: #4b5563;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.actions {
  width: 100%;
  display: flex;
  justify-content: center;
}

/* 错误弹层里的确认按钮做得更小一些 */
.actions .btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 40rpx;
  font-size: 26rpx;
}
