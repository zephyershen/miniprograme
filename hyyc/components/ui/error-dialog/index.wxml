<view class="error-mask" wx:if="{{show}}">
  <view class="error-card card">
    <view class="lottie-box">
      <canvas type="2d" id="error-canvas" class="lottie-canvas"></canvas>
    </view>
    <view class="title" wx:if="{{title}}">{{title}}</view>
    <view class="message">{{message}}</view>
    <view class="actions">
      <view class="btn btn-primary" bindtap="onConfirm">{{confirmText}}</view>
    </view>
  </view>
</view>
