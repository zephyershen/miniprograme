/*
  现代苹果风格主题系统
  设计理念：简洁、温暖、高级感
  配色：莫兰迪暖色系 + 充足留白 + 柔和阴影
*/

/* ========== 主题配色系统 ========== */

/* 品牌色（暖色系） */
.color-primary { color: #FF8B7B; }      /* 珊瑚橙 - 主色调 */
.color-secondary { color: #FFB4A9; }    /* 蜜桃粉 - 次要色 */
.color-accent { color: #FFD07F; }       /* 暖金色 - 强调色 */
.color-neutral { color: #3D3229; }      /* 深褐色 - 文字主色 */

/* 语义色 */
.color-info { color: #A0C4FF; }         /* 浅蓝 - 信息提示 */
.color-success { color: #8ED6A9; }      /* 薄荷绿 - 成功状态 */
.color-warning { color: #FFBC6F; }      /* 暖橙 - 警告提示 */
.color-error { color: #FF6B6B; }        /* 珊瑚红 - 错误/危险 */

/* 背景色（三层级） */
.bg-base-100 { background: #F8F7F4; }   /* 主背景 - 暖白色 */
.bg-base-200 { background: #F2EDE8; }   /* 次级背景 - 浅褐色 */
.bg-base-300 { background: #E8E0D8; }   /* 三级背景 - 褐灰色 */

/* 兼容旧版类名 */
.c-text { color: #3D3229; }
.c-muted { color: #A0826D; }
.c-primary { color: #FF8B7B; }
.c-danger { color: #FF6B6B; }
.bg-page { background: #F8F7F4; }
.bg-card { background: #ffffff; }
.bg-primary { background: #FF8B7B; }
.bg-muted { background: #F2EDE8; }
.bg-danger { background: #FF6B6B; }


/* ========== 边框与圆角 ========== */

.b { border: 1rpx solid #E8E0D8; }
.br { border-radius: 16rpx; }           /* 标准圆角（更大） */
.br-lg { border-radius: 20rpx; }        /* 大圆角 */
.br-full { border-radius: 9999rpx; }    /* 完全圆形 */


/* ========== 阴影系统（多层次柔和阴影） ========== */

.shadow-sm {
  box-shadow: 0 2rpx 8rpx rgba(61, 50, 41, 0.04),
              0 1rpx 3rpx rgba(61, 50, 41, 0.02);
}

.shadow {
  box-shadow: 0 4rpx 16rpx rgba(61, 50, 41, 0.06),
              0 2rpx 8rpx rgba(61, 50, 41, 0.04);
}

.shadow-lg {
  box-shadow: 0 8rpx 32rpx rgba(61, 50, 41, 0.08),
              0 4rpx 16rpx rgba(61, 50, 41, 0.04);
}


/* ========== 间距系统 ========== */

/* Padding */
.p-8 { padding: 8rpx; }
.p-12 { padding: 12rpx; }
.p-16 { padding: 16rpx; }
.p-20 { padding: 20rpx; }
.p-24 { padding: 24rpx; }
.p-32 { padding: 32rpx; }

.px-16 { padding-left: 16rpx; padding-right: 16rpx; }
.px-24 { padding-left: 24rpx; padding-right: 24rpx; }
.px-32 { padding-left: 32rpx; padding-right: 32rpx; }

.py-12 { padding-top: 12rpx; padding-bottom: 12rpx; }
.py-16 { padding-top: 16rpx; padding-bottom: 16rpx; }
.py-20 { padding-top: 20rpx; padding-bottom: 20rpx; }

/* Margin */
.m-8 { margin: 8rpx; }
.m-16 { margin: 16rpx; }
.m-24 { margin: 24rpx; }

.mt-8 { margin-top: 8rpx; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-24 { margin-top: 24rpx; }

.mb-12 { margin-bottom: 12rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }

/* Gap */
.gap-8 > view + view { margin-top: 8rpx; }
.gap-12 > view + view { margin-top: 12rpx; }
.gap-16 > view + view { margin-top: 16rpx; }
.row-gap-8 > view + view { margin-left: 8rpx; }
.row-gap-12 > view + view { margin-left: 12rpx; }


/* ========== 布局系统 ========== */

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.col {
  display: flex;
  flex-direction: column;
}

.center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.space-between {
  justify-content: space-between;
}

.space-around {
  justify-content: space-around;
}

.wrap {
  flex-wrap: wrap;
}


/* ========== 文字系统 ========== */

.text-xs { font-size: 22rpx; }
.text-sm { font-size: 24rpx; }
.text-base { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-2xl { font-size: 40rpx; }

.font-normal { font-weight: 400; }
.font-medium { font-weight: 500; }
.font-semibold { font-weight: 600; }
.bold { font-weight: 600; }
.font-bold { font-weight: 700; }


/* ========== 按钮系统（苹果风格渐变按钮） ========== */

.btn {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 32rpx;
  border-radius: 16rpx;
  border: none;
  background: #ffffff;
  color: #3D3229;
  box-shadow: 0 2rpx 8rpx rgba(61, 50, 41, 0.06);
  transition: all 0.3s ease;
  font-weight: 600;
}

.btn:active {
  transform: translateY(2rpx);
  opacity: 0.9;
}

/* 渐变按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #FF8B7B 0%, #FF7A69 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(255, 139, 123, 0.3);
}

.btn-secondary {
  background: linear-gradient(135deg, #FFB4A9 0%, #FFA399 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(255, 180, 169, 0.3);
}

.btn-accent {
  background: linear-gradient(135deg, #FFD07F 0%, #FFC56F 100%);
  color: #5D4E3F;
  box-shadow: 0 4rpx 16rpx rgba(255, 208, 127, 0.3);
}

.btn-neutral {
  background: #3D3229;
  color: #ffffff;
}

.btn-info {
  background: linear-gradient(135deg, #A0C4FF 0%, #8FB4EF 100%);
  color: #1A3A5C;
  box-shadow: 0 4rpx 16rpx rgba(160, 196, 255, 0.3);
}

.btn-success {
  background: linear-gradient(135deg, #8ED6A9 0%, #7DC699 100%);
  color: #0F4A2C;
  box-shadow: 0 4rpx 16rpx rgba(142, 214, 169, 0.3);
}

.btn-warning {
  background: linear-gradient(135deg, #FFBC6F 0%, #FFAC5F 100%);
  color: #5D3200;
  box-shadow: 0 4rpx 16rpx rgba(255, 188, 111, 0.3);
}

.btn-danger,
.btn-error {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF5555 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.3);
}

.btn-outline {
  background: transparent;
  color: #FF8B7B;
  border: 2rpx solid #FF8B7B;
  box-shadow: none;
}

.btn-outline:active {
  background: rgba(255, 139, 123, 0.08);
}

.btn-sm {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}


/* ========== 输入框系统 ========== */

.field {
  display: flex;
  flex-direction: column;
}

.field-label {
  font-size: 28rpx;
  color: #5D4E3F;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.input,
.textarea {
  background: #FEFCFB;
  border: 2rpx solid #E8E0D8;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  font-size: 28rpx;
  color: #3D3229;
  transition: all 0.3s ease;
}

.input:focus,
.textarea:focus {
  border-color: #FF8B7B;
  background: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(255, 139, 123, 0.1);
}

.textarea {
  height: 220rpx;
  line-height: 1.6;
}


/* ========== 卡片系统（磨砂玻璃效果） ========== */

.card {
  background: #ffffff;
  border: 1rpx solid #F2EDE8;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 50, 41, 0.06),
              0 2rpx 8rpx rgba(61, 50, 41, 0.04);
  transition: all 0.3s ease;
}

.card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 24rpx rgba(61, 50, 41, 0.08);
}

.card-glass {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3D3229;
  line-height: 1.4;
}

.card-sub {
  font-size: 26rpx;
  color: #A0826D;
  margin-top: 8rpx;
}


/* ========== 徽标系统 ========== */

.badge {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 9999rpx;
  border: none;
  background: #F2EDE8;
  color: #5D4E3F;
  font-weight: 500;
}

.badge-primary {
  background: rgba(255, 139, 123, 0.15);
  color: #D65A48;
}

.badge-secondary {
  background: rgba(255, 180, 169, 0.15);
  color: #E66B5A;
}

.badge-accent {
  background: rgba(255, 208, 127, 0.15);
  color: #CC8F3F;
}

.badge-success {
  background: rgba(142, 214, 169, 0.15);
  color: #4A9C6C;
}

.badge-warning {
  background: rgba(255, 188, 111, 0.15);
  color: #CC7A37;
}

.badge-danger,
.badge-error {
  background: rgba(255, 107, 107, 0.15);
  color: #D63F3F;
}


/* ========== 头像系统 ========== */

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 9999rpx;
  background: #F2EDE8;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(61, 50, 41, 0.08);
}

.avatar-lg {
  width: 96rpx;
  height: 96rpx;
}

.avatar-sm {
  width: 48rpx;
  height: 48rpx;
}


/* ========== 分割线 ========== */

.divider {
  height: 1rpx;
  background: #E8E0D8;
  margin: 20rpx 0;
}


/* ========== 工具类 ========== */

.opacity-50 { opacity: 0.5; }
.opacity-60 { opacity: 0.6; }
.opacity-80 { opacity: 0.8; }

.transition { transition: all 0.3s ease; }
