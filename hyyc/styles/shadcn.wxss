/*
  多抓鱼 / 日系极简风（克制留白 + 砖红主色 + 墨绿点缀）
  目标：少渐变、少高饱和、卡片化、圆角更大、阴影更轻
*/

/* ========== 主题配色系统 ========== */

/* 品牌色（更克制的低饱和） */
.color-primary { color: #B95E49; }      /* 砖红 - 主色调 */
.color-secondary { color: #DBB4AB; }    /* 浅砖粉 - 次要色 */
.color-accent { color: #447244; }       /* 墨绿 - 强调色 */
.color-neutral { color: #1F2328; }      /* 深灰 - 正文主色 */

/* 语义色 */
.color-info { color: #4DA3FF; }         /* 蓝色 - 信息提示 */
.color-success { color: #447244; }      /* 墨绿 - 成功状态 */
.color-warning { color: #FBBF24; }      /* 暖橙 - 警告提示 */
.color-error { color: #EF4444; }        /* 红色 - 错误/危险 */

/* 背景色（三层级） */
.bg-base-100 { background: #F5F6F8; }   /* 主背景 - 轻灰白 */
.bg-base-200 { background: #F2F3F5; }   /* 次级背景 - 更浅灰 */
.bg-base-300 { background: #E9EBEF; }   /* 三级背景 - 分割/边框 */

/* 兼容旧版类名 */
.c-text { color: #1F2328; }
.c-muted { color: #6B7280; }
.c-primary { color: #B95E49; }
.c-danger { color: #EF4444; }
.bg-page { background: #F5F6F8; }
.bg-card { background: #ffffff; }
.bg-primary { background: #B95E49; }
.bg-muted { background: #F2F3F5; }
.bg-danger { background: #EF4444; }


/* ========== 边框与圆角 ========== */

.b { border: 1rpx solid #EDEFF2; }
.br { border-radius: 20rpx; }           /* 标准圆角 */
.br-lg { border-radius: 24rpx; }        /* 大圆角 */
.br-full { border-radius: 9999rpx; }    /* 完全圆形 */


/* ========== 阴影系统（多层次柔和阴影） ========== */

.shadow-sm {
  box-shadow: 0 2rpx 8rpx rgba(17, 24, 39, 0.04),
              0 1rpx 3rpx rgba(17, 24, 39, 0.02);
}

.shadow {
  box-shadow: 0 4rpx 16rpx rgba(17, 24, 39, 0.06),
              0 2rpx 8rpx rgba(17, 24, 39, 0.04);
}

.shadow-lg {
  box-shadow: 0 8rpx 32rpx rgba(17, 24, 39, 0.08),
              0 4rpx 16rpx rgba(17, 24, 39, 0.06);
}


/* ========== 间距系统 ========== */

/* Padding */
.p-8 { padding: 8rpx; }
.p-12 { padding: 12rpx; }
.p-16 { padding: 16rpx; }
.p-20 { padding: 20rpx; }
.p-24 { padding: 24rpx; }
.p-32 { padding: 32rpx; }

.px-16 { padding-left: 16rpx; padding-right: 16rpx; }
.px-24 { padding-left: 24rpx; padding-right: 24rpx; }
.px-32 { padding-left: 32rpx; padding-right: 32rpx; }

.py-12 { padding-top: 12rpx; padding-bottom: 12rpx; }
.py-16 { padding-top: 16rpx; padding-bottom: 16rpx; }
.py-20 { padding-top: 20rpx; padding-bottom: 20rpx; }

/* Margin */
.m-8 { margin: 8rpx; }
.m-16 { margin: 16rpx; }
.m-24 { margin: 24rpx; }

.mt-8 { margin-top: 8rpx; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-24 { margin-top: 24rpx; }

.mb-12 { margin-bottom: 12rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }

/* Gap
   说明：组件 wxss 只允许使用 class 选择器，所以这里不再使用标签选择器 view。
   使用额外的子元素类名来实现同样的间距效果。 */
.gap-8 > .gap-item + .gap-item { margin-top: 8rpx; }
.gap-12 > .gap-item + .gap-item { margin-top: 12rpx; }
.gap-16 > .gap-item + .gap-item { margin-top: 16rpx; }
.row-gap-8 > .row-gap-item + .row-gap-item { margin-left: 8rpx; }
.row-gap-12 > .row-gap-item + .row-gap-item { margin-left: 12rpx; }


/* ========== 布局系统 ========== */

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.col {
  display: flex;
  flex-direction: column;
}

.center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.space-between {
  justify-content: space-between;
}

.space-around {
  justify-content: space-around;
}

.wrap {
  flex-wrap: wrap;
}


/* ========== 文字系统 ========== */

.text-xs { font-size: 22rpx; }
.text-sm { font-size: 24rpx; }
.text-base { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-2xl { font-size: 40rpx; }

.font-normal { font-weight: 400; }
.font-medium { font-weight: 500; }
.font-semibold { font-weight: 600; }
.bold { font-weight: 600; }
.font-bold { font-weight: 700; }


/* ========== 按钮系统（苹果风格渐变按钮） ========== */

.btn {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 32rpx;
  border-radius: 9999rpx;
  border: 1rpx solid #EDEFF2;
  background: #ffffff;
  color: #1F2328;
  box-shadow: 0 2rpx 10rpx rgba(17, 24, 39, 0.06);
  transition: background-color 0.2s ease, opacity 0.2s ease;
  font-weight: 600;
}

.btn:active {
  opacity: 0.92;
}

/* 更克制的按钮（以纯色为主） */
.btn-primary {
  background: #B95E49;
  border-color: #B95E49;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(185, 94, 73, 0.28);
}

.btn-secondary {
  background: #DBB4AB;
  border-color: #DBB4AB;
  color: #1F2328;
  box-shadow: 0 8rpx 24rpx rgba(219, 180, 171, 0.24);
}

.btn-accent {
  background: #447244;
  border-color: #447244;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(68, 114, 68, 0.24);
}

.btn-neutral {
  background: #1F2328;
  border-color: #1F2328;
  color: #ffffff;
}

.btn-info {
  background: #4DA3FF;
  border-color: #4DA3FF;
  color: #0B192E;
  box-shadow: 0 8rpx 24rpx rgba(77, 163, 255, 0.24);
}

.btn-success {
  background: #447244;
  border-color: #447244;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(68, 114, 68, 0.24);
}

.btn-warning {
  background: #FBBF24;
  border-color: #FBBF24;
  color: #451A03;
  box-shadow: 0 8rpx 24rpx rgba(251, 191, 36, 0.22);
}

.btn-danger,
.btn-error {
  background: #EF4444;
  border-color: #EF4444;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(239, 68, 68, 0.24);
}

.btn-outline {
  background: transparent;
  color: #B95E49;
  border: 2rpx solid #B95E49;
  box-shadow: none;
}

.btn-outline:active {
  background: rgba(185, 94, 73, 0.08);
}

.btn-sm {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}


/* ========== 输入框系统 ========== */

.field {
  display: flex;
  flex-direction: column;
}

.field-label {
  font-size: 28rpx;
  color: #1F2328;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.input,
.textarea {
  background: #ffffff;
  border: 2rpx solid #D1D5DB;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  font-size: 28rpx;
  color: #1F2328;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.input:focus,
.textarea:focus {
  border-color: #B95E49;
  box-shadow: 0 0 0 6rpx rgba(185, 94, 73, 0.12);
}

.textarea {
  height: 220rpx;
  line-height: 1.6;
}


/* ========== 卡片系统（磨砂玻璃效果） ========== */

.card {
  background: #ffffff;
  border: 1rpx solid #EDEFF2;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.06),
              0 3rpx 10rpx rgba(17, 24, 39, 0.04);
  transition: box-shadow 0.2s ease, transform 0.2s ease;
}

.card:active {
  transform: translateY(-1rpx);
  box-shadow: 0 10rpx 28rpx rgba(17, 24, 39, 0.07),
              0 4rpx 12rpx rgba(17, 24, 39, 0.05);
}

.card-glass {
  background: rgba(255, 255, 255, 0.86);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2328;
  line-height: 1.4;
}

.card-sub {
  font-size: 26rpx;
  color: #6B7280;
  margin-top: 8rpx;
}


/* ========== 徽标系统 ========== */

.badge {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 9999rpx;
  border: 1rpx solid #EDEFF2;
  background: #F2F3F5;
  color: #6B7280;
  font-weight: 500;
}

.badge-primary {
  background: rgba(185, 94, 73, 0.12);
  border-color: rgba(185, 94, 73, 0.14);
  color: #B95E49;
}

.badge-secondary {
  background: rgba(219, 180, 171, 0.18);
  border-color: rgba(219, 180, 171, 0.22);
  color: #7A4A3E;
}

.badge-accent {
  background: rgba(68, 114, 68, 0.12);
  border-color: rgba(68, 114, 68, 0.14);
  color: #447244;
}

.badge-success {
  background: rgba(68, 114, 68, 0.12);
  border-color: rgba(68, 114, 68, 0.14);
  color: #447244;
}

.badge-warning {
  background: rgba(255, 188, 111, 0.15);
  color: #CC7A37;
}

.badge-danger,
.badge-error {
  background: rgba(239, 68, 68, 0.12);
  border-color: rgba(239, 68, 68, 0.14);
  color: #EF4444;
}


/* ========== 头像系统 ========== */

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 9999rpx;
  background: #F2F3F5;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(17, 24, 39, 0.06);
}

.avatar-lg {
  width: 96rpx;
  height: 96rpx;
}

.avatar-sm {
  width: 48rpx;
  height: 48rpx;
}


/* ========== 分割线 ========== */

.divider {
  height: 1rpx;
  background: #EDEFF2;
  margin: 20rpx 0;
}


/* ========== 工具类 ========== */

.opacity-50 { opacity: 0.5; }
.opacity-60 { opacity: 0.6; }
.opacity-80 { opacity: 0.8; }

.transition { transition: all 0.2s ease; }
