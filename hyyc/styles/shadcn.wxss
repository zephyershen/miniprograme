/*
  现代 Lottie 风格主题系统
  设计理念：大面积留白 + 明亮珊瑚橙 + 柔和阴影
  配色灵感：Shopping Bag Lottie 动画
*/

/* ========== 主题配色系统 ========== */

/* 品牌色（暖色系） */
.color-primary { color: #FF6B6B; }      /* 珊瑚红 - 主色调 */
.color-secondary { color: #FFB5A7; }    /* 肉粉色 - 次要色 */
.color-accent { color: #FFE066; }       /* 暖黄色 - 强调色 */
.color-neutral { color: #2F3437; }      /* 深灰色 - 正文主色 */

/* 语义色 */
.color-info { color: #4DA3FF; }         /* 亮蓝 - 信息提示 */
.color-success { color: #34D399; }      /* 绿色 - 成功状态 */
.color-warning { color: #FBBF24; }      /* 暖橙 - 警告提示 */
.color-error { color: #EF4444; }        /* 红色 - 错误/危险 */

/* 背景色（三层级） */
.bg-base-100 { background: #FDFDFE; }   /* 主背景 - 偏冷白 */
.bg-base-200 { background: #F3F4F6; }   /* 次级背景 - 浅灰 */
.bg-base-300 { background: #E5E7EB; }   /* 三级背景 - 中性灰 */

/* 兼容旧版类名 */
.c-text { color: #2F3437; }
.c-muted { color: #6B7280; }
.c-primary { color: #FF6B6B; }
.c-danger { color: #EF4444; }
.bg-page { background: #FDFDFE; }
.bg-card { background: #ffffff; }
.bg-primary { background: #FF6B6B; }
.bg-muted { background: #F3F4F6; }
.bg-danger { background: #EF4444; }


/* ========== 边框与圆角 ========== */

.b { border: 1rpx solid #E8E0D8; }
.br { border-radius: 16rpx; }           /* 标准圆角（更大） */
.br-lg { border-radius: 20rpx; }        /* 大圆角 */
.br-full { border-radius: 9999rpx; }    /* 完全圆形 */


/* ========== 阴影系统（多层次柔和阴影） ========== */

.shadow-sm {
  box-shadow: 0 2rpx 8rpx rgba(61, 50, 41, 0.04),
              0 1rpx 3rpx rgba(61, 50, 41, 0.02);
}

.shadow {
  box-shadow: 0 4rpx 16rpx rgba(61, 50, 41, 0.06),
              0 2rpx 8rpx rgba(61, 50, 41, 0.04);
}

.shadow-lg {
  box-shadow: 0 8rpx 32rpx rgba(61, 50, 41, 0.08),
              0 4rpx 16rpx rgba(61, 50, 41, 0.04);
}


/* ========== 间距系统 ========== */

/* Padding */
.p-8 { padding: 8rpx; }
.p-12 { padding: 12rpx; }
.p-16 { padding: 16rpx; }
.p-20 { padding: 20rpx; }
.p-24 { padding: 24rpx; }
.p-32 { padding: 32rpx; }

.px-16 { padding-left: 16rpx; padding-right: 16rpx; }
.px-24 { padding-left: 24rpx; padding-right: 24rpx; }
.px-32 { padding-left: 32rpx; padding-right: 32rpx; }

.py-12 { padding-top: 12rpx; padding-bottom: 12rpx; }
.py-16 { padding-top: 16rpx; padding-bottom: 16rpx; }
.py-20 { padding-top: 20rpx; padding-bottom: 20rpx; }

/* Margin */
.m-8 { margin: 8rpx; }
.m-16 { margin: 16rpx; }
.m-24 { margin: 24rpx; }

.mt-8 { margin-top: 8rpx; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-24 { margin-top: 24rpx; }

.mb-12 { margin-bottom: 12rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }

/* Gap
   说明：组件 wxss 只允许使用 class 选择器，所以这里不再使用标签选择器 view。
   使用额外的子元素类名来实现同样的间距效果。 */
.gap-8 > .gap-item + .gap-item { margin-top: 8rpx; }
.gap-12 > .gap-item + .gap-item { margin-top: 12rpx; }
.gap-16 > .gap-item + .gap-item { margin-top: 16rpx; }
.row-gap-8 > .row-gap-item + .row-gap-item { margin-left: 8rpx; }
.row-gap-12 > .row-gap-item + .row-gap-item { margin-left: 12rpx; }


/* ========== 布局系统 ========== */

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.col {
  display: flex;
  flex-direction: column;
}

.center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.space-between {
  justify-content: space-between;
}

.space-around {
  justify-content: space-around;
}

.wrap {
  flex-wrap: wrap;
}


/* ========== 文字系统 ========== */

.text-xs { font-size: 22rpx; }
.text-sm { font-size: 24rpx; }
.text-base { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-2xl { font-size: 40rpx; }

.font-normal { font-weight: 400; }
.font-medium { font-weight: 500; }
.font-semibold { font-weight: 600; }
.bold { font-weight: 600; }
.font-bold { font-weight: 700; }


/* ========== 按钮系统（苹果风格渐变按钮） ========== */

.btn {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 32rpx;
  border-radius: 16rpx;
  border: none;
  background: #ffffff;
  color: #3D3229;
  box-shadow: 0 2rpx 8rpx rgba(61, 50, 41, 0.06);
  transition: all 0.3s ease;
  font-weight: 600;
}

.btn:active {
  transform: translateY(2rpx);
  opacity: 0.9;
}

/* 渐变按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF7F6E 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(239, 68, 68, 0.32);
}

.btn-secondary {
  background: linear-gradient(135deg, #FFB5A7 0%, #FFA69E 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(255, 180, 169, 0.3);
}

.btn-accent {
  background: linear-gradient(135deg, #FFE066 0%, #FACC15 100%);
  color: #3B3A2E;
  box-shadow: 0 4rpx 16rpx rgba(250, 204, 21, 0.32);
}

.btn-neutral {
  background: #2F3437;
  color: #ffffff;
}

.btn-info {
  background: linear-gradient(135deg, #4DA3FF 0%, #3B82F6 100%);
  color: #0B192E;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.32);
}

.btn-success {
  background: linear-gradient(135deg, #34D399 0%, #22C55E 100%);
  color: #052E16;
  box-shadow: 0 4rpx 16rpx rgba(34, 197, 94, 0.3);
}

.btn-warning {
  background: linear-gradient(135deg, #FBBF24 0%, #F59E0B 100%);
  color: #451A03;
  box-shadow: 0 4rpx 16rpx rgba(245, 158, 11, 0.32);
}

.btn-danger,
.btn-error {
  background: linear-gradient(135deg, #EF4444 0%, #DC2626 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(239, 68, 68, 0.32);
}

.btn-outline {
  background: transparent;
  color: #FF6B6B;
  border: 2rpx solid #FF6B6B;
  box-shadow: none;
}

.btn-outline:active {
  background: rgba(255, 107, 107, 0.08);
}

.btn-sm {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}


/* ========== 输入框系统 ========== */

.field {
  display: flex;
  flex-direction: column;
}

.field-label {
  font-size: 28rpx;
  color: #5D4E3F;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.input,
.textarea {
  background: #FEFCFB;
  border: 2rpx solid #E8E0D8;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  font-size: 28rpx;
  color: #3D3229;
  transition: all 0.3s ease;
}

.input:focus,
.textarea:focus {
  border-color: #FF8B7B;
  background: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(255, 139, 123, 0.1);
}

.textarea {
  height: 220rpx;
  line-height: 1.6;
}


/* ========== 卡片系统（磨砂玻璃效果） ========== */

.card {
  background: #ffffff;
  border: 1rpx solid #F2EDE8;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 50, 41, 0.06),
              0 2rpx 8rpx rgba(61, 50, 41, 0.04);
  transition: all 0.3s ease;
}

.card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 24rpx rgba(61, 50, 41, 0.08);
}

.card-glass {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3D3229;
  line-height: 1.4;
}

.card-sub {
  font-size: 26rpx;
  color: #A0826D;
  margin-top: 8rpx;
}


/* ========== 徽标系统 ========== */

.badge {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 9999rpx;
  border: none;
  background: #F2EDE8;
  color: #5D4E3F;
  font-weight: 500;
}

.badge-primary {
  background: rgba(255, 139, 123, 0.15);
  color: #D65A48;
}

.badge-secondary {
  background: rgba(255, 180, 169, 0.15);
  color: #E66B5A;
}

.badge-accent {
  background: rgba(255, 208, 127, 0.15);
  color: #CC8F3F;
}

.badge-success {
  background: rgba(142, 214, 169, 0.15);
  color: #4A9C6C;
}

.badge-warning {
  background: rgba(255, 188, 111, 0.15);
  color: #CC7A37;
}

.badge-danger,
.badge-error {
  background: rgba(255, 107, 107, 0.15);
  color: #D63F3F;
}


/* ========== 头像系统 ========== */

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 9999rpx;
  background: #F2EDE8;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(61, 50, 41, 0.08);
}

.avatar-lg {
  width: 96rpx;
  height: 96rpx;
}

.avatar-sm {
  width: 48rpx;
  height: 48rpx;
}


/* ========== 分割线 ========== */

.divider {
  height: 1rpx;
  background: #E8E0D8;
  margin: 20rpx 0;
}


/* ========== 工具类 ========== */

.opacity-50 { opacity: 0.5; }
.opacity-60 { opacity: 0.6; }
.opacity-80 { opacity: 0.8; }

.transition { transition: all 0.3s ease; }
