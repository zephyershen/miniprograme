page {
  /* Modern editorial: soft canvas, elevated white cards, restrained accent. */
  --ui-canvas: #f6f8fa;
  --ui-canvas-deep: #eceff3;
  --ui-surface: #ffffff;
  --ui-surface-solid: #ffffff;
  --ui-surface-muted: #f3f5f7;
  --ui-ink: #10151b;
  --ui-muted: #5a6672;
  --ui-faint: #93a0ac;
  --ui-hairline: #ecf0f3;
  --ui-accent: #1d9bf0;
  --ui-accent-strong: #1478c4;
  --ui-accent-soft: #e9f4fd;
  --ui-violet: #1d9bf0;
  --ui-like: #f91880;
  --ui-like-soft: #fdeaf2;
  --ui-repost: #00ba7c;
  --ui-coral: #f4212e;
  --ui-amber: #b68016;
  --ui-lime: #00ba7c;
  --ui-cyan: #1d9bf0;
  --ui-danger: #f4212e;
  --ui-danger-soft: #fdeff0;
  --ui-gutter: 30rpx;
  --ui-radius-sm: 12rpx;
  --ui-radius-md: 18rpx;
  --ui-radius-lg: 28rpx;
  --ui-radius-xl: 32rpx;
  --ui-shadow-soft: 0 1rpx 2rpx rgba(16, 24, 40, 0.04);
  --ui-shadow-raised: 0 6rpx 24rpx rgba(15, 20, 25, 0.08);
  --ui-shadow-accent: 0 8rpx 22rpx rgba(29, 155, 240, 0.28);
  --ui-shadow-card: 0 1rpx 2rpx rgba(16, 24, 40, 0.04), 0 14rpx 30rpx rgba(16, 24, 40, 0.05);

  /* Compatibility aliases keep feature pages decoupled from theme naming. */
  --editorial-paper: var(--ui-canvas);
  --editorial-surface: var(--ui-surface-solid);
  --editorial-ink: var(--ui-ink);
  --editorial-muted: var(--ui-muted);
  --editorial-faint: var(--ui-faint);
  --editorial-rule: var(--ui-hairline);
  --editorial-blue: var(--ui-accent);
  --editorial-coral: var(--ui-coral);
  --editorial-amber: var(--ui-amber);
  --editorial-lime: var(--ui-lime);
  --editorial-cyan: var(--ui-cyan);
  --editorial-danger: var(--ui-danger);
  --editorial-gutter: var(--ui-gutter);
}
