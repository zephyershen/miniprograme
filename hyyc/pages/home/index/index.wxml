<ui-loading show="{{isLoading && !needsLogin}}" />
<view wx:if="{{needsLogin}}" class="px-24 py-16">
  <ui-card title="请先登录">
    <view class="text-sm c-muted" style="line-height: 1.6;">
      登录后可查看任务列表与更多功能。
    </view>
    <view class="mt-16 row">
      <view class="btn btn-primary" bindtap="goWelcome">登录 / 注册</view>
    </view>
  </ui-card>
</view>

<view wx:elif="{{needsRealname}}" class="px-24 py-16">
  <ui-card title="完成实名后可查看任务">
    <view class="text-sm c-muted" style="line-height: 1.6;">
      你已经完成基础注册，但社区任务属于小区内部信息。完成实名后，才会开放任务查看、接单和沟通功能。
    </view>
    <view class="mt-16 row">
      <view class="btn btn-primary" bindtap="goRealname">去实名</view>
    </view>
  </ui-card>
</view>

<view wx:else class="px-24 py-16">
  <view class="row mt-16 row-gap-8 wrap">
    <view class="{{'badge row-gap-item ' + (filter==='all'?'badge-primary':'')}}" bindtap="changeFilter" data-k="all">
      全部
    </view>
    <view class="{{'badge row-gap-item ' + (filter==='new'?'badge-primary':'')}}" bindtap="changeFilter" data-k="new">
      最新
    </view>
    <view class="{{'badge row-gap-item ' + (filter==='building'?'badge-primary':'')}}" bindtap="changeFilter" data-k="building">
      本楼栋
    </view>
    <view class="row-gap-item">
      <picker mode="selector" range="{{locationFilterLabels}}" value="{{locationFilterIndex}}" bindchange="onLocationFilterChange">
        <view class="{{'badge ' + (locationFilter!=='all' ? 'badge-primary' : '')}}">
          任务地点：{{locationFilterLabels[locationFilterIndex]}}
        </view>
      </picker>
    </view>
  </view>

  <block wx:for="{{list}}" wx:key="id">
    <view class="mt-16">
      <ui-card title="{{item.title}}" sub="{{item.community}} · 截止时间 {{item.deadlineText}}">
        <view class="row space-between">
          <text class="text-lg bold c-danger">¥ {{item.amountText}}</text>
          <view class="row row-gap-8">
            <view class="row row-gap-8 task-status-active">
              <view class="task-status-dot row-gap-item"></view>
              <text class="task-status-text row-gap-item">生效中</text>
            </view>
            <view class="btn btn-outline btn-sm row-gap-item" data-id="{{item.id}}" bindtap="toDetail">
              详情
            </view>
          </view>
        </view>
        <view wx:if="{{item.desc && item.desc.length > 0}}" class="mt-24">
          <view class="task-desc-row" data-id="{{item.id}}" bindtap="toggleDesc">
            <text class="task-desc-text c-muted">任务说明</text>
            <view class="task-desc-arrow {{item.descExpanded ? 'expanded' : ''}}"></view>
          </view>
          <view wx:if="{{item.descExpanded}}" class="mt-8 text-sm c-text">{{item.desc}}</view>
        </view>
      </ui-card>
    </view>
  </block>

  <view wx:if="{{!list.length && !isLoading}}" class="center" style="height: 50vh;">
    <text class="c-muted">暂无任务，去发布一个吧 ~</text>
  </view>
</view>
