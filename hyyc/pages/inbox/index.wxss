.editorial-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 8rpx var(--editorial-gutter) 110rpx;
}

.channel-scroll {
  width: 100%;
  border-bottom: 1rpx solid var(--editorial-rule);
  background: var(--editorial-paper);
  white-space: nowrap;
}

.channel-track {
  display: inline-flex;
  min-width: 100%;
}

.channel-tab {
  position: relative;
  flex: none;
  padding: 26rpx 28rpx 23rpx 0;
  color: var(--editorial-faint);
  font-size: 24rpx;
  font-weight: 650;
}

.channel-tab + .channel-tab { padding-left: 28rpx; }
.channel-tab-active { color: var(--editorial-ink); }

.channel-tab-active::after {
  position: absolute;
  right: 28rpx;
  bottom: -1rpx;
  left: 0;
  height: 5rpx;
  background: var(--editorial-ink);
  content: "";
}

.channel-tab + .channel-tab.channel-tab-active::after { left: 28rpx; }
.channel-tab-cobalt::after { background: var(--editorial-blue); }
.channel-tab-coral::after { background: var(--editorial-coral); }
.channel-tab-amber::after { background: var(--editorial-amber); }
.channel-tab-lime::after { background: var(--editorial-lime); }
.channel-tab-cyan::after { background: var(--editorial-cyan); }

.channel-count {
  margin-left: 8rpx;
  font-size: 18rpx;
  vertical-align: top;
}

.loading-editorial {
  padding: 34rpx 0 80rpx;
  border-bottom: 1rpx solid var(--editorial-rule);
}

.loading-media {
  width: 100%;
  height: 350rpx;
  background: #e1ded7;
}

.loading-line {
  width: 72%;
  height: 16rpx;
  margin-top: 22rpx;
  background: #d9d6cf;
}

.loading-line-strong { width: 88%; height: 30rpx; background: #aaa8a2; }
.loading-line-short { width: 44%; }

.empty-editorial {
  min-height: 480rpx;
  padding: 110rpx 0 80rpx;
  border-bottom: 1rpx solid var(--editorial-rule);
}

.empty-title {
  width: 88%;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.35;
}

.empty-copy {
  width: 86%;
  margin-top: 20rpx;
  color: var(--editorial-muted);
  font-size: 24rpx;
  line-height: 1.7;
}

.empty-action {
  width: 220rpx;
  margin: 34rpx 0 0;
  border: 1rpx solid var(--editorial-ink);
  border-radius: 0;
  background: transparent;
  color: var(--editorial-ink);
  font-size: 23rpx;
  line-height: 72rpx;
}

.lead-story {
  padding: 34rpx 0 44rpx;
  border-bottom: 1rpx solid var(--editorial-rule);
}

.lead-cover {
  display: block;
  width: 100%;
  height: 360rpx;
  background: #e1ded7;
}

.story-meta,
.lead-footer,
.section-heading {
  display: flex;
  align-items: center;
}

.story-meta {
  gap: 16rpx;
  margin-top: 20rpx;
  color: var(--editorial-muted);
  font-size: 19rpx;
  line-height: 1.4;
}

.channel-label {
  color: var(--editorial-blue);
  font-weight: 750;
}

.channel-text-coral { color: var(--editorial-coral); }
.channel-text-amber { color: #9c6900; }
.channel-text-lime { color: #4f7400; }
.channel-text-cyan { color: #007a94; }

.lead-title {
  margin-top: 18rpx;
  font-size: 42rpx;
  font-weight: 820;
  line-height: 1.32;
  letter-spacing: -1rpx;
}

.lead-summary {
  margin-top: 16rpx;
  color: var(--editorial-muted);
  font-size: 25rpx;
  line-height: 1.7;
}

.lead-footer {
  justify-content: space-between;
  margin-top: 22rpx;
  color: var(--editorial-muted);
  font-size: 20rpx;
}

.section-heading {
  justify-content: space-between;
  padding: 34rpx 0 22rpx;
  border-bottom: 1rpx solid var(--editorial-ink);
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
}

.section-count {
  color: var(--editorial-muted);
  font-size: 20rpx;
}

.story-row {
  display: flex;
  gap: 24rpx;
  min-height: 210rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--editorial-rule);
}

.story-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.story-row .story-meta { margin-top: 0; }

.story-title {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 760;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.story-action {
  overflow: hidden;
  margin-top: auto;
  padding-top: 16rpx;
  color: var(--editorial-muted);
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.story-thumbnail {
  flex: none;
  width: 216rpx;
  height: 152rpx;
  background: #e1ded7;
}
