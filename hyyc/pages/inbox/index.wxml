<view class="editorial-page">
  <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="channel-scroll">
    <view class="channel-track">
      <view
        wx:for="{{feed.channels}}"
        wx:key="key"
        class="channel-tab {{item.active ? 'channel-tab-active channel-tab-' + item.tone : ''}}"
        data-key="{{item.key}}"
        bindtap="selectChannel"
      >
        <text>{{item.label}}</text>
        <text wx:if="{{item.count}}" class="channel-count">{{item.count}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="filter-bar" bindtap="openFilters">
    <view class="filter-bar-copy">
      <text class="filter-bar-title">筛选</text>
      <text class="filter-bar-summary">{{feed.filterSummary}}</text>
    </view>
    <view class="filter-bar-count">
      <text class="filter-bar-result">{{feed.resultCount}} 条资讯 ↘</text>
      <text wx:if="{{feed.totalAvailable}}" class="filter-bar-total">本周收录 {{feed.totalAvailable}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-editorial">
    <view class="loading-media"></view>
    <view class="loading-line loading-line-strong"></view>
    <view class="loading-line"></view>
    <view class="loading-line loading-line-short"></view>
  </view>

  <view wx:elif="{{feedError}}" class="empty-editorial">
    <view class="empty-title">资讯暂时没有加载成功</view>
    <view class="empty-copy">{{feedError}}</view>
    <button class="empty-action" bindtap="retryFeed">重新加载</button>
  </view>

  <view wx:elif="{{!feed.visibleItems.length}}" class="empty-editorial">
    <view class="empty-title">没有符合当前条件的资讯</view>
    <view class="empty-copy">可以调整时间或主题，也可以切换其他频道查看。</view>
    <button class="empty-action" bindtap="openFilters">调整筛选</button>
  </view>

  <block wx:else>
    <view class="lead-story {{feed.leadItem.coverFileId ? '' : 'lead-story-text'}}" data-id="{{feed.leadItem.id}}" bindtap="openFeedItem">
      <image wx:if="{{feed.leadItem.coverFileId}}" class="lead-cover" src="{{feed.leadItem.coverFileId}}" mode="aspectFill" lazy-load="{{true}}" />
      <view class="story-meta">
        <text class="channel-label channel-text-{{feed.leadItem.coverTone}}">{{feed.leadItem.categoryLabel}}</text>
        <text>{{feed.leadItem.source}}</text>
        <text>{{feed.leadItem.publishedLabel}}</text>
      </view>
      <view class="lead-title">{{feed.leadItem.title}}</view>
      <view wx:if="{{feed.leadItem.summaryPreview}}" class="lead-summary">{{feed.leadItem.summaryPreview}}</view>
      <view class="lead-footer">
        <text>{{feed.leadItem.scoreLabel}}</text>
        <text>查看详情 →</text>
      </view>
    </view>

    <view wx:if="{{feed.remainingItems.length}}" class="section-heading">
      <view class="section-title">更多资讯</view>
      <view class="section-count">{{feed.remainingItems.length}}</view>
    </view>

    <view class="story-list">
      <view
        wx:for="{{feed.remainingItems}}"
        wx:key="id"
        class="story-row {{item.coverFileId ? '' : 'story-row-no-image'}}"
        data-id="{{item.id}}"
        bindtap="openFeedItem"
      >
        <view class="story-copy">
          <view class="story-meta">
            <text class="channel-label channel-text-{{item.coverTone}}">{{item.categoryLabel}}</text>
            <text>{{item.publishedLabel}}</text>
          </view>
          <view class="story-title">{{item.title}}</view>
          <view class="story-action">{{item.source}} · {{item.scoreLabel}}</view>
        </view>
        <image wx:if="{{item.coverFileId}}" class="story-thumbnail" src="{{item.coverFileId}}" mode="aspectFill" lazy-load="{{true}}" />
      </view>
    </view>
  </block>

  <view wx:if="{{filterOpen}}" class="feed-filter-mask" bindtap="closeFilters">
    <view class="feed-filter-panel" catchtap="stopPropagation">
      <view class="filter-panel-head">
        <view>
          <view class="filter-panel-kicker">内容筛选</view>
          <view class="filter-panel-title">找到你关心的更新</view>
          <view class="filter-panel-status">共收录 {{feed.totalAvailable}} 条，筛选结果按当前频道实时计算</view>
        </view>
        <view class="filter-panel-close" bindtap="closeFilters">关闭</view>
      </view>

      <scroll-view scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{filterScrollTarget}}" class="filter-panel-scroll">
        <view class="filter-scroll-content">
        <view id="filter-time-group" class="filter-group">
          <view class="filter-group-title">时间范围</view>
          <view class="filter-choice-list">
            <view
              wx:for="{{filterOptions.time}}"
              wx:key="key"
              class="filter-choice {{item.active ? 'filter-choice-active' : ''}} {{item.disabled ? 'filter-choice-disabled' : ''}}"
              data-group="time"
              data-key="{{item.key}}"
              bindtap="selectFilter"
            ><text>{{item.label}}</text><text class="filter-choice-count">{{item.count}}</text></view>
          </view>
        </view>

        <view class="filter-group">
          <view class="filter-group-title">公司与模型</view>
          <view class="filter-group-note">追踪厂商、模型系列与产品动态</view>
          <view class="filter-choice-list">
            <view
              wx:for="{{filterOptions.company}}"
              wx:key="key"
              class="filter-choice {{item.active ? 'filter-choice-active' : ''}} {{item.disabled ? 'filter-choice-disabled' : ''}}"
              data-group="company"
              data-key="{{item.key}}"
              bindtap="selectFilter"
            ><text>{{item.label}}</text><text class="filter-choice-count">{{item.count}}</text></view>
          </view>
        </view>

        <view class="filter-group">
          <view class="filter-group-title">技术方向</view>
          <view class="filter-group-note">按能力、工程和研究方向继续缩小范围</view>
          <view class="filter-choice-list">
            <view
              wx:for="{{filterOptions.direction}}"
              wx:key="key"
              class="filter-choice {{item.active ? 'filter-choice-active' : ''}} {{item.disabled ? 'filter-choice-disabled' : ''}}"
              data-group="direction"
              data-key="{{item.key}}"
              bindtap="selectFilter"
            ><text>{{item.label}}</text><text class="filter-choice-count">{{item.count}}</text></view>
          </view>
        </view>
        </view>
      </scroll-view>

      <view class="filter-panel-actions">
        <button class="filter-reset" bindtap="resetFilters">重置</button>
        <button class="filter-apply" bindtap="applyFilters">查看 {{draftCount}} 条</button>
      </view>
    </view>
  </view>
</view>
