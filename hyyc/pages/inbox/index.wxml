<view class="editorial-page">
  <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="channel-scroll">
    <view class="channel-track">
      <view
        wx:for="{{feed.channels}}"
        wx:key="key"
        class="channel-tab {{item.active ? 'channel-tab-active channel-tab-' + item.tone : ''}}"
        data-key="{{item.key}}"
        bindtap="selectChannel"
      >
        <text>{{item.label}}</text>
        <text wx:if="{{item.count}}" class="channel-count">{{item.count}}</text>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="loading-editorial">
    <view class="loading-media"></view>
    <view class="loading-line loading-line-strong"></view>
    <view class="loading-line"></view>
    <view class="loading-line loading-line-short"></view>
  </view>

  <view wx:elif="{{feedError}}" class="empty-editorial">
    <view class="empty-title">资讯暂时没有加载成功</view>
    <view class="empty-copy">{{feedError}}</view>
    <button class="empty-action" bindtap="retryFeed">重新加载</button>
  </view>

  <view wx:elif="{{!feed.visibleItems.length}}" class="empty-editorial">
    <view class="empty-title">{{feed.activeChannelLabel}}暂时没有有图资讯</view>
    <view class="empty-copy">有新内容后会在这里更新，你也可以切换其他频道查看。</view>
  </view>

  <block wx:else>
    <view class="lead-story" data-id="{{feed.leadItem.id}}" bindtap="openFeedItem">
      <image class="lead-cover" src="{{feed.leadItem.coverFileId}}" mode="aspectFill" lazy-load="{{true}}" />
      <view class="story-meta">
        <text class="channel-label channel-text-{{feed.leadItem.coverTone}}">{{feed.leadItem.categoryLabel}}</text>
        <text>{{feed.leadItem.source}}</text>
        <text>{{feed.leadItem.publishedLabel}}</text>
      </view>
      <view class="lead-title">{{feed.leadItem.title}}</view>
      <view wx:if="{{feed.leadItem.summary}}" class="lead-summary">{{feed.leadItem.summary}}</view>
      <view class="lead-footer">
        <text>{{feed.leadItem.scoreLabel}}</text>
        <text>查看详情 →</text>
      </view>
    </view>

    <view wx:if="{{feed.remainingItems.length}}" class="section-heading">
      <view class="section-title">更多资讯</view>
      <view class="section-count">{{feed.remainingItems.length}}</view>
    </view>

    <view class="story-list">
      <view
        wx:for="{{feed.remainingItems}}"
        wx:key="id"
        class="story-row"
        data-id="{{item.id}}"
        bindtap="openFeedItem"
      >
        <view class="story-copy">
          <view class="story-meta">
            <text class="channel-label channel-text-{{item.coverTone}}">{{item.categoryLabel}}</text>
            <text>{{item.publishedLabel}}</text>
          </view>
          <view class="story-title">{{item.title}}</view>
          <view class="story-action">{{item.source}} · {{item.scoreLabel}}</view>
        </view>
        <image class="story-thumbnail" src="{{item.coverFileId}}" mode="aspectFill" lazy-load="{{true}}" />
      </view>
    </view>
  </block>
</view>
