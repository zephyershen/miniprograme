<view class="page">
  <view wx:if="{{loading}}" class="loading-copy">正在读取这条内容…</view>

  <view wx:elif="{{!item}}" class="empty-state card">
    <view class="empty-title">这条内容已经处理过了</view>
    <view class="empty-copy">返回待消化列表，继续处理下一条。</view>
  </view>

  <block wx:else>
    <view class="source-line">
      <text>{{item.sourceHost}}</text>
      <text>{{item.createdLabel}}</text>
    </view>
    <view class="article-title">{{item.sourceTitle}}</view>

    <view wx:if="{{item.processingMode === 'local_fallback'}}" class="fallback-note card">
      <view class="section-label">临时摘要模式</view>
      <view class="fallback-copy">当前云端 AI 额度不可用。以下内容由本地规则摘录，未经过 AI 翻译或相关性判断。</view>
    </view>

    <view class="relevance-card card relevance-{{item.relevanceTone}}">
      <view class="section-label">与你的关系 · {{item.relevanceLabel}}</view>
      <view class="relevance-reason">{{item.relevanceReasonZh}}</view>
    </view>

    <view class="content-card card">
      <view class="section-label">先看懂</view>
      <view class="summary">{{item.summaryZh}}</view>
    </view>

    <view class="content-card card">
      <view class="section-label">关键原句</view>
      <view wx:for="{{item.keySentences}}" wx:key="source" class="sentence">
        <view class="sentence-source">{{index + 1}}. {{item.source}}</view>
        <view wx:if="{{item.translationZh}}" class="sentence-translation">{{item.translationZh}}</view>
      </view>
    </view>

    <view class="conclusion-preview card">
      <view class="section-label">如果保留，只留下这张卡</view>
      <view class="conclusion">{{item.candidateConclusion}}</view>
      <view class="use-when">适用场景：{{item.candidateUseWhen}}</view>
    </view>

    <button class="source-button" bindtap="copySource">复制原文链接核对全文</button>

    <view class="decision-bar">
      <button class="danger-button" bindtap="discard" disabled="{{resolving}}">丢弃</button>
      <button class="primary-button" bindtap="keep" disabled="{{resolving}}">保留结论</button>
    </view>
  </block>
</view>

<view wx:if="{{showReplacement}}" class="modal-mask" bindtap="closeReplacement">
  <view class="modal-panel replacement-panel" catchtap="stopPropagation">
    <view class="modal-title">结论卡已满 20 张</view>
    <view class="modal-copy">选择一张旧卡替换。系统不会替你静默淘汰。</view>
    <scroll-view scroll-y class="replacement-list">
      <view
        wx:for="{{cards}}"
        wx:key="_id"
        class="replacement-item"
        data-id="{{item._id}}"
        bindtap="replaceCard"
      >
        <view class="replacement-conclusion">{{item.conclusion}}</view>
        <view class="replacement-source">{{item.sourceHost}} · 点击替换</view>
      </view>
    </scroll-view>
  </view>
</view>
