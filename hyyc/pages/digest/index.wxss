.source-line {
  display: flex;
  justify-content: space-between;
  color: var(--editorial-muted);
  font-size: 23rpx;
}

.article-title {
  margin: 18rpx 0 30rpx;
  font-size: 42rpx;
  font-weight: 750;
  line-height: 1.35;
}

.relevance-card,
.content-card,
.conclusion-preview {
  margin-top: 26rpx;
  padding: 30rpx 0;
}

.relevance-card {
  padding-left: 24rpx;
  border-left: 7rpx solid var(--editorial-rule);
  background: transparent;
}

.relevance-high { border-left-color: var(--editorial-blue); }
.relevance-medium { border-left-color: var(--editorial-amber); }
.relevance-low { border-left-color: var(--editorial-faint); }
.relevance-none { border-left-color: var(--editorial-coral); }

.fallback-note {
  margin-top: 22rpx;
  padding: 26rpx 30rpx;
  border: 1rpx solid var(--editorial-amber);
  border-left: 7rpx solid var(--editorial-amber);
  border-radius: 0;
  background: #fff7e3;
}

.fallback-copy {
  margin-top: 12rpx;
  color: var(--editorial-muted);
  line-height: 1.65;
}

.section-label {
  color: var(--editorial-muted);
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.relevance-reason,
.summary {
  margin-top: 16rpx;
  font-size: 31rpx;
  line-height: 1.75;
}

.sentence {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--editorial-rule);
}

.sentence:last-child {
  border-bottom: none;
}

.sentence-source {
  font-size: 29rpx;
  line-height: 1.65;
}

.sentence-translation {
  margin-top: 12rpx;
  padding-left: 20rpx;
  border-left: 5rpx solid var(--editorial-cyan);
  color: var(--editorial-muted);
  line-height: 1.65;
}

.conclusion-preview {
  padding-right: 18rpx;
  padding-left: 18rpx;
  border-top: 3rpx solid var(--editorial-blue);
  border-right: 0;
  border-bottom: 1rpx solid var(--editorial-blue);
  border-left: 0;
}

.conclusion {
  margin-top: 18rpx;
  font-size: 34rpx;
  font-weight: 720;
  line-height: 1.55;
}

.use-when {
  margin-top: 18rpx;
  color: var(--editorial-muted);
  line-height: 1.6;
}

.source-button {
  margin-top: 24rpx;
  padding: 0;
  border-bottom: 2rpx solid var(--editorial-ink);
  background: transparent;
  color: var(--editorial-ink);
  font-weight: 500;
}

.decision-bar {
  display: flex;
  gap: 18rpx;
  margin-top: 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.decision-bar button {
  flex: 1;
}

.replacement-panel {
  max-height: 82vh;
}

.replacement-list {
  max-height: 58vh;
  margin-top: 24rpx;
}

.replacement-item {
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid var(--editorial-rule);
}

.replacement-conclusion {
  font-weight: 650;
  line-height: 1.55;
}

.replacement-source {
  margin-top: 10rpx;
  color: var(--editorial-muted);
  font-size: 23rpx;
}
