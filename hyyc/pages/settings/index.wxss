.settings-card {
  margin-bottom: 34rpx;
  padding: 30rpx 0 34rpx;
  border-top-color: var(--editorial-ink);
}

.settings-title {
  font-size: 32rpx;
  font-weight: 720;
}

.settings-copy {
  margin-top: 12rpx;
  color: var(--editorial-muted);
  line-height: 1.65;
}

.topics {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.topic {
  padding: 15rpx 20rpx;
  border: 1rpx solid var(--editorial-rule);
  border-radius: 0;
  background: transparent;
  color: var(--editorial-muted);
}

.topic-selected {
  border-color: var(--editorial-ink);
  background: var(--editorial-ink);
  color: #ffffff;
  font-weight: 650;
}

.save-button,
.purge-button {
  margin-top: 26rpx;
}

.usage-money {
  margin-top: 18rpx;
  color: var(--editorial-blue);
  font-size: 48rpx;
  font-weight: 750;
}

.usage-money text {
  color: var(--editorial-muted);
  font-size: 26rpx;
  font-weight: 500;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0;
  margin-top: 24rpx;
  border-top: 1rpx solid var(--editorial-rule);
  border-left: 1rpx solid var(--editorial-rule);
}

.stat {
  padding: 22rpx;
  border-right: 1rpx solid var(--editorial-rule);
  border-bottom: 1rpx solid var(--editorial-rule);
  border-radius: 0;
  background: transparent;
}

.stat text,
.stat label {
  display: block;
}

.stat text {
  font-size: 38rpx;
  font-weight: 730;
}

.stat label {
  margin-top: 8rpx;
  color: var(--editorial-muted);
  font-size: 22rpx;
}

.validation-copy {
  margin-top: 20rpx;
}

.usage-note {
  margin-top: 12rpx;
  font-size: 22rpx;
}

.danger-zone {
  border-top-color: #c87569;
  border-bottom-color: #e7c4be;
}
