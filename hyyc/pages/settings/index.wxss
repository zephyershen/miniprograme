.settings-card { margin-bottom: 18rpx; padding: 28rpx; }
.settings-title { font-size: 31rpx; font-weight: 730; }
.settings-copy { margin-top: 12rpx; color: var(--ui-muted); line-height: 1.65; }
.topics { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 24rpx; }

.topic {
  display: flex;
  min-height: 62rpx;
  align-items: center;
  padding: 0 20rpx;
  border-radius: 20rpx;
  background: var(--ui-surface-muted);
  color: var(--ui-muted);
}

.topic-selected { background: var(--ui-accent-soft); box-shadow: inset 0 0 0 1rpx rgba(91, 92, 226, .16); color: var(--ui-accent-strong); font-weight: 680; }
.save-button, .purge-button { margin-top: 26rpx; }

.usage-money {
  margin-top: 18rpx;
  color: var(--ui-accent);
  font-family: "DIN Alternate", -apple-system, sans-serif;
  font-size: 48rpx;
  font-weight: 740;
}

.usage-money text { color: var(--ui-muted); font-size: 26rpx; font-weight: 500; }

.stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12rpx; margin-top: 24rpx; }
.stat { padding: 22rpx; border-radius: 21rpx; background: var(--ui-surface-muted); }
.stat text, .stat label { display: block; }
.stat text { font-family: "DIN Alternate", -apple-system, sans-serif; font-size: 38rpx; font-weight: 730; }
.stat label { margin-top: 8rpx; color: var(--ui-muted); font-size: 22rpx; }
.validation-copy { margin-top: 20rpx; }
.usage-note { margin-top: 12rpx; font-size: 22rpx; }
.danger-zone { border-color: rgba(182, 76, 75, .12); background: rgba(255, 248, 248, .94); }
