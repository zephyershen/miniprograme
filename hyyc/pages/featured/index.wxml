<page-meta page-style="{{membershipPromptVisible ? 'overflow: hidden;' : ''}}" />
<view class="curated-page">
  <view class="curated-header">
    <view class="page-kicker"><text class="kicker-dot"></text><text class="kicker-label">PRO CURATION</text></view>
    <view class="curated-title">精选</view>
    <view class="curated-deck">每天只留真正影响判断的变化。去重、判断影响，再告诉你为什么值得看。</view>
  </view>

  <view wx:if="{{locked}}" class="member-gate">
    <view class="gate-status">Pro 专属</view>
    <view class="gate-title">把刷资讯，变成做判断</view>
    <view class="gate-copy">重要更新先讲清“变了什么、为什么重要、要不要继续读”。少看重复，更快抓住行动信号。</view>
    <view class="benefit-list">
      <view wx:for="{{membership.benefits}}" wx:key="key" class="benefit-row">
        <text class="benefit-index">0{{index + 1}}</text>
        <view><view class="benefit-title">{{item.title}}</view><view class="benefit-copy">{{item.copy}}</view></view>
      </view>
    </view>
    <view class="gate-link" bindtap="openMembershipPrompt">查看 Pro 权益 →</view>

    <view class="sample-label">体验示例 · 非本期内容</view>
    <view class="sample-lead">
      <view class="sample-reason">{{sample.reason}}</view>
      <view class="sample-title">{{sample.title}}</view>
      <view class="sample-summary">{{sample.summary}}</view>
    </view>
    <view class="sample-list">
      <view wx:for="{{sample.related}}" wx:key="id" class="sample-row">
        <view class="sample-reason">{{item.reason}}</view>
        <view class="sample-row-title">{{item.title}}</view>
      </view>
    </view>
  </view>

  <view wx:elif="{{loading}}" class="curated-loading">
    <loading-state compact="{{true}}" label="正在加载精选" />
    <view class="loading-rule"></view><view class="loading-rule loading-rule-wide"></view><view class="loading-rule"></view>
  </view>

  <view wx:elif="{{error}}" class="curated-empty">
    <empty-state
      title="精选暂时没有加载成功"
      copy="{{error}}"
      action-label="重新加载"
      bindaction="retry"
    />
  </view>

  <block wx:else>
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="curated-channel-scroll">
      <view class="curated-channel-track">
        <view wx:for="{{view.channels}}" wx:key="key" class="curated-channel {{item.active ? 'curated-channel-active' : ''}}" data-key="{{item.key}}" bindtap="selectChannel">{{item.label}}</view>
      </view>
    </scroll-view>

    <view class="curated-toolbar">
      <view class="window-track">
        <view wx:for="{{windowOptions}}" wx:key="key" class="window-choice {{item.active ? 'window-choice-active' : ''}}" data-key="{{item.key}}" bindtap="selectWindow" aria-role="button" aria-label="时间范围：{{item.label}}{{item.active ? '，已选' : ''}}">{{item.label}}</view>
      </view>
      <view class="sort-track">
        <view wx:for="{{sortOptions}}" wx:key="key" class="sort-choice {{item.active ? 'sort-choice-active' : ''}}" data-key="{{item.key}}" bindtap="selectSort" aria-role="button" aria-label="排序方式：{{item.label}}{{item.active ? '，已选' : ''}}">{{item.label}}</view>
      </view>
    </view>
    <view class="curated-meta-line" bindtap="openFilters" hover-class="curated-meta-line-pressed" aria-role="button" aria-label="打开筛选，当前{{filterSummary}}">
      <text class="curated-count">{{filters.time === '1d' ? '24 小时内精选' : (filters.time === '30d' ? '近 30 天精选' : '近 7 天精选')}} {{view.resultCount}} 条</text>
      <text class="filter-link">筛选 · {{filterSummary}} ↘</text>
    </view>

    <view wx:if="{{providerPending}}" class="curated-empty pending-state">
      <empty-state
        title="真实精选尚未发布"
        copy="本期精选正在整理，稍后再来看看。"
      />
    </view>
    <view wx:elif="{{!view.leadItem}}" class="curated-empty">
      <empty-state
        title="这一范围没有值得打扰你的更新"
        copy="精选不为数量凑内容。可以切换时间或主题再看。"
      />
    </view>
    <block wx:else>
      <view class="curated-lead" data-id="{{view.leadItem.id}}" bindtap="openItem">
        <view class="reason-block">
          <text class="reason-kicker">精选理由</text>
          <text class="reason-text">{{view.leadItem.curationReason}}</text>
        </view>
        <view class="curated-lead-title">{{view.leadItem.title}}</view>
        <view wx:if="{{view.leadItem.summaryPreview}}" class="curated-summary">{{view.leadItem.summaryPreview}}</view>
        <view wx:if="{{view.leadItem.listVisualFileId || view.leadItem.visualFileId || view.leadItem.listVisualUrl}}" class="curated-lead-image-shell">
          <image wx:if="{{view.leadItem.listVisualUrl}}" class="curated-lead-image" src="{{view.leadItem.listVisualUrl}}" mode="aspectFill" lazy-load="{{true}}" data-media-key="curated:{{view.leadItem.id}}:list" data-file-id="{{view.leadItem.listVisualFileId || view.leadItem.visualFileId}}" data-media-url="{{view.leadItem.listVisualUrl}}" data-media-path="view.leadItem.listVisualUrl" binderror="handleMediaError" />
          <view wx:else class="curated-media-spinner"></view>
        </view>
        <view class="curated-meta"><text>{{view.leadItem.source}}</text><text>{{view.leadItem.publishedLabel}}</text></view>
      </view>
      <view class="curated-list">
        <view wx:for="{{view.remainingItems}}" wx:key="id" class="curated-row" data-id="{{item.id}}" bindtap="openItem">
          <view class="curated-row-copy">
            <view class="curation-reason">{{item.curationReason}}</view>
            <view class="curated-row-title">{{item.title}}</view>
            <view class="curated-meta"><text>{{item.source}}</text><text>{{item.publishedLabel}}</text></view>
          </view>
          <view wx:if="{{item.listVisualFileId || item.visualFileId || item.listVisualUrl}}" class="curated-thumbnail-shell">
            <image wx:if="{{item.listVisualUrl}}" class="curated-thumbnail" src="{{item.listVisualUrl}}" mode="aspectFill" lazy-load="{{true}}" data-media-key="curated:{{item.id}}:list" data-file-id="{{item.listVisualFileId || item.visualFileId}}" data-media-url="{{item.listVisualUrl}}" data-media-path="view.remainingItems[{{index}}].listVisualUrl" binderror="handleMediaError" />
            <view wx:else class="curated-media-spinner curated-media-spinner-small"></view>
          </view>
        </view>
      </view>
      <view wx:if="{{loadingMore}}" class="load-more"><view class="load-spinner"></view><text>正在加载更多精选</text></view>
      <view wx:elif="{{!view.hasMore}}" class="curated-finished"><view class="finished-mark"></view><text>{{filters.time === '1d' ? '24 小时内精选已看完' : (filters.time === '30d' ? '近 30 天精选已看完' : '近 7 天精选已看完')}} · 共 {{view.resultCount}} 条</text></view>
    </block>
  </block>

  <view wx:if="{{filterOpen}}" class="filter-mask" bindtap="closeFilters">
    <view class="filter-panel" catchtap="stopPropagation">
      <view class="filter-head"><view><view class="page-kicker"><text class="kicker-dot"></text>FILTER</view><view class="filter-title">缩小精选范围</view></view><view class="filter-close" bindtap="closeFilters">关闭</view></view>
      <scroll-view scroll-y class="filter-scroll">
        <view class="filter-group"><view class="filter-group-title">公司与模型</view><view class="filter-options">
          <view wx:for="{{companyOptions}}" wx:key="key" class="filter-option {{draftFilters.company === item.key ? 'filter-option-active' : ''}}" data-group="company" data-key="{{item.key}}" bindtap="selectFilter">{{item.label}}</view>
        </view></view>
        <view class="filter-group"><view class="filter-group-title">技术方向</view><view class="filter-options">
          <view wx:for="{{directionOptions}}" wx:key="key" class="filter-option {{draftFilters.direction === item.key ? 'filter-option-active' : ''}}" data-group="direction" data-key="{{item.key}}" bindtap="selectFilter">{{item.label}}</view>
        </view></view>
      </scroll-view>
      <view class="filter-actions"><button class="filter-reset" bindtap="resetFilters">重置</button><button class="filter-apply" bindtap="applyFilters">应用筛选</button></view>
    </view>
  </view>

  <membership-prompt
    visible="{{membershipPromptVisible}}"
    feature-key="{{membershipPromptFeature}}"
    bindclose="closeMembershipPrompt"
    bindviewbenefits="openMembershipFromPrompt"
  />
</view>
