<ui-loading show="{{isLoading}}" />
<view class="px-24 py-16">
  <view class="card">
    <view wx:if="{{editGoodsId}}" class="mb-12 c-muted" style="font-size: 24rpx; line-height: 1.6;">
      修改已上架或已下架的商品后，会重新进入审核；审核通过后再重新上架。
    </view>
    <view class="gap-12">
      <view class="gap-item">
        <ui-field label="图片" hint="建议至少 1 张，最多 {{MAX_IMAGES}} 张" error="{{errors.images || ''}}" required="{{true}}">
          <view class="row wrap row-gap-8">
            <block wx:for="{{form.images}}" wx:key="*this">
              <view class="{{'row-gap-item publish-image-wrap ' + (needFixIdxMap[index] ? 'is-need-fix' : '')}}">
                <image class="publish-image-thumb" src="{{item}}" lazy-load="true" data-index="{{index}}" bindtap="previewFormImage" />
                <view class="publish-image-remove" data-index="{{index}}" catchtap="removeFormImage">
                  ×
                </view>
              </view>
            </block>
            <view class="row-gap-item publish-image-add {{form.images.length >= MAX_IMAGES ? 'is-disabled' : ''}}" bindtap="chooseImg">
              <text class="publish-image-add-plus">+</text>
            </view>
          </view>
        </ui-field>
      </view>

      <view class="gap-item">
        <ui-field label="标题" error="{{errors.title || ''}}" required="{{true}}">
          <input class="input" placeholder="如：宜家小书桌 / Switch 游戏卡" value="{{form.title}}" data-k="title" bindinput="onInput" />
        </ui-field>
      </view>

      <view class="gap-item">
        <ui-field label="分类" hint="买家可以按分类筛选" error="{{errors.category || ''}}" required="{{true}}">
          <view class="{{'publish-category-trigger ' + (form.category ? 'is-selected ' : '') + (errors.category ? 'is-error' : '')}}" bindtap="openCategorySheet">
            <view class="publish-category-trigger-main">
              <text class="publish-category-trigger-label">已选分类</text>
              <view class="{{'publish-category-value ' + (form.category ? 'is-selected' : '')}}">
                <text class="{{'publish-category-value-text ' + (form.category ? 'is-selected' : '')}}">{{categoryDisplayLabel}}</text>
              </view>
            </view>
            <view class="publish-category-trigger-side">
              <text class="publish-category-trigger-action">{{form.category ? '重新选择' : '点击选择'}}</text>
              <text class="publish-category-trigger-arrow">›</text>
            </view>
          </view>
        </ui-field>
      </view>

      <view class="gap-item">
        <ui-field label="价格（元）" hint="最低 0.5 元，支持两位小数" error="{{errors.price || ''}}" required="{{true}}">
          <input class="input" type="digit" placeholder="如：0.5" value="{{form.price}}" data-k="price" bindinput="onInput" />
        </ui-field>
      </view>

      <view class="gap-item">
        <ui-field label="原价（元）" hint="可选" error="{{errors.originalPrice || ''}}">
          <input class="input" type="digit" placeholder="如：199.9" value="{{form.originalPrice}}" data-k="originalPrice" bindinput="onInput" />
        </ui-field>
      </view>

      <view class="gap-item">
        <ui-field label="成色" hint="可选">
          <view class="row wrap row-gap-8">
            <block wx:for="{{conditionOptions}}" wx:key="key">
              <view
                class="{{'badge row-gap-item ' + (form.condition === item.key ? 'badge-primary' : '')}}"
                data-v="{{item.key}}"
                bindtap="onConditionTap"
              >
                {{item.label}}
              </view>
            </block>
          </view>
        </ui-field>
      </view>

      <view class="gap-item">
        <ui-field label="交易方式" hint="可选">
          <view class="trade-tabs">
            <view class="trade-tab {{!form.tradeType ? 'trade-tab-active' : ''}}" data-v="" bindtap="onTradeTap">
              都可以
            </view>
            <view class="trade-tab {{form.tradeType==='face' ? 'trade-tab-active' : ''}}" data-v="face" bindtap="onTradeTap">
              当面
            </view>
            <view class="trade-tab {{form.tradeType==='mail' ? 'trade-tab-active' : ''}}" data-v="mail" bindtap="onTradeTap">
              邮寄
            </view>
          </view>
        </ui-field>
      </view>

      <view class="gap-item">
        <ui-field label="发布楼栋" hint="可选，方便同楼栋的人优先看到">
          <picker mode="selector" range="{{buildingRange}}" value="{{buildingIndex}}" bindchange="onBuilding">
            <view class="input row space-between">
              <text>{{form.building || '选择楼栋'}}</text>
              <text>›</text>
            </view>
          </picker>
        </ui-field>
      </view>

      <view class="gap-item">
        <ui-field label="说明" hint="可选">
          <textarea class="textarea textarea-desc" placeholder="简单写写：成色、尺寸、是否有瑕疵、配件是否齐全等" value="{{form.desc}}" data-k="desc" bindinput="onInput" />
        </ui-field>
      </view>
    </view>

    <view class="btn-bar">
      <view class="btn btn-outline btn-flex" bindtap="reset">清空</view>
      <view class="btn btn-primary btn-flex2" bindtap="submit">{{editGoodsId ? '保存修改并重新审核' : '发布商品'}}</view>
    </view>
  </view>
</view>

<view wx:if="{{categorySheetVisible}}" class="publish-category-sheet-mask" bindtap="closeCategorySheet" catchtouchmove="noop">
  <view class="publish-category-sheet" catchtap="noop">
    <view class="publish-category-sheet-handle"></view>

    <view class="publish-category-sheet-head">
      <view class="publish-category-sheet-head-main">
        <text class="publish-category-sheet-title">选择商品分类</text>
        <text class="publish-category-sheet-sub">买家会按这个分类筛选你的商品</text>
      </view>
      <text class="publish-category-sheet-close" bindtap="closeCategorySheet">收起</text>
    </view>

    <view class="publish-category-sheet-grid">
      <block wx:for="{{categoryOptions}}" wx:key="key">
        <view class="publish-category-sheet-cell">
          <view
            class="{{'publish-category-sheet-chip ' + (form.category === item.key ? 'is-active' : '')}}"
            data-v="{{item.key}}"
            bindtap="onCategoryTap"
          >
            <text class="publish-category-sheet-chip-text">{{item.label}}</text>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>
