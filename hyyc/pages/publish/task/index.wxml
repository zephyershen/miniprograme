<ui-loading show="{{isLoading}}" />
<view class="px-24 py-16">
  <view class="card">
    <view class="gap-12">
      <view class="gap-item">
        <ui-field label="标题" error="{{errors.title || ''}}" required="{{true}}">
          <input class="input" placeholder="如：帮忙拿快递" value="{{form.title}}" data-k="title" bindinput="onInput" />
        </ui-field>
      </view>
        <view class="gap-item">
          <ui-field label="说明" error="{{errors.desc || ''}}">
            <textarea class="textarea textarea-desc" placeholder="简单描述要做的事" value="{{form.desc}}" data-k="desc" bindinput="onInput" />
          </ui-field>
        </view>
        <view class="gap-item">
          <ui-field label="佣金（元）" error="{{errors.amount || ''}}" required="{{true}}">
            <input class="input" type="number" placeholder="如 10" value="{{form.amount}}" data-k="amount" bindinput="onInput" />
          </ui-field>
        </view>
        <view class="gap-item">
          <ui-field label="截止时间" hint="（可选，不选则默认从现在起 7 天内有效）" error="{{errors.deadline || ''}}">
            <view class="row">
              <picker mode="date" value="{{form.deadlineDate || defaultDeadlineDate}}" bindchange="onDeadlineDate">
                <view class="input input-half row space-between">
                  <text>{{form.deadlineDate || '选择日期'}}</text>
                  <text>›</text>
                </view>
              </picker>
              <view style="width: 16rpx;"></view>
              <picker mode="time" value="{{form.deadlineTime || defaultDeadlineTime}}" start="06:00" end="23:00" bindchange="onDeadlineTime">
                <view class="input input-half row space-between">
                  <text>{{form.deadlineTime || '选择时间'}}</text>
                  <text>›</text>
                </view>
              </picker>
            </view>
          </ui-field>
        </view>
        <view class="gap-item">
          <ui-field label="发布楼栋" error="{{errors.building || ''}}" required="{{true}}">
            <picker mode="selector" range="{{buildingRange}}" value="{{buildingIndex}}" bindchange="onBuilding">
              <view class="input row space-between">
                <text>{{form.building||'选择楼栋（1-23栋）'}}</text>
                <text>›</text>
              </view>
            </picker>
          </ui-field>
        </view>
        <view class="gap-item">
          <ui-field label="门牌号" error="{{errors.door || ''}}" required="{{true}}">
            <picker mode="multiSelector" range="{{doorRange}}" value="{{doorIndex}}" bindchange="onDoorChange">
              <view class="input row space-between">
                <text>{{form.door ? (form.door + '（' + form.floor + '楼-' + (doorRange[1][doorIndex[1]] || '') + '）') : '选择门牌（楼层+户号）'}}</text>
                <text>›</text>
              </view>
            </picker>
          </ui-field>
        </view>
        <view class="gap-item">
          <ui-field label="任务地点（可选）">
            <view class="location-tabs">
              <view class="{{'location-tab ' + (!form.locationType ? 'location-tab-active' : '')}}" data-v="" bindtap="onLocationTap">
                不区分
              </view>
              <view class="{{'location-tab ' + (form.locationType==='inside' ? 'location-tab-active' : '')}}" data-v="inside" bindtap="onLocationTap">
                小区内
              </view>
              <view class="{{'location-tab ' + (form.locationType==='outside' ? 'location-tab-active' : '')}}" data-v="outside" bindtap="onLocationTap">
                小区外
              </view>
            </view>
          </ui-field>
        </view>
        <view class="gap-item">
          <ui-field label="图片（可选）">
            <view class="row wrap row-gap-8">
              <block wx:for="{{form.images}}" wx:key="*this">
                <view class="row-gap-item publish-image-wrap">
                  <image class="publish-image-thumb" src="{{item}}" lazy-load="true" data-index="{{index}}" bindtap="previewFormImage" />
                  <view class="publish-image-remove" data-index="{{index}}" catchtap="removeFormImage">
                    ×
                  </view>
                </view>
              </block>
              <!-- 追加图片的“加号”入口 -->
              <view class="row-gap-item publish-image-add" bindtap="chooseImg">
                <text class="publish-image-add-plus">+</text>
              </view>
            </view>
          </ui-field>
        </view>
      </view>
      <view class="btn-group">
        <view class="btn-reset" bindtap="reset">清空</view>
        <view class="btn-submit" bindtap="submit">发布任务</view>
      </view>
</view>
</view>
