@import "../../../styles/shadcn.wxss";

page {
  background-color: #f5f5f5;
}

/* 发布任务页局部样式 */

/* 发布任务页「说明」输入框 */
.textarea-desc {
  height: 120rpx;
  min-height: 120rpx;
}

/* 截止时间的日期/时间选择各占一半宽度 */
.input-half {
  flex: 1;
}

/* 日期和时间选择器之间的间距 */
.picker-gap {
  width: 16rpx;
}

/* 发布时展示的图片缩略图（方形） */
.publish-image-wrap {
  position: relative;
}

.publish-image-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  object-fit: cover;
}

/* 加号方块按钮：和缩略图一样大小，看起来是“空的图片位” */
.publish-image-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #F97373;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #F97373;
  font-size: 64rpx;
  box-sizing: border-box;
}

.publish-image-add-plus {
  line-height: 1;
}

/* 右上角删除小叉号 */
.publish-image-remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 9999rpx;
  background: rgba(0,0,0,0.55);
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 任务地点选择 */
.location-tabs {
  display: flex;
  background: #F2F3F5;
  border-radius: 16rpx;
  padding: 6rpx;
}

.location-tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6B7280;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.location-tab-active {
  background: #ffffff;
  color: #B95E49;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 底部按钮组 */
.btn-group {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.btn-reset {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #6B7280;
  background: #F2F3F5;
  transition: all 0.2s ease;
}

.btn-reset:active {
  background: #E9EBEF;
}

.btn-submit {
  flex: 2;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #C96B55 0%, #B95E49 100%);
  box-shadow: 0 8rpx 24rpx rgba(185, 94, 73, 0.35);
  transition: all 0.2s ease;
}

.btn-submit:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(185, 94, 73, 0.4);
}
