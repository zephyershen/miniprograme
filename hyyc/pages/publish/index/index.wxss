@import "../../../styles/shadcn.wxss";

/* 选择发布类型页（底部 tab「发布」） */
.publish-type-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.publish-type-card {
  width: 100%;
  max-width: 640rpx;
  padding: 80rpx;
  background-color: #fefefe;
}

.publish-type-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2328;
}

.publish-type-divider {
  height: 2rpx;
  background-color: #E5E7EB;
  margin-top: 24rpx;
}

.btn {
  text-align: center;
}

.publish-type-option {
  display: flex;
  align-items: center;
  gap: 48rpx;
  margin-bottom: 48rpx;
}

.publish-type-icon {
  width: 280rpx;
  height: 280rpx;
  flex-shrink: 0;
}

.publish-type-text-main {
  font-size: 36rpx;
  font-weight: 600;
  color: #1F2328;
}

.publish-type-text-sub {
  font-size: 28rpx;
  color: #6B7280;
  margin-top: 8rpx;
}
