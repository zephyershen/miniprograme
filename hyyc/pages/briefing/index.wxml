<page-meta page-style="{{membershipPromptVisible ? 'overflow: hidden;' : ''}}" />
<view class="briefing-page">
  <view class="briefing-header">
    <view class="briefing-kicker"><text></text>PRO BRIEF</view>
    <view class="briefing-title">这一期，值得你知道的事</view>
    <view class="briefing-deck">帮你快速看懂：发生了什么、谁在推进、哪些原文值得继续看。</view>
  </view>

  <view class="window-tabs">
    <view wx:for="{{windowOptions}}" wx:key="key" class="window-tab {{item.active ? 'window-tab-active' : ''}}" data-key="{{item.key}}" bindtap="selectWindow">
      <text class="window-tab-label">{{item.label}}</text>
    </view>
  </view>

  <view wx:if="{{locked}}" class="briefing-gate">
    <view class="gate-status">Pro 专属</view>
    <view class="gate-title">几分钟，读完一个周期</view>
    <view class="gate-copy">不是标题合集。先给结论，再整理关键变化，最后保留可回看的来源。以下为体验示例，非本期实时内容。</view>
    <view class="gate-link" bindtap="openMembershipPrompt">查看 Pro 权益 →</view>
  </view>

  <view wx:if="{{loading}}" class="briefing-loading">
    <view class="loading-line loading-line-strong"></view><view class="loading-line"></view><view class="loading-line loading-line-short"></view>
  </view>
  <view wx:elif="{{error}}" class="briefing-empty">
    <view class="empty-title">简报暂时没有加载成功</view>
    <view class="empty-copy">{{error}}</view>
    <view class="text-action" bindtap="retry">重新加载 →</view>
  </view>
  <view wx:elif="{{providerPending && !locked}}" class="briefing-empty pending-state">
    <view class="empty-title">本期真实简报尚未发布</view>
    <view class="empty-copy">本期简报正在整理，稍后再来看看。</view>
  </view>

  <view wx:else class="briefing-body">
    <view class="briefing-meta">
      <text wx:if="{{briefing.coverageLabel}}" class="coverage-date">{{briefing.coverageLabel}}</text>
      <text>来源 {{briefing.sourceCount}}</text>
    </view>

    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="topic-scroll">
      <view class="topic-track">
        <view wx:for="{{topicOptions}}" wx:key="key" class="topic-choice {{item.active ? 'topic-choice-active' : ''}}" data-key="{{item.key}}" bindtap="selectTopic">{{item.label}}</view>
      </view>
    </scroll-view>

    <view wx:if="{{topicKey === 'all' && briefing.conclusion}}" class="conclusion-block">
      <view class="section-kicker">一句话结论</view>
      <view class="conclusion-copy">{{briefing.conclusion}}</view>
    </view>

    <view wx:if="{{briefing.topicEmpty}}" class="topic-empty">
      <view class="topic-empty-mark"></view>
      <view class="topic-empty-title">{{briefing.topicEmptyTitle}}</view>
      <view class="topic-empty-copy">{{briefing.topicEmptyCopy}}</view>
    </view>

    <view wx:if="{{briefing.mustKnow.length}}" class="brief-section">
      <view class="section-head"><view class="section-title">{{briefing.mustKnowTitle}}</view></view>
      <view wx:for="{{briefing.mustKnow}}" wx:key="index" class="must-row" data-id="{{item.itemId}}" bindtap="openReference">
        <text class="must-index">{{item.index || ('0' + (index + 1))}}</text>
        <view class="must-copy"><view class="must-title">{{item.title}}</view><view class="must-why">{{item.why || item.copy}}</view></view>
      </view>
    </view>

    <view wx:if="{{briefing.radar.length}}" class="brief-section">
      <view class="section-head"><view class="section-title">谁在做什么</view></view>
      <view
        wx:for="{{briefing.radar}}"
        wx:key="index"
        class="radar-row {{item.itemId && !locked ? 'radar-row-active' : 'radar-row-disabled'}}"
        data-id="{{item.itemId}}"
        bindtap="openReference"
      >
        <view class="radar-name">{{item.name}}</view>
        <view class="radar-detail">
          <view class="radar-copy">{{item.copy}}</view>
          <view class="radar-link-state">{{item.itemId && !locked ? '查看对应资讯 →' : '暂无可查看来源'}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{briefing.reading.length}}" class="brief-section source-section">
      <view class="section-head"><view class="section-title">想了解更多</view><view class="section-count">原始来源</view></view>
      <view wx:for="{{briefing.reading}}" wx:key="itemId" class="source-row" data-id="{{item.itemId}}" bindtap="openReference">
        <view class="source-title">{{item.title}}</view><view class="source-meta">{{item.source}} <text wx:if="{{item.itemId && !locked}}">→</text></view>
      </view>
    </view>
  </view>
  <membership-prompt
    visible="{{membershipPromptVisible}}"
    feature-key="{{membershipPromptFeature}}"
    bindclose="closeMembershipPrompt"
    bindviewbenefits="openMembershipFromPrompt"
  />
</view>
