<view class="briefing-page">
  <view class="briefing-header">
    <view class="briefing-kicker"><text></text>KNOWLEDGE BRIEF</view>
    <view class="briefing-title">少看一点，知道更多</view>
    <view class="briefing-deck">把滚动窗口里的变化整理成结论、影响和可回溯来源。</view>
  </view>

  <view class="window-tabs">
    <view wx:for="{{windowOptions}}" wx:key="key" class="window-tab {{item.active ? 'window-tab-active' : ''}}" data-key="{{item.key}}" bindtap="selectWindow">{{item.label}}</view>
  </view>

  <view wx:if="{{locked}}" class="briefing-gate">
    <view class="gate-status">会员能力内测中</view>
    <view class="gate-title">先看结论，再决定读什么</view>
    <view class="gate-copy">以下是一份固定完整示例，不包含本期实时会员内容。Pro 将开放 24 小时、7 天和 30 天滚动简报。</view>
    <view class="gate-link" bindtap="openProfile">查看会员权益 →</view>
  </view>

  <view wx:if="{{loading}}" class="briefing-loading">
    <view class="loading-line loading-line-strong"></view><view class="loading-line"></view><view class="loading-line loading-line-short"></view>
  </view>
  <view wx:elif="{{error}}" class="briefing-empty">
    <view class="empty-title">简报暂时没有加载成功</view>
    <view class="empty-copy">{{error}}</view>
    <view class="text-action" bindtap="retry">重新加载 →</view>
  </view>
  <view wx:elif="{{providerPending && !locked}}" class="briefing-empty pending-state">
    <view class="empty-title">简报能力已经就位</view>
    <view class="empty-copy">真实分析服务尚未启用。系统不会用普通资讯拼接成一份假简报，接入分析接口后再发布本期内容。</view>
  </view>

  <view wx:else class="briefing-body">
    <view class="briefing-meta">
      <text>{{briefing.coverageLabel}}</text>
      <text>{{briefing.generatedLabel}}</text>
      <text>来源 {{briefing.sourceCount}}</text>
    </view>
    <view wx:if="{{briefing.coverageState === 'partial'}}" class="coverage-note">当前数据覆盖不完整，结论仅代表已收录范围。</view>

    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="topic-scroll">
      <view class="topic-track">
        <view wx:for="{{topicOptions}}" wx:key="key" class="topic-choice {{item.active ? 'topic-choice-active' : ''}}" data-key="{{item.key}}" bindtap="selectTopic">{{item.label}}</view>
      </view>
    </scroll-view>

    <view class="conclusion-block">
      <view class="section-kicker">一句话结论</view>
      <view class="conclusion-copy">{{briefing.conclusion}}</view>
    </view>

    <view class="brief-section">
      <view class="section-head"><view class="section-title">必须知道</view><view class="section-count">{{briefing.mustKnow.length}}</view></view>
      <view wx:for="{{briefing.mustKnow}}" wx:key="index" class="must-row" data-id="{{item.itemId}}" bindtap="openReference">
        <text class="must-index">{{item.index || ('0' + (index + 1))}}</text>
        <view class="must-copy"><view class="must-title">{{item.title}}</view><view class="must-why">{{item.why || item.copy}}</view></view>
      </view>
    </view>

    <view class="brief-section">
      <view class="section-head"><view class="section-title">为什么重要 · 趋势变化</view></view>
      <view wx:for="{{briefing.trends}}" wx:key="title" class="text-row" data-id="{{item.itemId}}" bindtap="openReference"><view class="text-row-title">{{item.title}}</view><view class="text-row-copy">{{item.copy}}</view></view>
    </view>

    <view class="brief-section">
      <view class="section-head"><view class="section-title">公司与模型雷达</view></view>
      <view wx:for="{{briefing.radar}}" wx:key="name" class="radar-row"><view class="radar-name">{{item.name}}</view><view class="radar-copy">{{item.copy}}</view></view>
    </view>

    <view class="brief-section source-section">
      <view class="section-head"><view class="section-title">值得继续读</view><view class="section-count">来源索引</view></view>
      <view wx:for="{{briefing.reading}}" wx:key="itemId" class="source-row" data-id="{{item.itemId}}" bindtap="openReference">
        <view class="source-title">{{item.title}}</view><view class="source-meta">{{item.source}} <text wx:if="{{item.itemId && !locked}}">→</text></view>
      </view>
    </view>
  </view>
</view>
