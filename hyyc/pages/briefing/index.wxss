.briefing-page { box-sizing: border-box; min-height: 100vh; padding: 34rpx var(--ui-gutter) 108rpx; }
.briefing-header { padding: 6rpx 4rpx 34rpx; }

.briefing-kicker {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--ui-muted);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.briefing-kicker text {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--ui-accent);
}

.briefing-title { margin-top: 18rpx; font-size: 52rpx; font-weight: 800; line-height: 1.18; letter-spacing: -2rpx; }
.briefing-deck { width: 92%; margin-top: 14rpx; color: var(--ui-muted); font-size: 24rpx; line-height: 1.65; }

.window-tabs {
  display: flex;
  min-height: 74rpx;
  align-items: center;
  gap: 5rpx;
  padding: 6rpx;
  border-radius: 22rpx;
  background: rgba(229, 231, 238, 0.82);
}

.window-tab {
  display: flex;
  flex: 1;
  min-height: 62rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  color: var(--ui-muted);
  font-size: 23rpx;
  font-weight: 680;
}

.window-tab-active { background: var(--ui-surface-solid); box-shadow: 0 5rpx 16rpx rgba(30, 33, 44, .08); color: var(--ui-accent-strong); }
.window-tab-label { line-height: 1.2; }

.briefing-gate {
  margin-top: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(29, 155, 240, .1);
  border-radius: 32rpx;
  background: var(--ui-surface-solid);
  box-shadow: var(--ui-shadow-soft);
}

.gate-status, .section-kicker { color: var(--ui-accent); font-size: 19rpx; font-weight: 740; }
.gate-title { margin-top: 10rpx; font-size: 35rpx; font-weight: 750; }
.gate-copy { margin-top: 14rpx; color: var(--ui-muted); font-size: 23rpx; line-height: 1.7; }

.gate-link {
  display: inline-flex;
  min-height: 62rpx;
  align-items: center;
  margin-top: 20rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: var(--ui-accent-soft);
  color: var(--ui-accent-strong);
  font-size: 22rpx;
  font-weight: 700;
}

.briefing-loading, .briefing-empty { margin-top: 20rpx; padding: 82rpx 30rpx; border-radius: 32rpx; background: var(--ui-surface); box-shadow: var(--ui-shadow-soft); }
.pending-state { margin-top: 20rpx; }

.briefing-meta { display: flex; flex-wrap: wrap; gap: 10rpx; padding: 20rpx 0 8rpx; color: var(--ui-muted); font-size: 18rpx; }
.briefing-meta text { padding: 7rpx 13rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .68); }
.briefing-meta .coverage-date { color: var(--ui-text); font-weight: 670; }


.topic-scroll { width: 100%; margin-top: 14rpx; white-space: nowrap; }
.topic-track { display: inline-flex; gap: 9rpx; }

.topic-choice {
  display: inline-flex;
  min-height: 58rpx;
  align-items: center;
  padding: 0 18rpx;
  border-radius: 19rpx;
  background: rgba(255, 255, 255, .64);
  color: var(--ui-muted);
  font-size: 20rpx;
  font-weight: 650;
}

.topic-choice-active { background: var(--ui-accent-soft); color: var(--ui-accent-strong); }

.topic-empty {
  margin-top: 18rpx;
  padding: 54rpx 34rpx;
  border: 1rpx solid var(--ui-hairline);
  border-radius: var(--ui-radius-lg);
  background: var(--ui-surface-solid);
  text-align: center;
}

.topic-empty-mark {
  width: 28rpx;
  height: 5rpx;
  margin: 0 auto 22rpx;
  border-radius: 999rpx;
  background: var(--ui-accent);
  opacity: .75;
}

.topic-empty-title { font-size: 28rpx; font-weight: 730; }
.topic-empty-copy { margin-top: 12rpx; color: var(--ui-muted); font-size: 21rpx; line-height: 1.65; }

.conclusion-block {
  overflow: hidden;
  margin-top: 18rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(29, 155, 240, .1);
  border-radius: 34rpx;
  background: var(--ui-accent-soft);
  box-shadow: none;
}

.conclusion-copy { margin-top: 15rpx; font-size: 35rpx; font-weight: 750; line-height: 1.52; }

.brief-section {
  margin-top: 20rpx;
  padding: 28rpx;
  border: 1rpx solid var(--ui-hairline);
  border-radius: var(--ui-radius-lg);
  background: var(--ui-surface-solid);
  box-shadow: var(--ui-shadow-soft);
}

.section-head { display: flex; align-items: center; justify-content: space-between; padding: 0 2rpx 10rpx; }
.section-title { font-size: 29rpx; font-weight: 750; }
.section-count { padding: 5rpx 12rpx; border-radius: 999rpx; background: var(--ui-surface-muted); color: var(--ui-muted); font-size: 18rpx; }

.must-row,
.radar-row,
.source-row {
  margin-top: 12rpx;
  padding: 21rpx;
  border-radius: 21rpx;
  background: var(--ui-surface-muted);
}

.must-row { display: flex; gap: 18rpx; }
.must-index { flex: none; color: var(--ui-accent); font-size: 19rpx; font-weight: 760; }
.must-copy { flex: 1; min-width: 0; }
.must-title { font-size: 27rpx; font-weight: 710; line-height: 1.45; }
.must-why, .radar-copy { margin-top: 9rpx; color: var(--ui-muted); font-size: 22rpx; line-height: 1.65; }
.source-title { font-size: 27rpx; font-weight: 700; line-height: 1.45; }
.radar-row { display: grid; grid-template-columns: 150rpx 1fr; gap: 20rpx; }
.radar-name { color: var(--ui-accent); font-size: 22rpx; font-weight: 720; }
.radar-copy { margin-top: 0; }
.radar-detail { min-width: 0; }
.radar-link-state { margin-top: 12rpx; color: var(--ui-accent); font-size: 18rpx; font-weight: 650; }
.radar-row-active:active { background: var(--ui-accent-soft); }
.radar-row-disabled { opacity: .66; pointer-events: none; }
.radar-row-disabled .radar-link-state { color: var(--ui-muted); font-weight: 560; }
.source-section { padding-bottom: 28rpx; }
.source-meta { margin-top: 10rpx; color: var(--ui-muted); font-size: 19rpx; }
.source-meta text { float: right; color: var(--ui-accent); }
