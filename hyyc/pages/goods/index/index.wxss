@import "../../../styles/shadcn.wxss";

/* 顶部提示：有新商品（固定在顶部，不占布局） */
.goods-new-tip {
  position: fixed;
  top: 18rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 999;
  padding: 14rpx 22rpx;
  border-radius: 9999rpx;
  background: rgba(68, 114, 68, 0.95);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.18);
}

/* 商品列表：原价划掉 */
.goods-original {
  text-decoration: line-through;
  font-size: 24rpx;
  color: #9CA3AF;
  font-weight: 600;
}

/* 分类筛选：常驻一行的触发条，避免挤占列表空间 */
.goods-category-trigger {
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  border: 1rpx solid #E8ECEF;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(17, 24, 39, 0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.goods-category-trigger-main {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.goods-category-trigger-title {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #6B7280;
}

.goods-category-current {
  min-width: 0;
  max-width: 100%;
  padding: 10rpx 20rpx;
  border-radius: 9999rpx;
  background: rgba(68, 114, 68, 0.12);
  border: 1rpx solid rgba(68, 114, 68, 0.14);
  color: #447244;
}

.goods-category-current-text {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
}

.goods-category-trigger-side {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #374151;
}

.goods-category-trigger-side-text {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

.goods-category-trigger-arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #6B7280;
  border-bottom: 3rpx solid #6B7280;
  transform: rotate(45deg) translateY(-2rpx);
  transform-origin: center;
  transition: transform 0.2s ease;
}

.goods-category-trigger-arrow.is-expanded {
  transform: rotate(-135deg) translateY(-1rpx);
}

.goods-category-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 1001;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.28);
}

.goods-category-sheet {
  width: 100%;
  max-height: 72vh;
  overflow-y: auto;
  padding: 20rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
}

.goods-category-sheet-handle {
  width: 88rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: 999rpx;
  background: #D8DEE6;
}

.goods-category-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.goods-category-sheet-head-main {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.goods-category-sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.2;
}

.goods-category-sheet-sub {
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.2;
}

.goods-category-sheet-close {
  flex-shrink: 0;
  padding: 12rpx 18rpx;
  border-radius: 9999rpx;
  background: #F4F6F8;
  color: #447244;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.goods-category-sheet-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 18rpx -6rpx 0;
}

.goods-category-sheet-cell {
  width: 33.3333%;
  padding: 6rpx;
  box-sizing: border-box;
}

.goods-category-sheet-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 0 12rpx;
  border-radius: 18rpx;
  border: 1rpx solid #E5E7EB;
  background: #F8F9FB;
  color: #374151;
  box-sizing: border-box;
}

.goods-category-sheet-chip-active {
  background: #447244;
  border-color: #447244;
  color: #ffffff;
  box-shadow: 0 10rpx 20rpx rgba(68, 114, 68, 0.16);
}

.goods-category-sheet-chip-text {
  display: block;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
}

/* 瀑布流布局 */
.goods-waterfall {
  display: flex;
  justify-content: space-between;
}

.goods-col {
  width: calc(50% - 8rpx);
  display: flex;
  flex-direction: column;
}

.goods-spacer {
  width: 100%;
}

.goods-loadmore {
  height: 72rpx;
}

.goods-col > .goods-card + .goods-card {
  margin-top: 16rpx;
}

.goods-card {
  background: #ffffff;
  border: 1rpx solid #EDEFF2;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(17, 24, 39, 0.06),
              0 2rpx 8rpx rgba(17, 24, 39, 0.04);
}

.goods-cover-wrap {
  position: relative;
  /* 用 padding-top 百分比控制封面高度（由 item.coverPct 动态注入） */
  width: 100%;
  height: 0;
  background: #F2F3F5;
  overflow: hidden;
}

.goods-cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.goods-cover-placeholder {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9CA3AF;
  font-size: 24rpx;
}

.goods-cover-badge {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 9999rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
}

.goods-body {
  padding: 18rpx;
}

.goods-tag {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 9999rpx;
  border: 1rpx solid #EDEFF2;
  background: #F2F3F5;
  color: #6B7280;
  font-weight: 600;
}

.goods-tag-green {
  background: rgba(68, 114, 68, 0.12);
  border-color: rgba(68, 114, 68, 0.14);
  color: #447244;
}

.goods-tag-outline {
  background: #ffffff;
  border-color: rgba(239, 68, 68, 0.35);
  color: #EF4444;
}

.goods-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.goods-desc {
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.goods-price-row {
  align-items: baseline;
}

.goods-price {
  font-size: 30rpx;
  font-weight: 800;
  color: #111827;
}

.goods-sub {
  font-size: 22rpx;
  color: #9CA3AF;
}
