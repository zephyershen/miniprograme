<ui-loading show="{{isLoading}}" />

<view wx:if="{{!isLoading && goods}}" class="goods-detail-page">
  <!-- 顶部导航区域（卖家信息） -->
  <view class="seller-header">
    <view class="seller-info" bindtap="onSellerTap">
      <image class="seller-avatar" src="{{goods.sellerAvatar || '/assets/pages/goods/detail/default-avatar.svg'}}" mode="aspectFill" />
      <view class="seller-meta">
        <text class="seller-name">{{goods.sellerName || '匿名用户'}}</text>
        <text class="seller-extra">{{goods.publishTimeText}} | {{goods.locationText}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{goods.statusText || goods.statusNote}}" class="{{'status-section status-section-' + (goods.statusTone || 'muted')}}">
    <view class="status-row">
      <text class="status-badge">{{goods.statusText}}</text>
      <text wx:if="{{goods.statusNote}}" class="status-note">{{goods.statusNote}}</text>
    </view>
    <text wx:if="{{goods.auditError && goods.status==='need_fix'}}" class="status-extra">{{goods.auditError}}</text>
  </view>

  <!-- 价格区域 -->
  <view class="price-section">
    <view class="price-row">
      <text class="price-symbol">¥</text>
      <text class="price-value">{{goods.priceText}}</text>
      <view wx:if="{{goods.conditionLabel}}" class="condition-tag">{{goods.conditionLabel}}</view>
    </view>
    <view wx:if="{{goods.originalPriceText}}" class="original-price-row">
      <text class="original-label">原价</text>
      <text class="original-price">¥{{goods.originalPriceText}}</text>
    </view>
  </view>

  <!-- 商品描述 -->
  <view class="desc-section">
    <text class="desc-text">{{goods.desc || goods.title}}</text>
  </view>

  <!-- 商品属性 -->
  <view wx:if="{{goods.attributes && goods.attributes.length}}" class="attr-section">
    <view class="attr-grid">
      <view wx:for="{{goods.attributes}}" wx:key="key" class="attr-item">
        <text class="attr-label">{{item.label}}</text>
        <text class="attr-value">{{item.value}}</text>
      </view>
    </view>
  </view>

  <!-- 标签区域 -->
  <view class="tags-section" wx:if="{{goods.categoryLabel || goods.tradeTypeLabel}}">
    <view wx:if="{{goods.categoryLabel}}" class="goods-tag">{{goods.categoryLabel}}</view>
    <view wx:if="{{goods.tradeTypeLabel}}" class="goods-tag">{{goods.tradeTypeLabel}}</view>
  </view>

  <!-- 图片展示区域 -->
  <view class="images-section">
    <!-- 首图大图 -->
    <view wx:if="{{imagesPreview.length > 0}}" class="main-image-wrap" bindtap="previewImage" data-index="0">
      <image class="main-image" src="{{imagesPreview[0].thumbUrl}}" mode="aspectFill" lazy-load="true" />
    </view>

    <!-- 小图网格 -->
    <view wx:if="{{imagesPreview.length > 1}}" class="sub-images-grid">
      <view
        wx:for="{{imagesPreview}}"
        wx:if="{{index > 0}}"
        wx:key="index"
        class="sub-image-wrap"
        bindtap="previewImage"
        data-index="{{index}}"
      >
        <image class="sub-image" src="{{item.thumbUrl}}" mode="aspectFill" lazy-load="true" />
      </view>
    </view>
  </view>
</view>

<view wx:if="{{!isLoading && !goods}}" class="empty-state">
  <text class="empty-text">商品不存在或已下架</text>
</view>

<!-- 底部操作栏 -->
<view wx:if="{{goods}}" class="footer-bar safe">
  <view class="footer-left">
    <view class="footer-icon-btn" bindtap="onFavoriteTap">
      <image class="footer-icon" src="{{isFavorite ? '/assets/pages/goods/detail/favorite-clicked.svg' : '/assets/pages/goods/detail/favorite.svg'}}" mode="aspectFit" />
      <text class="footer-icon-text">收藏</text>
    </view>
  </view>
  <view class="footer-right">
    <view wx:if="{{isOwner && canEditGoods}}" class="btn-secondary" bindtap="onEditTap">编辑商品</view>
    <view wx:if="{{isOwner && canOwnerManage}}" class="btn-buy" bindtap="onOwnerActionTap">{{ownerActionText}}</view>
    <view wx:elif="{{!isOwner && canBuy}}" class="btn-buy" bindtap="onBuyTap">{{buyButtonText || '立即购买'}}</view>
    <view wx:elif="{{!isOwner}}" class="btn-buy btn-buy-disabled">{{buyButtonText || '不可购买'}}</view>
    <view wx:if="{{goodsChatEnabled}}" class="btn-chat" bindtap="onChatTap">
      <image class="chat-icon" src="/assets/pages/goods/detail/icon-chat.svg" mode="aspectFit" />
      <text>{{isOwner ? '咨询会话' : '聊一聊'}}</text>
      <view
        wx:if="{{isOwner && goodsChatUnreadCount > 0}}"
        class="btn-chat-badge"
      >
        {{goodsChatUnreadCount > 99 ? '99+' : goodsChatUnreadCount}}
      </view>
    </view>
  </view>
</view>
