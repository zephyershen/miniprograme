<ui-loading show="{{isLoading}}" />
<view class="px-24 py-16">
  <view class="row row-gap-8">
    <view class="{{'badge ' + (tab==='owner'?'badge-primary':'')}}" bindtap="setTab" data-k="owner">我发布的</view>
    <view class="{{'badge ' + (tab==='worker'?'badge-primary':'')}}" bindtap="setTab" data-k="worker">我接受的</view>
  </view>

  <block wx:for="{{list}}" wx:key="id">
    <view class="mt-16">
      <ui-card title="{{item.title}}" sub="截止 {{item.deadlineText}}">
        <view class="row space-between">
          <text class="c-danger">¥ {{item.amountText}}</text>
          <view class="btn btn-outline btn-sm" data-id="{{item.id}}" data-role="{{tab==='owner'?'owner':''}}" bindtap="toDetail">查看</view>
        </view>
      </ui-card>
    </view>
  </block>
  <view wx:if="{{!list.length}}" class="center" style="height: 50vh;">
    <text class="c-muted">暂无记录</text>
  </view>
</view>
