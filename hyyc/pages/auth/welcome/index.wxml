<view class="welcome-page">
  <view class="hero-lottie-box">
    <image
      class="hero-lottie-canvas"
      src="../../../assets/lottie/Welcome-cuate.svg"
      mode="aspectFit"
     style="width: 660rpx; height: 643rpx; display: block; box-sizing: border-box; position: relative; left: 0rpx; top: -79rpx"></image>
  </view>

  <view class="bottom">
    <view class="hero-text">
      <text class="hero-title">欢迎各位业主</text>
      <text class="hero-sub">在温馨客厅里管理你的社区生活</text>
    </view>

    <view class="actions">
      <view class="action-btn action-login" bindtap="onLoginTap">
        <block wx:if="{{isLoading}}">登录中…</block>
        <block wx:else>登录</block>
      </view>
      <!-- 暂时关闭一键获取手机号/用户信息，注册按钮只负责跳转到实名注册页 -->
      <view class="action-btn action-register" bindtap="onRegisterTap">注册</view>
    </view>
  </view>
</view>
