@import "../../../styles/shadcn.wxss";

/* 欢迎页：纯白留白风格（类似 ui_2.png） */
page {
  background-color: #FFFFFF;
}

.welcome-page {
  min-height: 100vh;
  padding: 120rpx 64rpx 0;
  box-sizing: border-box;
  background-color: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

.hero-lottie-box {
  flex: 1;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.hero-lottie-canvas {
  width: 660rpx;
  height: 660rpx;
  top: -79rpx;
}

.bottom {
  width: 100%;
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-text {
  text-align: center;
}

.hero-title,
.hero-sub { display: block; }

.hero-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #2F6B3D;
  letter-spacing: 2rpx;
  line-height: 1.25;
}

.hero-sub {
  margin-top: 22rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #2F6B3D;
  opacity: 0.85;
}

.actions {
  width: 100%;
  max-width: 560rpx;
  margin-top: 56rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  width: 100%;
  height: 92rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 700;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 覆盖 button 组件的默认内边距/边框，保证和原来的 view 按钮一致大小 */
button.action-btn {
  padding: 0;
  border: none;
  background: none;
}

button.action-btn::after {
  border: none;
}

.action-login {
  background: #2F6B3D;
  color: #FFFFFF;
  border: 1rpx solid #2F6B3D;
}

.action-register {
  background: transparent;
  color: #2F6B3D;
  border: 2rpx solid rgba(47, 107, 61, 0.35);
}
