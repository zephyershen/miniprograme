@import "../../../../styles/shadcn.wxss";

page {
  background: #ffffff;
}

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.doc {
  background: #ffffff;
}

.doc-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1F2328;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.doc-meta {
  font-size: 24rpx;
  color: #6B7280;
  margin-bottom: 32rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #E5E7EB;
}

.doc-body {
  padding-top: 16rpx;
}

.doc-h2 {
  margin-top: 36rpx;
  margin-bottom: 16rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #2F6B3D;
  line-height: 1.4;
}

.doc-p {
  margin: 16rpx 0;
  font-size: 30rpx;
  color: #1F2328;
  line-height: 2;
}

.doc-li {
  display: flex;
  align-items: flex-start;
  margin: 14rpx 0;
}

.doc-li-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 9999rpx;
  background: rgba(47, 107, 61, 0.45);
  margin-top: 14rpx;
  margin-right: 12rpx;
  flex: 0 0 10rpx;
}

.doc-li-text {
  flex: 1;
  font-size: 30rpx;
  color: #1F2328;
  line-height: 2;
}

.doc-li-alpha .doc-li-dot {
  background: rgba(47, 107, 61, 0.25);
}

.doc-li-alpha .doc-li-text {
  padding-left: 10rpx;
}

.doc-spacer {
  height: 24rpx;
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1F2328;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6B7280;
}
