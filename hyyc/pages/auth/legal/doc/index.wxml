<ui-loading show="{{isLoading}}" />

<view class="page">
  <view class="empty" wx:if="{{!isLoading && !doc}}">
    <view class="empty-title">未找到内容</view>
    <view class="empty-sub">协议暂未准备好，请稍后再试或联系管理员</view>
  </view>

  <view wx:if="{{doc}}" class="doc">
    <view class="doc-title">{{doc.title || '协议'}}</view>
    <view class="doc-meta" wx:if="{{doc.version || doc.effectiveDate}}">
      <text wx:if="{{doc.version}}">版本：{{doc.version}}</text>
      <text wx:if="{{doc.effectiveDate}}" style="margin-left:16rpx;">生效：{{doc.effectiveDate}}</text>
    </view>

    <view class="doc-body">
      <block wx:for="{{blocks}}" wx:for-item="b" wx:for-index="i" wx:key="i">
        <view wx:if="{{b.type === 'h2'}}" class="doc-h2">{{b.text}}</view>
        <view wx:elif="{{b.type === 'li'}}" class="doc-li">
          <view class="doc-li-dot"></view>
          <view class="doc-li-text">{{b.text}}</view>
        </view>
        <view wx:elif="{{b.type === 'li-alpha'}}" class="doc-li doc-li-alpha">
          <view class="doc-li-dot"></view>
          <view class="doc-li-text">{{b.text}}</view>
        </view>
        <view wx:elif="{{b.type === 'spacer'}}" class="doc-spacer"></view>
        <view wx:else class="doc-p">{{b.text}}</view>
      </block>
    </view>
  </view>
</view>
