@import "../../../styles/shadcn.wxss";

page {
  background-color: #F5F6F8;
}

.apple {
  min-height: 100vh;
  padding: 48rpx 32rpx 80rpx;
  background: #F5F6F8;
  position: relative;
}

.hero {
  margin-bottom: 36rpx;
  text-align: center;
}

.h1 {
  font-size: 48rpx;
  font-weight: 700;
  color: #B95E49;
  letter-spacing: 1rpx;
}

.sub {
  margin-top: 12rpx;
  color: #6B7280;
  font-size: 28rpx;
  line-height: 1.6;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #EDEFF2;
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(17, 24, 39, 0.06),
              0 4rpx 12rpx rgba(17, 24, 39, 0.04);
}

.tips-card {
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: rgba(185, 94, 73, 0.08);
  border: 1rpx solid rgba(185, 94, 73, 0.12);
}

.tips-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2328;
}

.tips-text {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6B7280;
}

.group {
  margin-top: 24rpx;
}

.label {
  display: block;
  color: #1F2328;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  line-height: 28rpx;
  height: 28rpx;
}

.label-star {
  color: #B95E49;
  margin-left: 4rpx;
}

.control {
  background: #ffffff;
  border: 1rpx solid #EDEFF2;
  border-radius: 20rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1F2328;
}

.field-row {
  display: flex;
  align-items: center;
}

.field-input {
  flex: 1;
  min-width: 0;
}

.control-disabled {
  background: #F3F4F6;
  border-color: #E5E7EB;
  color: #9CA3AF;
}

.placeholder-disabled {
  color: #9CA3AF;
}

picker .control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  line-height: normal;
}

picker {
  display: block;
}

picker .control text:first-child {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.error {
  color: #EF4444;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.avatar-box {
  display: flex;
  justify-content: center;
}

.avatar-btn {
  width: 160rpx !important;
  height: 160rpx !important;
  min-height: 160rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  border: none !important;
  background: transparent !important;
  border-radius: 50% !important;
  overflow: hidden;
  line-height: 1 !important;
  box-sizing: border-box;
}

.avatar-btn::after {
  display: none !important;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: block;
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #F3F4F6;
  border: 2rpx dashed #D1D5DB;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.avatar-plus {
  font-size: 48rpx;
  color: #9CA3AF;
  line-height: 1;
}

.avatar-hint {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
}

.agreement {
  margin-top: 18rpx;
}

.agreement-row {
  display: flex;
  align-items: flex-start;
}

.agreement-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 10rpx;
  border: 2rpx solid #D1D5DB;
  margin-top: 6rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.agreement-check.is-checked {
  border-color: #B95E49;
  background: #B95E49;
  box-shadow: inset 0 0 0 6rpx #ffffff;
}

.agreement-text {
  margin-left: 14rpx;
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.7;
}

.agreement-link {
  color: #B95E49;
  font-weight: 600;
}

.actions {
  margin-top: 36rpx;
}

.auth-inline-btn {
  margin-left: 12rpx;
  width: 120rpx;
  min-width: 120rpx;
  height: 64rpx !important;
  line-height: 64rpx !important;
  padding: 0 !important;
  border-radius: 9999rpx !important;
  border: 1rpx solid #DBB4AB !important;
  background: #DBB4AB !important;
  color: #1F2328 !important;
  box-shadow: 0 8rpx 22rpx rgba(219, 180, 171, 0.22);
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
  flex: 0 0 120rpx;
}

.auth-inline-btn::after {
  border: none;
}

.auth-inline-btn-disabled {
  background: #F3F4F6 !important;
  border-color: #E5E7EB !important;
  color: #9CA3AF !important;
  box-shadow: none;
}

.apple .btn,
.apple .btn-primary,
.apple .btn-outline {
  transition: none;
}

.btn-primary {
  background: #B95E49;
  color: #ffffff;
  border: 1rpx solid #B95E49;
  border-radius: 9999rpx;
  padding: 26rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 10rpx 28rpx rgba(185, 94, 73, 0.26);
}

.btn-outline {
  background: #ffffff;
  color: #B95E49;
  border: 1rpx solid #B95E49;
  border-radius: 9999rpx;
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: background-color 0.2s ease;
}

.btn-continue {
  width: 100%;
  text-align: center;
  height: 81rpx;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.btn-direct {
  width: 100%;
  margin-top: 16rpx;
  text-align: center;
  height: 81rpx;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.footer {
  margin-top: 28rpx;
  text-align: center;
}

.footer-text {
  color: #9CA3AF;
  font-size: 24rpx;
  line-height: 1.8;
}
