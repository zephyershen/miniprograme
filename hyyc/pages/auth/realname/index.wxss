@import "../../../styles/shadcn.wxss";

/* 现代苹果风格 - 实名认证页面 */
.apple {
  min-height: 100vh;
  padding: 48rpx 32rpx 80rpx;
  background: linear-gradient(180deg, #FFF8F6 0%, #FFE8E1 100%);
  position: relative;
}

.hero {
  margin-bottom: 36rpx;
  text-align: center;
}

.h1 {
  font-size: 48rpx;
  font-weight: 700;
  color: #FF8B7B;
  letter-spacing: 1rpx;
}

.sub {
  margin-top: 12rpx;
  color: #A0826D;
  font-size: 28rpx;
}

.panel {
  background: #ffffff;
  border: none;
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 139, 123, 0.1),
              0 4rpx 16rpx rgba(61, 50, 41, 0.04);
}

.group {
  margin-top: 24rpx;
}

.group:first-child {
  margin-top: 0;
}

.label {
  display: block;
  color: #5D4E3F;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.control {
  background: #FEFCFB;
  border: 2rpx solid #F5E6DC;
  border-radius: 16rpx;
  padding: 22rpx 20rpx;
  font-size: 28rpx;
  color: #3D3229;
  transition: all 0.3s ease;
}

.control:focus {
  border-color: #FF8B7B;
  background: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(255, 139, 123, 0.1);
}

picker .control {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.error {
  color: #FF6B6B;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.hint {
  font-size: 26rpx;
  color: #A0826D;
}

.hint.ok {
  color: #8ED6A9;
}

.hint.warn {
  color: #FF8B7B;
}

.gap > view + view {
  margin-left: 16rpx;
}

.half {
  flex: 1;
}

.row.gap {
  display: flex;
}

.actions {
  margin-top: 36rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #FF8B7B 0%, #FF7A69 100%);
  color: #ffffff;
  border: none;
  border-radius: 16rpx;
  padding: 26rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 139, 123, 0.3);
  transition: all 0.3s ease;
}

.btn-primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 16rpx rgba(255, 139, 123, 0.25);
}

.btn-outline {
  background: #ffffff;
  color: #FF8B7B;
  border: 2rpx solid #FF8B7B;
  border-radius: 12rpx;
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

.btn-outline:active {
  background: rgba(255, 139, 123, 0.08);
}

.btn-info {
  background: linear-gradient(135deg, #FFB4A9 0%, #FF8B7B 100%);
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255, 139, 123, 0.2);
}

.btn-sm {
  padding: 12rpx 20rpx;
  font-size: 24rpx;
}

.footer {
  margin-top: 32rpx;
  text-align: center;
}

.footer-text {
  color: #A0826D;
  font-size: 24rpx;
  line-height: 1.6;
}
