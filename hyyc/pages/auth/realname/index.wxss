@import "../../../styles/shadcn.wxss";

/* 和登录/欢迎页保持同一浅橙色背景 */
page {
  background-color: #FFECD6;
}

/* 现代苹果风格 - 实名认证页面 */
.apple {
  min-height: 100vh;
  padding: 48rpx 32rpx 80rpx;
  background: #FFECD6;
  position: relative;
}

.hero {
  margin-bottom: 36rpx;
  text-align: center;
}

.h1 {
  font-size: 48rpx;
  font-weight: 700;
  color: #FF8B7B;
  letter-spacing: 1rpx;
}

.sub {
  margin-top: 12rpx;
  color: #A0826D;
  font-size: 28rpx;
}

.panel {
  background: #ffffff;
  border: none;
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 139, 123, 0.1),
              0 4rpx 16rpx rgba(61, 50, 41, 0.04);
}

.group {
  margin-top: 24rpx;
}

.group:first-child {
  margin-top: 0;
}

.label {
  display: block;
  color: #5D4E3F;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  line-height: 28rpx;   /* 固定标签行高，避免高度误差 */
  height: 28rpx;        /* 两列标签保持一致高度 */
}

.control {
  background: #FEFCFB;
  border: 2rpx solid #F5E6DC;
  border-radius: 16rpx;
  height: 64rpx;          /* 统一输入类高度，与 .btn-sm 一致 */
  line-height: 64rpx;     /* 文本垂直居中（input/picker/view统一） */
  padding: 0 20rpx;       /* 去掉上下内边距，避免总高度不一致 */
  box-sizing: border-box; /* 高度包含边框，跨端一致性更好 */
  font-size: 28rpx;
  color: #3D3229;
  transition: all 0.3s ease;
}

/* 与按钮 .btn-sm 高度对齐（手机号一行） */
.control-sm {
  height: 64rpx;           /* 同 styles/shadcn.wxss 中 .btn-sm */
  line-height: 64rpx;      /* 对 input 主要依赖 height，保留兼容 picker/view */
  padding: 0 20rpx;        /* 去掉上下内边距，避免整体比按钮高 */
  box-sizing: border-box;  /* 高度包含边框，跨端更稳妥 */
}

.control:focus {
  border-color: #FF8B7B;
  background: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(255, 139, 123, 0.1);
}

picker .control {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 让 picker 成为块级，去除可能的基线/行高影响 */
picker { display: block; }

/* 防止选择文字换行撑高导致不对齐 */
picker .control text:first-child {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.error {
  color: #FF6B6B;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.hint {
  font-size: 26rpx;
  color: #A0826D;
}

.hint.ok {
  color: #8ED6A9;
}

.hint.warn {
  color: #FF8B7B;
}

.gap > view + view {
  margin-left: 16rpx;
}

.half {
  flex: 1;
}

.row.gap {
  display: flex;
}

/* 仅用于“楼栋/门号”这一行：强制顶部对齐，保证两个选择框在同一水平线 */
.row-top {
  align-items: flex-start;
}

/* 去掉成对行内每列自带的上边距，避免额外错位 */
.form-pair > .group { margin-top: 0; }

/* 兜底：主文案单行省略，避免因换行导致高度差 */
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

.actions {
  margin-top: 36rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #FF8B7B 0%, #FF7A69 100%);
  color: #ffffff;
  border: none;
  border-radius: 16rpx;
  padding: 26rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 139, 123, 0.3);
  transition: all 0.3s ease;
}

.btn-primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 16rpx rgba(255, 139, 123, 0.25);
}

.btn-outline {
  background: #ffffff;
  color: #FF8B7B;
  border: 2rpx solid #FF8B7B;
  border-radius: 12rpx;
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

.btn-outline:active {
  background: rgba(255, 139, 123, 0.08);
}

.btn-info {
  background: linear-gradient(135deg, #FFB4A9 0%, #FF8B7B 100%);
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255, 139, 123, 0.2);
}

.btn-sm {
  padding: 0 20rpx;  /* 仅左右留白，保持高度64rpx */
  font-size: 24rpx;
}

/* 更紧凑的“获取”按钮，缩短长度但保持等高 */
.btn-compact {
  padding: 0 8rpx;           /* 缩短长度 */
  width: 120rpx;             /* 固定更窄宽度 */
  min-width: 120rpx;         /* 防止被拉宽 */
  text-align: center;        /* 居中文本 */
  flex: 0 0 120rpx;          /* 在 flex 中锁定宽度 */
}

/* 说明：若后续需要极小按钮，再启用 .btn-xs 定义 */

.footer {
  margin-top: 32rpx;
  text-align: center;
}

.footer-text {
  color: #A0826D;
  font-size: 24rpx;
  line-height: 1.6;
}
