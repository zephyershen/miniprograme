@import "../../../styles/shadcn.wxss";

/* 实名页：多抓鱼风格（留白 + 卡片 + 砖红主按钮） */
page {
  background-color: #F5F6F8;
}

.apple {
  min-height: 100vh;
  padding: 48rpx 32rpx 80rpx;
  background: #F5F6F8;
  position: relative;
}

.hero {
  margin-bottom: 36rpx;
  text-align: center;
}

.h1 {
  font-size: 48rpx;
  font-weight: 700;
  color: #B95E49;
  letter-spacing: 1rpx;
}

.sub {
  margin-top: 12rpx;
  color: #6B7280;
  font-size: 28rpx;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #EDEFF2;
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(17, 24, 39, 0.06),
              0 4rpx 12rpx rgba(17, 24, 39, 0.04);
}

.group {
  margin-top: 24rpx;
}

.group:first-child {
  margin-top: 0;
}

.label {
  display: block;
  color: #1F2328;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  line-height: 28rpx;   /* 固定标签行高，避免高度误差 */
  height: 28rpx;        /* 两列标签保持一致高度 */
}

.label-star {
  color: #B95E49;
  margin-left: 4rpx;
}

.control {
  background: #ffffff;
  border: 1rpx solid #EDEFF2;
  border-radius: 20rpx;
  height: 64rpx;          /* 统一输入类高度，与 .btn-sm 一致 */
  line-height: 64rpx;     /* 文本垂直居中（input/picker/view统一） */
  padding: 0 20rpx;       /* 去掉上下内边距，避免总高度不一致 */
  box-sizing: border-box; /* 高度包含边框，跨端一致性更好 */
  font-size: 28rpx;
  color: #1F2328;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.control-disabled {
  background: #F3F4F6;
  border-color: #E5E7EB;
  color: #9CA3AF;
}

.placeholder-disabled {
  color: #9CA3AF;
}

/* 与按钮 .btn-sm 高度对齐（手机号一行） */
.control-sm {
  height: 64rpx;           /* 同 styles/shadcn.wxss 中 .btn-sm */
  line-height: 64rpx;      /* 对 input 主要依赖 height，保留兼容 picker/view */
  padding: 0 20rpx;        /* 去掉上下内边距，避免整体比按钮高 */
  box-sizing: border-box;  /* 高度包含边框，跨端更稳妥 */
}

.control:focus {
  border-color: #B95E49;
  box-shadow: 0 0 0 6rpx rgba(185, 94, 73, 0.12);
}

picker .control {
  display: flex;
  align-items: center;      /* 垂直居中对齐内容 */
  justify-content: space-between;
  line-height: normal;      /* 覆盖通用 line-height，防止文本基线偏移 */
}

/* 让 picker 成为块级，去除可能的基线/行高影响 */
picker { display: block; }

/* 防止选择文字换行撑高导致不对齐 */
picker .control text:first-child {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.error {
  color: #EF4444;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.hint {
  font-size: 26rpx;
  color: #6B7280;
}

/* 头像选择区 */
.avatar-box {
  display: flex;
  justify-content: center;
}

.avatar-btn {
  width: 160rpx !important;
  height: 160rpx !important;
  min-height: 160rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  border: none !important;
  background: transparent !important;
  border-radius: 50% !important;
  overflow: hidden;
  line-height: 1 !important;
  box-sizing: border-box;
}

.avatar-btn::after {
  display: none !important;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: block;
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #F3F4F6;
  border: 2rpx dashed #D1D5DB;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.avatar-plus {
  font-size: 48rpx;
  color: #9CA3AF;
  line-height: 1;
}

.avatar-hint {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
}

/* 身份证上传区 */
.idcard-box {
  background: #ffffff;
  border: 1rpx dashed #E5E7EB;
  border-radius: 20rpx;
  padding: 20rpx;
}

.idcard-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.idcard-preview {
  display: flex;
  flex-direction: column;
}

.idcard-image {
  width: 100%;
  height: 260rpx;
  border-radius: 16rpx;
  background: #F3F4F6;
}

.idcard-actions {
  margin-top: 16rpx;
  justify-content: center;
}

.idcard-tips {
  margin-top: 16rpx;
  text-align: center;
}

.idcard-tips .hint {
  display: block;
}

.hint.ok {
  color: #447244;
}

.hint.warn {
  color: #B95E49;
}

.agreement {
  margin-top: 18rpx;
}

.agreement-row {
  display: flex;
  align-items: center;
  padding: 8rpx 6rpx;
}

.agreement-check {
  width: 34rpx;
  height: 34rpx;
  border-radius: 9999rpx;
  border: 2rpx solid rgba(47, 107, 61, 0.35);
  box-sizing: border-box;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 34rpx;
}

.agreement-check.is-checked {
  border-color: #2F6B3D;
}

.agreement-check.is-checked::after {
  content: '';
  width: 18rpx;
  height: 18rpx;
  border-radius: 9999rpx;
  background: #2F6B3D;
}

.agreement-text {
  font-size: 26rpx;
  color: #1F2328;
  line-height: 34rpx;
}

.agreement-link {
  color: #2F6B3D;
  font-weight: 700;
}

.gap > view + view {
  margin-left: 16rpx;
}

.half {
  flex: 1;
}

.row.gap {
  display: flex;
}

/* 仅用于“楼栋/门号”这一行：强制顶部对齐，保证两个选择框在同一水平线 */
.row-top {
  align-items: flex-start;
}

/* 去掉成对行内每列自带的上边距，避免额外错位 */
.form-pair > .group { margin-top: 0; }

/* 兜底：主文案单行省略，避免因换行导致高度差 */
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

.actions {
  margin-top: 36rpx;
}

.btn-primary.btn-continue {
  height: 81rpx;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.apple .btn,
.apple .btn-primary,
.apple .btn-outline {
  /* 去掉按钮的过渡动画，让点击立即响应 */
  transition: none;
}

.btn-primary {
  background: #B95E49;
  color: #ffffff;
  border: 1rpx solid #B95E49;
  border-radius: 9999rpx;
  padding: 26rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 10rpx 28rpx rgba(185, 94, 73, 0.26);
}

.apple .btn:active,
.apple .btn-primary:active,
.apple .btn-outline:active {
  /* 去掉按下时的位移 / 阴影变化 */
  transform: none;
  opacity: 1;
  box-shadow: 0 10rpx 28rpx rgba(185, 94, 73, 0.26);
}

.btn-outline {
  background: #ffffff;
  color: #B95E49;
  border: 1rpx solid #B95E49;
  border-radius: 9999rpx;
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: background-color 0.2s ease;
}

.btn-outline:active {
  background: rgba(185, 94, 73, 0.08);
}

.btn-info {
  background: #DBB4AB;
  color: #1F2328;
  border: 1rpx solid #DBB4AB;
  border-radius: 9999rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 22rpx rgba(219, 180, 171, 0.22);
}

.btn-sm {
  padding: 0 20rpx;  /* 仅左右留白，保持高度64rpx */
  font-size: 24rpx;
}

/* 更紧凑的“获取”按钮，缩短长度但保持等高 */
.btn-compact {
  padding: 0 8rpx;           /* 缩短长度 */
  width: 120rpx;             /* 固定更窄宽度 */
  min-width: 120rpx;         /* 防止被拉宽 */
  text-align: center;        /* 居中文本 */
  flex: 0 0 120rpx;          /* 在 flex 中锁定宽度 */
}

/* 说明：若后续需要极小按钮，再启用 .btn-xs 定义 */

.footer {
  margin-top: 32rpx;
  text-align: center;
}

.footer-text {
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.6;
}
