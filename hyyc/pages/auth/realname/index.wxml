<ui-loading show="{{isLoading}}" />
<ui-error-dialog
  show="{{showUserExist}}"
  message="该用户已存在，请直接登录"
  confirm-text="确定"
  bindconfirm="onUserExistConfirm"
/>
<view class="apple">
  <view class="hero">
    <view>
      <text class="h1">验证业主身份</text>
    </view>
    <view>
      <text class="sub">为保障社区安全，请完成以下步骤。</text>
    </view>
  </view>

  <view class="panel">
    <view class="group">
      <text class="label">头像</text>
      <view class="avatar-box">
        <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
          <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
          <view wx:else class="avatar-placeholder">
            <text class="avatar-plus">+</text>
            <text class="avatar-hint">选择头像</text>
          </view>
        </button>
      </view>
    </view>

    <view class="group">
      <text class="label">昵称</text>
      <view class="row">
        <input
          class="control"
          style="flex:1; min-width:0"
          type="nickname"
          placeholder="请输入昵称（可点右侧“获取”后从键盘上方选择微信昵称）"
          value="{{form.nickname}}"
          focus="{{nicknameFocus}}"
          bindinput="onInput"
          data-key="nickname"
        />
        <button
          class="btn btn-info btn-sm btn-compact"
          size="mini"
          bindtap="onGetWechatProfile"
          style="margin-left:12rpx"
        >获取</button>
      </view>
      <text class="error" wx:if="{{errors.nickname}}">{{errors.nickname}}</text>
    </view>

    <view class="group">
      <text class="label">身份证正面（人像面）<text class="label-star">*</text></text>
      <view class="idcard-box">
        <view wx:if="{{!idCardFrontPreview}}" class="idcard-empty">
          <view class="btn btn-outline btn-sm" bindtap="chooseIdCardFront">上传照片</view>
          <view class="idcard-tips">
            <text class="hint">请拍清楚、不要反光、别遮挡四角</text>
            <text class="hint">请上传本人身份证</text>
          </view>
        </view>
        <view wx:else class="idcard-preview">
          <image class="idcard-image" src="{{idCardFrontPreview}}" mode="aspectFill" bindtap="previewIdCardFront" />
          <view class="row gap idcard-actions">
            <view class="btn btn-outline btn-sm" bindtap="chooseIdCardFront">重传</view>
            <view class="btn btn-outline btn-sm" bindtap="removeIdCardFront">删除</view>
          </view>
        </view>
      </view>
      <text class="error" wx:if="{{errors.idCardFront}}">{{errors.idCardFront}}</text>
    </view>

    <view class="group">
      <text class="label">身份证反面（国徽面）<text class="label-star">*</text></text>
      <view class="idcard-box">
        <view wx:if="{{!idCardBackPreview}}" class="idcard-empty">
          <view class="btn btn-outline btn-sm" bindtap="chooseIdCardBack">上传照片</view>
          <view class="idcard-tips">
            <text class="hint">请拍清楚、不要反光、别遮挡四角</text>
            <text class="hint">请上传本人身份证</text>
          </view>
        </view>
        <view wx:else class="idcard-preview">
          <image class="idcard-image" src="{{idCardBackPreview}}" mode="aspectFill" bindtap="previewIdCardBack" />
          <view class="row gap idcard-actions">
            <view class="btn btn-outline btn-sm" bindtap="chooseIdCardBack">重传</view>
            <view class="btn btn-outline btn-sm" bindtap="removeIdCardBack">删除</view>
          </view>
        </view>
      </view>
      <text class="error" wx:if="{{errors.idCardBack}}">{{errors.idCardBack}}</text>
    </view>

    <view class="group">
      <text class="label">身份证有效期<text class="label-star">*</text></text>
      <view class="row space-between cert-row">
        <text class="hint">长期有效</text>
        <switch
          checked="{{form.certValidityType === 'long'}}"
          bindchange="onCertValidityLongChange"
          color="#B95E49"
        />
      </view>
      <view class="row gap cert-range">
        <picker mode="date" value="{{form.certBeginDate}}" bindchange="onCertBeginDate">
          <view class="control row space-between">
            <text>{{form.certBeginDate || '开始日期'}}</text>
            <text>›</text>
          </view>
        </picker>
        <text class="cert-sep">至</text>
        <picker wx:if="{{form.certValidityType !== 'long'}}" mode="date" value="{{form.certEndDate}}" bindchange="onCertEndDate">
          <view class="control row space-between">
            <text>{{form.certEndDate || '结束日期'}}</text>
            <text>›</text>
          </view>
        </picker>
        <view wx:else class="control control-disabled row space-between">
          <text>长期有效</text>
        </view>
      </view>
      <text class="error" wx:if="{{errors.certBeginDate}}">{{errors.certBeginDate}}</text>
      <text class="error" wx:if="{{errors.certEndDate}}">{{errors.certEndDate}}</text>
    </view>

    <view class="group">
      <text class="label">手机号<text class="label-star">*</text></text>
      <view class="row">
        <input class="control control-disabled" style="flex:1; min-width:0" placeholder="请点击右侧“获取”授权获取手机号" placeholder-class="placeholder-disabled" disabled="{{true}}" value="{{form.phone}}" />
        <button class="btn btn-info btn-sm btn-compact" size="mini" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" style="margin-left:12rpx" disabled="{{phoneVerified}}">{{phoneVerified ? '已获取' : '获取'}}</button>
      </view>
      <text class="error" wx:if="{{errors.phone}}">{{errors.phone}}</text>
    </view>

    <view class="group">
      <text class="label">所属小区<text class="label-star">*</text></text>
      <picker mode="selector" range="{{communityLabels}}" value="{{communityIndex}}" bindchange="onCommunityChange">
        <view class="control row space-between">
          <text class="ellipsis">{{form.community || '请选择小区'}}</text>
          <text>›</text>
        </view>
      </picker>
      <text class="error" wx:if="{{errors.community}}">{{errors.community}}</text>
    </view>

    <view class="row gap row-top form-pair" style="margin-top:12rpx">
      <view class="group half">
        <text class="label">楼栋<text class="label-star">*</text></text>
        <picker mode="selector" range="{{buildingRange}}" value="{{buildingIndex}}" bindchange="onBuilding">
          <view class="control row space-between"><text class="ellipsis">{{form.building||'选择（1-23栋）'}}</text><text>›</text></view>
        </picker>
        <text class="error" wx:if="{{errors.building}}">{{errors.building}}</text>
      </view>
      <view class="group half">
        <text class="label">门号<text class="label-star">*</text></text>
        <picker mode="multiSelector" range="{{doorRange}}" value="{{doorIndex}}" bindchange="onDoorChange">
          <view class="control row space-between">
            <text class="ellipsis">{{form.door ? (form.door + '（' + form.floor + '楼-' + (doorRange[1][doorIndex[1]] || '') + '）') : '选择（每层01-04户）'}}</text>
            <text>›</text>
          </view>
        </picker>
        <text class="error" wx:if="{{errors.door}}">{{errors.door}}</text>
      </view>
    </view>

    <view class="group">
      <text class="label">小区邀请码（可选）</text>
      <input class="control" placeholder="如果物业有发邀请码，可填写（示例：HYYC2025）" value="{{form.inviteCode}}" bindinput="onInput" data-key="inviteCode"/>
      <text class="error" wx:if="{{errors.inviteCode}}">{{errors.inviteCode}}</text>
    </view>

    <view class="group">
      <text class="label">实时定位<text class="label-star">*</text></text>
      <view class="row">
        <text class="hint {{locationStatus}}" style="flex:1; min-width:0">{{locationText}}</text>
        <button
          class="btn btn-info btn-sm btn-compact"
          size="mini"
          bindtap="getLocation"
          style="margin-left:12rpx"
          disabled="{{isLoading || idCardUploading}}"
        >{{hasLocated ? '重新定位' : '获取定位'}}</button>
      </view>
    </view>

    <view class="agreement">
      <view class="agreement-row">
        <view class="agreement-check {{agreeChecked ? 'is-checked' : ''}}" bindtap="toggleAgree"></view>
        <view class="agreement-text" bindtap="toggleAgree">
          <text>我已阅读并同意</text>
          <text class="agreement-link" catchtap="openLegalDoc" data-type="user_agreement">「用户协议」</text>
          <text>和</text>
          <text class="agreement-link" catchtap="openLegalDoc" data-type="privacy_policy">「隐私政策」</text>
        </view>
      </view>
    </view>

    <view class="actions">
      <view class="btn btn-primary btn-continue" bindtap="submit">继续</view>
    </view>
  </view>

  <view class="footer">
    <text class="footer-text">我们只收集完成验证所需的最少信息，并严格用于社区安全。</text>
  </view>
</view>
