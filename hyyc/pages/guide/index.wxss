page {
  background: #f5f1eb;
}

.guide-page {
  min-height: 100vh;
  padding: 56rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at top right, rgba(47, 107, 61, 0.10), transparent 36%),
    linear-gradient(180deg, #faf7f2 0%, #f5f1eb 100%);
}

.guide-hero {
  padding: 20rpx 6rpx 18rpx;
}

.guide-kicker {
  display: block;
  font-size: 24rpx;
  color: #2f6b3d;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.guide-title {
  display: block;
  margin-top: 18rpx;
  font-size: 52rpx;
  line-height: 1.22;
  font-weight: 800;
  color: #1f2328;
}

.guide-subtitle {
  display: block;
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.75;
  color: #5f6773;
}

.guide-card {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
  padding: 26rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 16rpx 36rpx rgba(31, 35, 40, 0.08);
}

.guide-card-index {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: #2f6b3d;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.guide-card-main {
  margin-left: 18rpx;
  min-width: 0;
}

.guide-card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2328;
}

.guide-card-text {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #5f6773;
}

.trust-card {
  margin-top: 24rpx;
  padding: 26rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(47, 107, 61, 0.08);
  border: 1rpx solid rgba(47, 107, 61, 0.12);
}

.trust-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #2f6b3d;
}

.trust-text {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.72;
  color: #4b5563;
}

.trust-link {
  margin-top: 16rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #2f6b3d;
  font-size: 24rpx;
  font-weight: 700;
}

.guide-actions {
  margin-top: 34rpx;
}

.guide-btn {
  height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.guide-btn-primary {
  background: #2f6b3d;
  color: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(47, 107, 61, 0.22);
}

.guide-btn-secondary {
  margin-top: 18rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #2f6b3d;
  border: 2rpx solid rgba(47, 107, 61, 0.2);
}

.guide-link {
  margin-top: 22rpx;
  text-align: center;
  font-size: 24rpx;
  color: #7b8694;
}
