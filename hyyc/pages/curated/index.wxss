.column-page { box-sizing: border-box; min-height: 100vh; padding: 34rpx var(--ui-gutter) 112rpx; }
.column-header { padding: 6rpx 4rpx 34rpx; }
.column-kicker { display: flex; align-items: center; gap: 12rpx; color: var(--ui-muted); font-family: "DIN Alternate", -apple-system, sans-serif; font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }
.column-kicker text { width: 22rpx; height: 6rpx; border-radius: 999rpx; background: linear-gradient(90deg, var(--ui-accent), var(--ui-violet)); box-shadow: 0 0 18rpx rgba(91, 92, 226, .46); }
.column-title { margin-top: 18rpx; font-size: 57rpx; font-weight: 780; letter-spacing: -3rpx; line-height: 1.14; }
.column-deck { width: 94%; margin-top: 12rpx; color: var(--ui-muted); font-size: 24rpx; line-height: 1.65; }

.column-loading, .column-empty { display: flex; box-sizing: border-box; min-height: 240rpx; align-items: center; gap: 24rpx; padding: 34rpx; border-radius: 34rpx; background: var(--ui-surface); box-shadow: var(--ui-shadow-soft); }
.loading-orb { width: 62rpx; height: 62rpx; border-radius: 50%; background: linear-gradient(135deg, var(--ui-accent-soft), #ddd7ff); box-shadow: 0 0 38rpx rgba(91, 92, 226, .2); }
.loading-line { width: 250rpx; height: 16rpx; margin-top: 18rpx; border-radius: 999rpx; background: #dedfe6; }
.loading-line-wide { width: 360rpx; height: 28rpx; background: #c5c7d1; }
.column-empty { display: block; padding: 64rpx 32rpx; }
.empty-title { font-size: 34rpx; font-weight: 750; }
.empty-copy { margin-top: 16rpx; color: var(--ui-muted); font-size: 23rpx; line-height: 1.7; }
.text-action { display: inline-flex; min-height: 62rpx; align-items: center; margin-top: 22rpx; padding: 0 18rpx; border-radius: 18rpx; background: var(--ui-accent-soft); color: var(--ui-accent-strong); font-size: 22rpx; font-weight: 700; }

.column-gate { overflow: hidden; padding: 32rpx; border: 1rpx solid rgba(91, 92, 226, .11); border-radius: 40rpx; background: radial-gradient(circle at 100% 0%, rgba(126, 99, 239, .25), transparent 34%), linear-gradient(148deg, #efefff 0%, #fff 60%); box-shadow: var(--ui-shadow-raised); }
.gate-status { display: flex; align-items: center; gap: 12rpx; color: var(--ui-accent-strong); font-size: 19rpx; font-weight: 740; }
.gate-lock, .preview-lock { position: relative; box-sizing: border-box; width: 20rpx; height: 17rpx; border-radius: 6rpx; background: currentColor; opacity: .78; }
.gate-lock::before, .preview-lock::before { position: absolute; top: -10rpx; left: 4rpx; box-sizing: border-box; width: 12rpx; height: 12rpx; border: 3rpx solid currentColor; border-bottom: 0; border-radius: 10rpx 10rpx 0 0; content: ""; }
.gate-title { width: 90%; margin-top: 22rpx; font-size: 42rpx; font-weight: 780; line-height: 1.36; letter-spacing: -1rpx; }
.gate-copy { margin-top: 17rpx; color: var(--ui-muted); font-size: 24rpx; line-height: 1.72; }
.gate-tags { display: flex; gap: 10rpx; margin-top: 22rpx; }
.gate-tags text { padding: 9rpx 15rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .76); color: var(--ui-muted); font-size: 19rpx; font-weight: 650; }
.gate-action { display: flex; min-height: 78rpx; align-items: center; justify-content: space-between; margin-top: 26rpx; padding: 0 24rpx; border-radius: 23rpx; background: linear-gradient(135deg, var(--ui-accent), var(--ui-accent-strong)); box-shadow: var(--ui-shadow-accent); color: #fff; font-size: 24rpx; font-weight: 740; }
.gate-action text { font-size: 29rpx; }
.roadmap-label { margin-top: 42rpx; color: var(--ui-muted); font-size: 19rpx; font-weight: 720; }
.preview-list { display: flex; flex-direction: column; gap: 12rpx; margin-top: 14rpx; }
.preview-row { display: flex; align-items: center; gap: 18rpx; padding: 22rpx 20rpx; border-radius: 24rpx; background: rgba(255, 255, 255, .76); box-shadow: 0 6rpx 20rpx rgba(36, 39, 52, .05); }
.preview-order { flex: none; color: var(--ui-accent); font-family: "DIN Alternate", -apple-system, sans-serif; font-size: 18rpx; font-weight: 760; }
.preview-copy { flex: 1; min-width: 0; }
.preview-term, .lesson-term { color: var(--ui-accent); font-family: "DIN Alternate", -apple-system, sans-serif; font-size: 17rpx; font-weight: 720; letter-spacing: .8rpx; }
.preview-title { margin-top: 6rpx; font-size: 27rpx; font-weight: 730; }
.preview-subtitle { overflow: hidden; margin-top: 7rpx; color: var(--ui-muted); font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.preview-lock { flex: none; color: var(--ui-faint); }

.column-hero { position: relative; overflow: hidden; min-height: 300rpx; padding: 32rpx; border: 1rpx solid rgba(91, 92, 226, .1); border-radius: 40rpx; background: linear-gradient(145deg, #ededff 0%, #fafaff 76%); box-shadow: var(--ui-shadow-raised); }
.hero-label { color: var(--ui-accent); font-size: 19rpx; font-weight: 740; }
.hero-title { position: relative; z-index: 1; width: 78%; margin-top: 20rpx; font-size: 42rpx; font-weight: 780; line-height: 1.36; }
.hero-copy { position: relative; z-index: 1; width: 82%; margin-top: 12rpx; color: var(--ui-muted); font-size: 23rpx; line-height: 1.62; }
.hero-action { position: relative; z-index: 1; display: inline-flex; min-height: 62rpx; align-items: center; gap: 18rpx; margin-top: 24rpx; padding: 0 20rpx; border-radius: 18rpx; background: var(--ui-accent); color: #fff; font-size: 21rpx; font-weight: 720; }
.hero-glow { position: absolute; right: -46rpx; bottom: -64rpx; width: 250rpx; height: 250rpx; border-radius: 50%; background: radial-gradient(circle at 34% 32%, rgba(255, 255, 255, .9), rgba(126, 99, 239, .24) 36%, rgba(91, 92, 226, .04) 70%); }

.track-scroll { width: 100%; margin-top: 22rpx; white-space: nowrap; }
.track-list { display: inline-flex; gap: 10rpx; }
.track-chip { display: inline-flex; min-height: 60rpx; align-items: center; padding: 0 20rpx; border-radius: 20rpx; background: rgba(255, 255, 255, .68); color: var(--ui-muted); font-size: 21rpx; font-weight: 660; }
.track-chip-active { background: var(--ui-surface-solid); box-shadow: var(--ui-shadow-soft); color: var(--ui-accent-strong); }
.lesson-list { display: flex; flex-direction: column; gap: 14rpx; margin-top: 18rpx; }
.lesson-card { padding: 24rpx; border: 1rpx solid rgba(255, 255, 255, .72); border-radius: 30rpx; background: var(--ui-surface); box-shadow: var(--ui-shadow-soft); }
.lesson-card-open { border-color: rgba(91, 92, 226, .12); background: linear-gradient(152deg, #fff 20%, #f8f8ff 100%); box-shadow: var(--ui-shadow-raised); }
.lesson-top { display: flex; align-items: flex-start; gap: 18rpx; }
.lesson-order { flex: none; padding-top: 3rpx; color: var(--ui-accent); font-family: "DIN Alternate", -apple-system, sans-serif; font-size: 19rpx; font-weight: 780; }
.lesson-heading { flex: 1; min-width: 0; }
.lesson-title { margin-top: 8rpx; font-size: 29rpx; font-weight: 750; line-height: 1.42; }
.lesson-subtitle { margin-top: 8rpx; color: var(--ui-muted); font-size: 21rpx; line-height: 1.5; }
.lesson-toggle { display: flex; flex: none; width: 48rpx; height: 48rpx; align-items: center; justify-content: center; border-radius: 16rpx; background: var(--ui-surface-muted); color: var(--ui-accent); font-size: 31rpx; font-weight: 400; }
.lesson-body { margin-top: 24rpx; padding-top: 4rpx; }
.poster-intro { display: flex; align-items: center; justify-content: space-between; padding: 0 8rpx 12rpx; color: var(--ui-muted); font-size: 18rpx; font-weight: 680; }
.poster-intro text:first-child { color: var(--ui-accent); }
.poster-swiper { width: 100%; height: 850rpx; }
.poster-frame { position: relative; box-sizing: border-box; width: calc(100% - 12rpx); height: 814rpx; margin: 0 auto; overflow: hidden; border: 1rpx solid rgba(45, 48, 61, .1); border-radius: 26rpx; background: #f4f0e5; box-shadow: 0 14rpx 34rpx rgba(33, 36, 48, .11); }
.poster-fallback { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; padding: 40rpx; color: var(--ui-muted); font-size: 21rpx; text-align: center; }
.poster-image { position: relative; z-index: 1; display: block; width: 100%; height: 100%; }
.poster-hd-badge { position: absolute; z-index: 2; top: 20rpx; right: 20rpx; display: flex; min-height: 52rpx; align-items: center; gap: 9rpx; padding: 0 18rpx; border: 1rpx solid rgba(255, 255, 255, .56); border-radius: 999rpx; background: rgba(28, 30, 39, .76); box-shadow: 0 8rpx 24rpx rgba(22, 24, 32, .2); color: #fff; font-size: 19rpx; font-weight: 700; backdrop-filter: blur(16rpx); }
.poster-hd-icon { position: relative; box-sizing: border-box; width: 18rpx; height: 18rpx; border: 2rpx solid currentColor; border-radius: 5rpx; }
.poster-hd-icon::after { position: absolute; right: -5rpx; bottom: -5rpx; width: 7rpx; height: 7rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; content: ""; }
.lesson-block { margin-top: 18rpx; padding: 22rpx; border-radius: 22rpx; background: rgba(238, 239, 245, .76); }
.block-label { color: var(--ui-accent); font-size: 18rpx; font-weight: 740; }
.block-copy, .takeaway-copy { margin-top: 10rpx; color: var(--ui-muted); font-size: 23rpx; line-height: 1.72; }
.block-copy-strong { color: var(--ui-ink); font-weight: 660; }
.lesson-takeaway { margin-top: 14rpx; padding: 22rpx; border-radius: 22rpx; background: var(--ui-accent-soft); }
.takeaway-copy { color: var(--ui-accent-strong); font-weight: 680; }
