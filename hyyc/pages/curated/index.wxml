<page-meta page-style="{{membershipPromptVisible ? 'overflow: hidden;' : ''}}" />
<view class="manual-page">
  <view class="manual-head">
    <view class="manual-kicker">AI 学习手册</view>
    <view class="manual-title">先看懂，再动手</view>
    <view class="manual-deck">先用日常例子把 AI 讲明白，再跟着步骤把工具装好、真正用起来。</view>
    <view wx:if="{{home.updatedLabel}}" class="manual-updated">{{home.updatedLabel}}</view>
  </view>

  <view class="section-nav" role="tablist">
    <view
      wx:for="{{sectionTabs}}"
      wx:key="key"
      class="section-tab {{item.active ? 'section-tab-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="selectSection"
      role="tab"
    >
      <text>{{item.label}}</text>
      <label>{{item.note}}</label>
    </view>
  </view>

  <view wx:if="{{loading}}" class="manual-state">
    <view class="state-rule state-rule-wide"></view>
    <view class="state-rule"></view>
    <view class="state-rule state-rule-short"></view>
  </view>

  <view wx:elif="{{error}}" class="manual-state">
    <view class="state-title">这一页暂时没有加载好</view>
    <view class="state-copy">{{error}}</view>
    <view class="text-action" bindtap="retry">重新读取 →</view>
  </view>

  <block wx:else>
    <view wx:if="{{locked}}" class="access-note" bindtap="openMembershipPrompt">
      <view><text class="access-mark">PRO</text><text>Pro 专属 · 当前展示目录预览</text></view>
      <text class="access-link">查看完整内容 →</text>
    </view>

    <view wx:if="{{homeNotice}}" class="home-notice" bindtap="retry">{{homeNotice}} <text>重新读取 →</text></view>

    <view wx:if="{{activeSection === 'courses'}}" class="manual-section">
      <view class="section-heading">
        <view><view class="section-index">第一部分</view><view class="section-title">基础课</view></view>
        <view class="section-note">用生活里的例子，把概念讲清楚</view>
      </view>
      <view class="course-groups">
        <view wx:for="{{home.courseGroups}}" wx:for-item="group" wx:key="key" class="course-group">
          <view class="course-track-head">
            <view class="course-track-number">{{index + 1 < 10 ? '0' + (index + 1) : index + 1}}</view>
            <view class="course-track-copy"><view class="course-track-title">{{group.label}}</view><view wx:if="{{group.note}}" class="course-track-note">{{group.note}}</view></view>
            <view class="course-track-count">{{group.lessons.length}} 节</view>
          </view>
          <view class="manual-sheet">
            <view
              wx:for="{{group.lessons}}"
              wx:for-item="lesson"
              wx:key="id"
              class="manual-row"
              data-id="{{lesson.id}}"
              bindtap="openLesson"
            >
              <view class="row-margin"><text>{{lesson.order}}</text></view>
              <view class="row-copy">
                <view class="row-eyebrow">{{lesson.eyebrow}}</view>
                <view class="row-title">{{lesson.title}}</view>
                <view wx:if="{{lesson.subtitle}}" class="row-subtitle">{{lesson.subtitle}}</view>
                <view wx:if="{{lesson.duration || lesson.updatedLabel}}" class="row-meta"><text wx:if="{{lesson.duration}}">{{lesson.duration}}</text><text wx:if="{{lesson.updatedLabel}}">{{lesson.updatedLabel}}</text></view>
              </view>
              <view class="row-end"><view wx:if="{{locked}}" class="row-lock"></view><text wx:else>↗</text></view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="manual-section practical-section">
      <view class="section-heading">
        <view><view class="section-index">第二部分</view><view class="section-title">动手课</view></view>
        <view class="section-note">从安装开始，完成第一个真实任务</view>
      </view>
      <view class="manual-sheet">
        <view
          wx:for="{{home.practicals}}"
          wx:key="id"
          class="manual-row"
          data-id="{{item.id}}"
          bindtap="openPractical"
        >
          <view class="row-margin"><text>{{item.order}}</text></view>
          <view class="row-copy">
            <view class="row-eyebrow">{{item.eyebrow}}</view>
            <view class="row-title">{{item.title}}</view>
            <view wx:if="{{item.subtitle}}" class="row-subtitle">{{item.subtitle}}</view>
            <view wx:if="{{item.duration || item.updatedLabel}}" class="row-meta"><text wx:if="{{item.duration}}">{{item.duration}}</text><text wx:if="{{item.updatedLabel}}">{{item.updatedLabel}}</text></view>
          </view>
          <view class="row-end"><view wx:if="{{locked}}" class="row-lock"></view><text wx:else>↗</text></view>
        </view>
      </view>

      <view class="support-note">
        <view class="support-kicker">会员技术支持</view>
        <view class="support-title">安装卡住了，可以私聊我</view>
        <view class="support-copy">Pro 会员安装或使用工具时遇到问题，可以私聊我的微信，我会帮你一起排查；这项技术支持不另外收费。</view>
        <view class="support-boundary">Codex CLI、Claude Code 等工具自身的订阅、API 和云服务费用不包含在会员中。</view>
      </view>
    </view>
  </block>

  <membership-prompt
    visible="{{membershipPromptVisible}}"
    feature-key="{{membershipPromptFeature}}"
    bindclose="closeMembershipPrompt"
    bindviewbenefits="openMembershipFromPrompt"
  />
</view>
