<view class="column-page">
  <view class="column-header">
    <view class="column-kicker"><text></text>AI KNOWLEDGE</view>
    <view class="column-title">AI 专栏</view>
    <view class="column-deck">从 Agent、Skill、MCP 开始，把 AI 的关键概念讲成人话。</view>
  </view>

  <view wx:if="{{loading}}" class="column-loading">
    <view class="loading-orb"></view>
    <view><view class="loading-line loading-line-wide"></view><view class="loading-line"></view></view>
  </view>

  <view wx:elif="{{error}}" class="column-empty">
    <view class="empty-title">专栏暂时没有加载成功</view>
    <view class="empty-copy">{{error}}</view>
    <view class="text-action" bindtap="retry">重新加载 →</view>
  </view>

  <view wx:elif="{{locked}}" class="column-gate">
    <view class="gate-status"><view class="gate-lock"></view><text>Pro 专属 · 内测中</text></view>
    <view class="gate-title">把 AI 听懂，也真正用起来</view>
    <view class="gate-copy">每篇只解决一个问题：一句定义、一个例子、一个判断方法。无需技术背景，也能建立完整认知。</view>
    <view class="gate-tags"><text>讲人话</text><text>有例子</text><text>能判断</text></view>
    <view class="gate-action" bindtap="openProfile">查看 Pro 权益 <text>→</text></view>

    <view class="roadmap-label">从这里开始</view>
    <view class="preview-list">
      <view wx:for="{{view.previewLessons}}" wx:key="id" class="preview-row" bindtap="openProfile">
        <view class="preview-order">{{item.order}}</view>
        <view class="preview-copy"><view class="preview-term">{{item.term}} · {{item.duration}}</view><view class="preview-title">{{item.title}}</view><view class="preview-subtitle">{{item.subtitle}}</view></view>
        <view class="preview-lock"></view>
      </view>
    </view>
  </view>

  <block wx:else>
    <view class="column-hero">
      <view class="hero-label">建议从这里开始</view>
      <view class="hero-title">{{view.nextLesson.title}}</view>
      <view class="hero-copy">{{view.nextLesson.subtitle}}</view>
      <view class="hero-action" data-id="{{view.nextLesson.id}}" bindtap="toggleLesson">开始阅读 <text>→</text></view>
      <view class="hero-glow"></view>
    </view>

    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="track-scroll">
      <view class="track-list">
        <view wx:for="{{view.tracks}}" wx:key="key" class="track-chip {{item.active ? 'track-chip-active' : ''}}" data-key="{{item.key}}" bindtap="selectTrack">{{item.label}}</view>
      </view>
    </scroll-view>

    <view class="lesson-list">
      <view wx:for="{{view.lessons}}" wx:key="id" class="lesson-card {{item.expanded ? 'lesson-card-open' : ''}}" data-id="{{item.id}}" bindtap="toggleLesson">
        <view class="lesson-top">
          <view class="lesson-order">{{item.order}}</view>
          <view class="lesson-heading"><view class="lesson-term">{{item.term}} · {{item.duration}}</view><view class="lesson-title">{{item.title}}</view><view class="lesson-subtitle">{{item.subtitle}}</view></view>
          <view class="lesson-toggle">{{item.expanded ? '−' : '+'}}</view>
        </view>
        <view wx:if="{{item.expanded}}" class="lesson-body">
          <view class="poster-intro"><text>手绘故事课</text><text>点开看高清 · 左右滑动 {{item.posters.length}} 页</text></view>
          <swiper class="poster-swiper" current="{{activePosterIndex}}" indicator-dots="{{true}}" indicator-color="rgba(74, 77, 92, .2)" indicator-active-color="#5457df" duration="320" bindchange="handlePosterChange" catchtap="stopPropagation">
            <swiper-item wx:for="{{item.posters}}" wx:for-item="poster" wx:for-index="posterIndex" wx:key="key">
              <view class="poster-frame">
                <view class="poster-fallback">{{posterError === poster.key ? '海报加载失败，请重新进入专栏' : '正在加载海报…'}}</view>
                <image wx:if="{{posterLoads[posterIndex]}}" class="poster-image" src="{{poster.image}}" mode="aspectFit" fade-in="{{false}}" aria-label="{{poster.alt}}，点击查看高清大图" data-key="{{poster.key}}" data-id="{{item.id}}" data-index="{{posterIndex}}" catchtap="previewPoster" binderror="handlePosterError" />
                <view wx:if="{{posterLoads[posterIndex]}}" class="poster-hd-badge" data-id="{{item.id}}" data-index="{{posterIndex}}" catchtap="previewPoster"><text class="poster-hd-icon"></text><text>高清查看</text></view>
              </view>
            </swiper-item>
          </swiper>
        </view>
      </view>
    </view>
  </block>
</view>
