.settings-button { margin: 2rpx 0 0; }

.cards-list { display: flex; flex-direction: column; gap: 16rpx; }

.conclusion-card { padding: 28rpx; }

.card-meta, .card-actions { display: flex; align-items: center; justify-content: space-between; }
.card-meta { color: var(--ui-muted); font-family: "DIN Alternate", -apple-system, sans-serif; font-size: 19rpx; }
.card-conclusion { margin-top: 20rpx; font-size: 34rpx; font-weight: 730; line-height: 1.52; }

.card-use {
  margin-top: 18rpx;
  padding: 17rpx 19rpx;
  border-radius: 19rpx;
  background: var(--ui-accent-soft);
  color: var(--ui-muted);
  line-height: 1.58;
}

.card-source { margin-top: 18rpx; color: var(--ui-muted); font-size: 23rpx; line-height: 1.5; }
.card-actions { justify-content: flex-end; gap: 12rpx; margin-top: 20rpx; }

.mini-action {
  min-height: 60rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: var(--ui-surface-muted);
  color: var(--ui-ink);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 60rpx;
}

.danger-text { background: var(--ui-danger-soft); color: var(--ui-danger); }
