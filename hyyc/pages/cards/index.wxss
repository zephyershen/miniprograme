.saved-section-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 34rpx 2rpx 18rpx; }
.saved-section-title { font-size: 30rpx; font-weight: 780; }
.saved-section-copy { margin-top: 5rpx; color: var(--ui-faint); font-size: 19rpx; }
.saved-empty { padding: 48rpx 26rpx; border-radius: 24rpx; background: var(--ui-surface-muted); color: var(--ui-muted); font-size: 22rpx; line-height: 1.65; text-align: center; }

.favorite-list { display: flex; flex-direction: column; gap: 18rpx; }
.favorite-row { position: relative; display: flex; align-items: center; gap: 20rpx; padding: 22rpx; border-radius: 24rpx; background: var(--ui-surface-solid); box-shadow: var(--ui-shadow-card); }
.favorite-row:active { transform: scale(0.99); }
.favorite-row-locked { background: var(--ui-surface-muted); box-shadow: none; }
.favorite-thumb-shell { position: relative; display: flex; width: 132rpx; height: 100rpx; flex: none; align-items: center; justify-content: center; overflow: hidden; border-radius: 16rpx; background: var(--ui-surface-muted); }
.favorite-thumb { width: 100%; height: 100%; }
.favorite-thumb-spinner { box-sizing: border-box; width: 26rpx; height: 26rpx; border: 3rpx solid rgba(29, 155, 240, .18); border-top-color: var(--ui-accent); border-radius: 50%; animation: favorite-thumb-spin .75s linear infinite; }
@keyframes favorite-thumb-spin { to { transform: rotate(360deg); } }
.favorite-copy { flex: 1; min-width: 0; }
.favorite-title { overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; color: var(--ui-ink); font-size: 27rpx; font-weight: 720; line-height: 1.45; }
.favorite-meta { overflow: hidden; margin-top: 10rpx; color: var(--ui-faint); font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.favorite-row-locked .favorite-title { color: var(--ui-muted); }
.favorite-remove { flex: none; align-self: flex-start; padding: 6rpx 0 6rpx 14rpx; color: var(--ui-faint); font-size: 20rpx; }
