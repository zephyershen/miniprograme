.settings-button {
  margin: 2rpx 0 0;
}

.cards-list {
  display: flex;
  flex-direction: column;
  border-top: 1rpx solid var(--editorial-ink);
}

.conclusion-card {
  padding: 34rpx 0;
  border-top: none;
}

.card-meta,
.card-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-meta {
  color: var(--editorial-muted);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.card-conclusion {
  margin-top: 22rpx;
  font-size: 36rpx;
  font-weight: 760;
  line-height: 1.5;
}

.card-use {
  margin-top: 18rpx;
  padding: 4rpx 0 4rpx 20rpx;
  border-left: 5rpx solid var(--editorial-blue);
  border-radius: 0;
  background: transparent;
  color: var(--editorial-muted);
  line-height: 1.55;
}

.card-source {
  margin-top: 18rpx;
  color: var(--editorial-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.card-actions {
  justify-content: flex-end;
  gap: 22rpx;
  margin-top: 20rpx;
}

.mini-action {
  margin: 0;
  padding: 0;
  border-bottom: 2rpx solid var(--editorial-ink);
  background: transparent;
  color: var(--editorial-ink);
  font-size: 23rpx;
  font-weight: 550;
  line-height: 56rpx;
}

.danger-text {
  border-bottom-color: var(--editorial-danger);
  color: var(--editorial-danger);
}
