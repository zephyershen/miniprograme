<page-meta page-style="{{membershipPromptVisible ? 'overflow: hidden;' : ''}}" />
<view class="page">
  <view class="page-header">
    <view>
      <view class="eyebrow">SAVED</view>
      <view class="page-title">我的收藏</view>
      <view class="page-subtitle">每条收藏只保留必要线索，需要时再回到资讯详情。</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-copy"><loading-state label="正在读取保存的内容" /></view>

  <block wx:else>
    <view class="saved-section-head"><view><view class="saved-section-title">资讯收藏</view><view class="saved-section-copy">{{favorites.length}} 条阅读线索</view></view></view>
    <view wx:if="{{!favorites.length}}" class="saved-empty">在资讯页点下书签后，会以一行摘要出现在这里。</view>
    <view wx:else class="favorite-list">
      <view
        wx:for="{{favorites}}"
        wx:key="id"
        class="favorite-row {{item.available ? '' : 'favorite-row-locked'}}"
        data-id="{{item.id}}"
        data-available="{{item.available ? '1' : '0'}}"
        bindtap="openFavorite"
      >
        <view wx:if="{{item.listVisualFileId || item.visualFileId || item.listVisualUrl}}" class="favorite-thumb-shell">
          <image wx:if="{{item.listVisualUrl}}" class="favorite-thumb" src="{{item.listVisualUrl}}" mode="aspectFill" lazy-load="{{true}}" data-media-key="favorite:{{item.id}}:list" data-file-id="{{item.listVisualFileId || item.visualFileId}}" data-media-url="{{item.listVisualUrl}}" data-media-path="favorites[{{index}}].listVisualUrl" binderror="handleMediaError" />
          <view wx:else class="favorite-thumb-spinner"></view>
        </view>
        <view class="favorite-copy">
          <view class="favorite-title">{{item.title}}</view>
          <view class="favorite-meta">{{item.source}} · {{item.savedLabel}}{{item.available ? '' : ' · 需会员回看'}}</view>
        </view>
        <view class="favorite-remove" data-id="{{item.id}}" catchtap="removeFavorite">移除</view>
      </view>
    </view>

  </block>

  <membership-prompt
    visible="{{membershipPromptVisible}}"
    feature-key="{{membershipPromptFeature}}"
    bindclose="closeMembershipPrompt"
    bindviewbenefits="openMembershipFromPrompt"
  />
</view>
