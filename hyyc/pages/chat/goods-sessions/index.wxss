@import "../../../styles/shadcn.wxss";

.center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-session-head {
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #F5F7FA;
  color: #4B5563;
  font-size: 24rpx;
  line-height: 1.6;
}

.sessions-chat-btn {
  position: relative;
}

.session-unread-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: #B95E49;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 36rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 2rpx #ffffff;
}
