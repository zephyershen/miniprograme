<ui-loading show="{{isLoading}}" />
<view class="px-24 py-16">
  <view wx:if="{{!list.length && !isLoading}}" class="center" style="height: 40vh;">
    <text class="c-muted">暂时没有任何聊天记录</text>
  </view>

  <block wx:for="{{list}}" wx:key="peerUserId">
    <view class="mt-16">
      <ui-card title="{{item.peerName}}" sub="{{item.lastTimeText}}">
        <view class="row space-between">
          <text class="text-sm c-muted" style="max-width: 70%;">
            {{item.lastText}}
          </text>
          <view
            class="btn btn-outline btn-sm sessions-chat-btn"
            data-peer="{{item.peerUserId}}"
            bindtap="toChat">
            去聊天
            <view
              wx:if="{{item.unreadCount > 0}}"
              class="session-unread-badge"
            >
              {{ item.unreadCount > 99 ? '99+' : item.unreadCount }}
            </view>
          </view>
        </view>
      </ui-card>
    </view>
  </block>
</view>
