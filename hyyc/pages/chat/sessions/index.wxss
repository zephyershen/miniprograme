@import "../../../styles/shadcn.wxss";

.center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.sessions-chat-btn {
  position: relative;
}

/* 会话列表中，每个住户会话的未读红点 */
.session-unread-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: #B95E49;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 36rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 2rpx #ffffff;
}
