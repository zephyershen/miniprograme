<ui-loading show="{{isLoading}}" />
<!-- 整个页面用纵向布局铺满可见区域 -->
<view class="chat-container">
  <!-- 头部：显示对方昵称/姓名 -->
  <view class="chat-header">
    <view class="chat-header-title">{{peerDisplayName || '对方'}}</view>
  </view>

  <!-- 聊天消息区域：内部滚动 -->
  <scroll-view
    class="chat-scroll {{contentReady ? '' : 'chat-scroll-hidden'}}"
    scroll-y
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
    scroll-with-animation="{{scrollWithAnimation}}"
    scroll-top="{{scrollTop}}"
    bindscroll="onScroll"
  >
    <block wx:for="{{msgs}}" wx:key="id">
      <chat-bubble
        id="m{{item.id}}"
        mine="{{item.mine}}"
        type="{{item.type}}"
        text="{{item.text}}"
        image-url="{{item.imageUrl}}"
      />
    </block>
  </scroll-view>

  <!-- 底部输入栏，使用 flex 布局而非 fixed 定位 -->
  <view class="chat-input-safe" style="padding-bottom: calc(16rpx + {{keyboardHeight}}px + env(safe-area-inset-bottom));">
    <view class="row chat-input-bar">
      <view class="chat-plus-btn" bindtap="openMediaActions">
        <view class="chat-plus-line chat-plus-line-h"></view>
        <view class="chat-plus-line chat-plus-line-v"></view>
      </view>
      <input class="input chat-input" placeholder="输入消息" value="{{text}}" bindinput="onInput" adjust-position="{{false}}" hold-keyboard="{{true}}"/>
      <view class="btn btn-primary btn-sm" bindtap="send">发送</view>
    </view>
  </view>
</view>
