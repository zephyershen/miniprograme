<view class="px-24 py-16">
  <view class="card">
    <ui-field label="完成说明">
      <textarea class="textarea" placeholder="简单描述完成情况" value="{{note}}" bindinput="onNote"/>
    </ui-field>
    <ui-field label="上传凭证（照片）">
      <view class="row wrap row-gap-8">
        <block wx:for="{{images}}" wx:key="*this"><image src="{{item}}" style="width:200rpx;height:200rpx;border-radius:12rpx;" lazy-load="true"/></block>
        <view class="btn btn-outline btn-sm" bindtap="choose">上传图片</view>
      </view>
    </ui-field>
    <view class="row space-between mt-16">
      <view class="btn btn-outline" bindtap="cancel">取消</view>
      <view class="btn btn-primary" bindtap="submit">提交验收</view>
    </view>
  </view>
 </view>
