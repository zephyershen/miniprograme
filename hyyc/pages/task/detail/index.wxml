<ui-loading show="{{isLoading}}" />
<view class="px-24 py-16">
  <ui-card title="{{task.title}}" sub="{{task.community}} · {{task.address}}">
    <view class="row space-between">
      <text class="text-xl bold c-danger">¥ {{task.amountText}}</text>
      <view class="badge">{{task.statusText}}</view>
    </view>
    <view class="mt-16 c-muted">{{task.desc}}</view>
    <view class="row wrap mt-12 row-gap-8">
      <image wx:for="{{task.images}}" wx:key="*this" src="{{item}}" style="width:200rpx;height:200rpx;border-radius:12rpx;" lazy-load="true"/>
    </view>
  </ui-card>

  <view class="card mt-16">
    <text class="card-title">操作</text>
    <view class="row space-between mt-16" wx:if="{{!isOwner && !accepted}}">
      <view class="btn btn-primary" bindtap="accept">接受任务</view>
      <view class="btn btn-outline" bindtap="toChat">先沟通</view>
    </view>
    <view class="row space-between mt-16" wx:if="{{!isOwner && accepted}}">
      <view class="btn btn-primary" bindtap="toSubmit">提交完成</view>
      <view class="btn btn-outline" bindtap="toChat">与业主聊天</view>
    </view>
    <view class="row space-between mt-16" wx:if="{{isOwner}}">
      <view class="btn btn-outline" bindtap="toChat">与接单人聊天</view>
      <view class="btn btn-primary" bindtap="approve">确认完成</view>
    </view>
  </view>
</view>
