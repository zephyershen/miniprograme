<ui-loading show="{{isLoading}}" />
<view class="px-24 py-16">
  <ui-card title="{{task.title}}" sub="{{task.community}} · {{task.locationText}}">
    <view class="row space-between">
      <text class="text-xl bold c-danger">¥ {{task.amountText}}</text>
      <view class="badge">{{task.statusText}}</view>
    </view>
    <view class="mt-16 c-muted">{{task.desc}}</view>
    <view class="row wrap mt-12 row-gap-8">
      <image
        wx:for="{{task.images}}"
        wx:key="*this"
        class="row-gap-item"
        src="{{item}}"
        style="width:200rpx;height:200rpx;border-radius:12rpx;"
        lazy-load="true"
        data-index="{{index}}"
        bindtap="previewTaskImage"
      />
    </view>
  </ui-card>

  <view wx:if="{{task.submitView}}" class="card mt-16">
    <view class="submit-record-head">
      <text class="card-title">完成提交</text>
      <text wx:if="{{task.submitView.submittedAtText}}" class="submit-record-time">{{task.submitView.submittedAtText}}</text>
    </view>
    <view wx:if="{{task.submitView.note}}" class="submit-record-note">{{task.submitView.note}}</view>
    <view wx:if="{{task.submitView.images.length}}" class="row wrap mt-12 row-gap-8">
      <image
        wx:for="{{task.submitView.images}}"
        wx:key="*this"
        class="row-gap-item submit-record-image"
        src="{{item}}"
        mode="aspectFill"
        lazy-load="true"
        data-index="{{index}}"
        bindtap="previewSubmitImage"
      />
    </view>
  </view>

  <view class="card mt-16">
    <text class="card-title">操作</text>

    <!-- 任务闭环未开放时：仅保留聊天入口 -->
    <view wx:if="{{!workflowEnabled}}">
      <view class="row space-between mt-16" wx:if="{{!isOwner}}">
        <view class="btn btn-primary" bindtap="toChat" style="position:relative;">
          与业主聊天
          <view
            wx:if="{{peerUnreadCount > 0}}"
            class="chat-unread-badge"
          >
            {{ peerUnreadCount > 99 ? '99+' : peerUnreadCount }}
          </view>
        </view>
      </view>
      <view class="row space-between mt-16" wx:if="{{isOwner}}">
        <view wx:if="{{task.workerId}}" class="btn btn-primary" bindtap="toChat" style="position:relative;">
          与接单人聊天
          <view
            wx:if="{{unreadCount > 0}}"
            class="chat-unread-badge"
          >
            {{ unreadCount > 99 ? '99+' : unreadCount }}
          </view>
        </view>
        <view wx:else class="btn btn-primary" bindtap="toChatSessions" style="position:relative;">
          聊天会话列表
          <view
            wx:if="{{unreadCount > 0}}"
            class="chat-unread-badge"
          >
            {{ unreadCount > 99 ? '99+' : unreadCount }}
          </view>
        </view>
      </view>
    </view>

    <!-- 后续功能开启时，再展示完整流程按钮 -->
    <view wx:else>
      <view class="row space-between mt-16" wx:if="{{!isOwner && canAccept}}">
        <view class="btn btn-primary" bindtap="accept">接受任务</view>
        <view class="btn btn-outline" bindtap="toChat" style="position:relative;">
          先沟通
          <view
            wx:if="{{peerUnreadCount > 0}}"
            class="chat-unread-badge"
          >
            {{ peerUnreadCount > 99 ? '99+' : peerUnreadCount }}
          </view>
        </view>
      </view>
      <view class="row space-between mt-16" wx:if="{{!isOwner && canSubmit}}">
        <view class="btn btn-primary" bindtap="toSubmit">提交完成</view>
        <view class="btn btn-outline" bindtap="toChat" style="position:relative;">
          与业主聊天
          <view
            wx:if="{{peerUnreadCount > 0}}"
            class="chat-unread-badge"
          >
            {{ peerUnreadCount > 99 ? '99+' : peerUnreadCount }}
          </view>
        </view>
      </view>
      <!-- 非发布者，但也不是“可接单/可提交”的状态：只保留聊天 -->
      <view class="row space-between mt-16" wx:if="{{!isOwner && !canAccept && !canSubmit}}">
        <view class="btn btn-primary" bindtap="toChat" style="position:relative;">
          与业主聊天
          <view
            wx:if="{{peerUnreadCount > 0}}"
            class="chat-unread-badge"
          >
            {{ peerUnreadCount > 99 ? '99+' : peerUnreadCount }}
          </view>
        </view>
      </view>
      <!-- 发布者视角：不再显示“接受任务”，改为“聊天会话列表 + 确认完成” -->
      <view class="row space-between mt-16" wx:if="{{isOwner}}">
        <view wx:if="{{task.workerId}}" class="btn btn-outline" bindtap="toChat" style="position:relative;">
          与接单人聊天
          <view
            wx:if="{{unreadCount > 0}}"
            class="chat-unread-badge"
          >
            {{ unreadCount > 99 ? '99+' : unreadCount }}
          </view>
        </view>
        <view wx:else class="btn btn-outline" bindtap="toChatSessions" style="position:relative;">
          聊天会话列表
          <view
            wx:if="{{unreadCount > 0}}"
            class="chat-unread-badge"
          >
            {{ unreadCount > 99 ? '99+' : unreadCount }}
          </view>
        </view>
        <view wx:if="{{canApprove}}" class="btn btn-primary" bindtap="approve">确认完成</view>
      </view>
    </view>
  </view>
</view>
