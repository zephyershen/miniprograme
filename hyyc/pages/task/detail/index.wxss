@import "../../../styles/shadcn.wxss";

/* 聊天会话列表按钮未读消息红点（圆形） */
.chat-unread-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: #B95E49; /* 红点提示（跟随主题色） */
  color: #ffffff;
  font-size: 20rpx;
  line-height: 36rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 2rpx #ffffff;
}
