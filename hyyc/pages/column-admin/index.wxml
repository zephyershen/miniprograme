<view class="admin-page">
  <view class="admin-hero">
    <view class="admin-kicker">会员专栏 · 内容管理</view>
    <view class="admin-title">发布基础课和动手课</view>
    <view class="admin-copy">新内容先保存为草稿。预览确认后再发布，会员正在阅读的版本不会被草稿影响。</view>
    <view class="admin-actions">
      <button class="new-button new-button-primary" data-kind="course" bindtap="createEntry" loading="{{creating === 'course'}}" disabled="{{creating !== ''}}">新建基础课</button>
      <button class="new-button" data-kind="practical" bindtap="createEntry" loading="{{creating === 'practical'}}" disabled="{{creating !== ''}}">新建动手课</button>
    </view>
  </view>

  <view class="kind-rail">
    <view class="kind-tab {{activeKind === 'course' ? 'is-active' : ''}}" data-kind="course" bindtap="selectKind">
      <text class="kind-name">基础课</text><text class="kind-count">{{courseCount}}</text>
    </view>
    <view class="kind-tab {{activeKind === 'practical' ? 'is-active' : ''}}" data-kind="practical" bindtap="selectKind">
      <text class="kind-name">动手课</text><text class="kind-count">{{practicalCount}}</text>
    </view>
  </view>
  <view class="admin-filter">
    <view class="admin-search">
      <input
        class="admin-search-input"
        value="{{query}}"
        placeholder="搜索标题、分类"
        maxlength="50"
        bindinput="onQueryInput"
      />
      <text wx:if="{{query}}" class="admin-search-clear" bindtap="clearQuery">清除</text>
    </view>
    <view class="status-filter">
      <view
        wx:for="{{statusFilters}}"
        wx:key="key"
        class="status-filter-item {{statusFilter === item.key ? 'is-active' : ''}}"
        data-status="{{item.key}}"
        bindtap="selectStatus"
      >{{item.label}}</view>
    </view>
    <view wx:if="{{query || statusFilter !== 'all'}}" class="filter-note">
      已筛选 {{items.length}} 条；清除筛选后可上下调整排序。
    </view>
  </view>

  <view wx:if="{{loading}}" class="admin-state"><loading-state label="正在读取会员专栏" /></view>
  <view wx:elif="{{error}}" class="admin-state admin-error">
    <empty-state
      title="{{error.title}}"
      copy="{{error.copy}}"
      action-label="重新读取"
      bindaction="loadEntries"
    />
  </view>
  <view wx:elif="{{!items.length}}" class="admin-state">
    <empty-state
      title="{{query || statusFilter !== 'all' ? '没有符合筛选的内容' : '这里还没有内容'}}"
      copy="{{query || statusFilter !== 'all' ? '换个关键词或状态再试。' : '从上方新建一篇，保存草稿后再预览和发布。'}}"
      action-label=""
    />
  </view>
  <view wx:else class="entry-list">
    <view wx:for="{{items}}" wx:key="id" class="entry-card {{movingId === item.id ? 'is-saving' : ''}}">
      <view class="entry-main" data-id="{{item.id}}" bindtap="openEntry">
        <view class="entry-meta">
          <text class="entry-order">{{item.orderLabel}}</text>
          <text class="status-pill status-{{item.statusView.tone}}">{{item.statusView.label}}</text>
          <text class="entry-track">{{item.trackLabel}}</text>
          <text class="edit-arrow">›</text>
        </view>
        <view class="entry-title">{{item.title}}</view>
        <view wx:if="{{item.subtitle}}" class="entry-subtitle">{{item.subtitle}}</view>
      </view>
      <view class="entry-foot">
        <view class="entry-facts">
          <text class="entry-fact">{{item.origin === 'builtin' ? '内置内容' : '新建内容'}}</text>
          <text wx:if="{{item.imageCount}}" class="entry-fact">{{item.imageCount}} 图</text>
          <text wx:if="{{movingId === item.id}}" class="entry-saving">排序保存中</text>
        </view>
        <view class="entry-tools">
          <view class="move-button {{item.canMoveUp ? '' : 'is-disabled'}}" data-id="{{item.id}}" data-direction="-1" catchtap="moveEntry">↑</view>
          <view class="move-button {{item.canMoveDown ? '' : 'is-disabled'}}" data-id="{{item.id}}" data-direction="1" catchtap="moveEntry">↓</view>
        </view>
      </view>
    </view>
  </view>
</view>
