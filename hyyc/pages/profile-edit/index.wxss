.profile-editor { box-sizing: border-box; min-height: 100vh; padding: 46rpx var(--ui-gutter) 100rpx; background: var(--ui-surface-solid); }
.editor-intro { padding: 8rpx 4rpx 34rpx; }
.editor-kicker { color: var(--ui-accent); font-size: 20rpx; font-weight: 740; }
.editor-title { margin-top: 16rpx; color: var(--ui-ink); font-size: 48rpx; font-weight: 790; line-height: 1.24; letter-spacing: -2rpx; }
.editor-copy { margin-top: 16rpx; color: var(--ui-muted); font-size: 24rpx; line-height: 1.65; }
.editor-loading { padding: 80rpx 20rpx; color: var(--ui-muted); text-align: center; }
.editor-card { padding: 34rpx 30rpx 30rpx; border: 1rpx solid var(--ui-hairline); border-radius: 32rpx; background: var(--ui-surface); }
.avatar-picker { display: flex; min-height: 120rpx; align-items: center; gap: 24rpx; margin: 0; padding: 0; border: 0; background: transparent; text-align: left; }
.avatar-picker::after { border: 0; }
.avatar-image, .avatar-empty { box-sizing: border-box; width: 112rpx; height: 112rpx; border-radius: 50%; }
.avatar-image { background: var(--ui-surface-muted); }
.avatar-empty { display: flex; align-items: center; justify-content: center; border: 2rpx dashed #8ebfdd; background: var(--ui-accent-soft); color: var(--ui-accent); font-size: 52rpx; font-weight: 400; }
.avatar-action { color: var(--ui-accent-strong); font-size: 24rpx; font-weight: 710; }
.nickname-field { position: relative; margin-top: 34rpx; }
.field-label { color: var(--ui-muted); font-size: 20rpx; font-weight: 680; }
.nickname-input { box-sizing: border-box; height: 94rpx; margin-top: 10rpx; padding: 0 106rpx 0 22rpx; border: 1rpx solid var(--ui-hairline); border-radius: 20rpx; background: var(--ui-surface-solid); color: var(--ui-ink); font-size: 27rpx; }
.field-count { position: absolute; right: 20rpx; bottom: 34rpx; color: var(--ui-faint); font-size: 18rpx; }
.editor-submit { min-height: 82rpx; margin: 32rpx 0 0; border: 0; border-radius: 22rpx; background: var(--ui-accent); color: #fff; font-size: 25rpx; font-weight: 720; line-height: 82rpx; }
.editor-submit::after { border: 0; }
.editor-submit[disabled] { background: #dfe7ec; color: #8b98a2; }
.privacy-note { padding: 24rpx 12rpx; color: var(--ui-faint); font-size: 19rpx; line-height: 1.65; }
