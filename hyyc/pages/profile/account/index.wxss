@import "../../../styles/shadcn.wxss";

.account-page {
  min-height: 100vh;
  background: #F5F6F8;
}

/* 主内容区 */
.content {
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

.panel {
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
}

.panel-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #1F2328;
  margin-bottom: 28rpx;
}

/* 表单样式 */
.form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.field-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.field-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #6B7280;
}

.field-input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(237, 239, 242, 0.9);
  background: rgba(255, 255, 255, 0.7);
  font-size: 30rpx;
  color: #1F2328;
}

.field-input.field-readonly {
  background: rgba(242, 243, 245, 0.6);
  color: #9CA3AF;
}

.field-select {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(237, 239, 242, 0.9);
  background: rgba(255, 255, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  color: #1F2328;
}

.field-select .placeholder {
  color: #9CA3AF;
}

.select-arrow {
  font-size: 36rpx;
  color: #9CA3AF;
}

/* 保存按钮 */
.actions {
  margin-top: 36rpx;
}

.btn-save {
  width: 100%;
  height: 92rpx;
  border-radius: 999rpx;
  background: #1F2328;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(31, 35, 40, 0.2);
}

.btn-save:active {
  opacity: 0.9;
}

/* 联系管理员卡片 */
.contact-panel {
  margin-top: 24rpx;
}

.contact-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.contact-text {
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 8rpx;
}

.contact-item {
  font-size: 26rpx;
  color: #2F6B3D;
  font-weight: 600;
}
