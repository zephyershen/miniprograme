<ui-loading show="{{isLoading}}" />
<view class="profile-page">
  <!-- 顶部：背景图 + 用户信息 -->
  <view class="hero">
    <image class="hero-bg" src="/assets/pages/profile/indoor.svg" mode="aspectFit"></image>
    <view class="hero-mask"></view>

    <view class="hero-inner">
      <view class="user-strip" bindtap="gotoAccount">
        <image wx:if="{{user.avatarDisplayUrl || user.avatarFileID}}" class="avatar avatar-lg" src="{{user.avatarDisplayUrl || user.avatarFileID}}" mode="aspectFill"></image>
        <view wx:else class="avatar avatar-lg"></view>
        <view class="user-text">
          <text class="user-name">{{user.nickname||'未实名'}}</text>
          <text class="user-sub">{{user.community||'未设置小区'}} · {{user.realname?'已实名':'未实名'}}</text>
          <text class="user-sub" wx:if="{{user.building || user.door}}">{{user.building||''}} {{user.door?('· '+user.door):''}}</text>
        </view>
        <text class="user-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 下方：功能面板 -->
  <view class="content">
    <view class="panel card card-glass" style="position: relative; left: 0rpx; top: 25rpx">
      <view class="quick-grid">
        <view class="quick-item" bindtap="gotoMyTasks">
          <view class="quick-icon quick-icon-task">
            <image class="quick-icon-svg" src="/assets/pages/profile/task.svg" mode="aspectFit"></image>
          </view>
          <text class="quick-label">任务</text>
        </view>
        <view class="quick-item" bindtap="gotoMyGoods">
          <view class="quick-icon quick-icon-goods">
            <image class="quick-icon-png" src="/assets/tabbar/goods-unclick.png" mode="aspectFit"></image>
          </view>
          <text class="quick-label">商品</text>
        </view>
        <view class="quick-item" bindtap="gotoFavorites">
          <view class="quick-icon quick-icon-favorite">
            <image class="quick-icon-svg" src="/assets/pages/goods/detail/favorite-clicked.svg" mode="aspectFit"></image>
          </view>
          <text class="quick-label">收藏</text>
        </view>
        <view class="quick-item" bindtap="gotoWallet">
          <view class="quick-icon quick-icon-wallet">
            <image class="quick-icon-svg" src="/assets/pages/profile/wallet.svg" mode="aspectFit"></image>
          </view>
          <text class="quick-label">钱包</text>
        </view>
      </view>
    </view>

    <view class="logout-btn" bindtap="logout">退出登录</view>
  </view>
</view>
