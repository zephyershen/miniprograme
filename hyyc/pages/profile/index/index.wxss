@import "../../../styles/shadcn.wxss";

.profile-page {
  min-height: 100vh;
}

/* 顶部背景区（参考截图：上方有插画背景，下方功能卡片叠上来） */
.hero {
  position: relative;
  height: 710rpx;
  background: #F3F1EE;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  left: 50%;
  top: -48rpx;
  width: 920rpx;
  height: 620rpx;
  transform: translateX(-50%);
  opacity: 0.92;
  pointer-events: none;
}

/* 让底部与页面背景自然过渡 */
.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 220rpx;
  background: linear-gradient(180deg, rgba(245, 246, 248, 0) 0%, rgba(245, 246, 248, 1) 100%);
  pointer-events: none;
}

.hero-inner {
  position: relative;
  height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
}

.user-strip {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 20rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(237, 239, 242, 0.9);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 10rpx 28rpx rgba(17, 24, 39, 0.06),
              0 4rpx 12rpx rgba(17, 24, 39, 0.04);
}

.user-text {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #1F2328;
  line-height: 1.2;
}

.user-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.2;
}

.user-arrow {
  font-size: 44rpx;
  color: #9CA3AF;
  margin-left: 8rpx;
}

.content {
  position: relative;
  z-index: 2;
  padding: 0 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.panel {
  border-radius: 28rpx;
}

/* 快捷入口（图标+文字） */
.quick-grid {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 18rpx;
}

.quick-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0;
  border-radius: 20rpx;
}

.quick-item:active {
  background: rgba(242, 243, 245, 0.9);
}

.quick-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 22rpx rgba(17, 24, 39, 0.12);
}

.quick-icon-text {
  font-size: 32rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1;
}

.quick-icon-svg {
  width: 47rpx;
  height: 47rpx;
}

.quick-icon-account {
  background: rgba(185, 94, 73, 0.92);
}

.quick-icon-task {
  width: 80rpx;
  height: 80rpx;
  background: none;
  box-shadow: none;
}

.quick-icon-task .quick-icon-svg {
  width: 80rpx;
  height: 80rpx;
}

.quick-icon-goods {
  width: 80rpx;
  height: 80rpx;
  background: none;
  box-shadow: none;
}

.quick-icon-wallet {
  width: 80rpx;
  height: 80rpx;
  background: none;
  box-shadow: none;
}

.quick-icon-favorite {
  width: 80rpx;
  height: 80rpx;
  background: none;
  box-shadow: none;
}

.quick-icon-favorite .quick-icon-svg {
  width: 72rpx;
  height: 72rpx;
}

.quick-icon-wallet .quick-icon-svg {
  width: 80rpx;
  height: 80rpx;
}

.quick-icon-png {
  width: 72rpx;
  height: 72rpx;
}

.quick-label {
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1F2328;
}

/* 菜单列表 */
.menu {
  margin-top: 4rpx;
}

.menu-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 12rpx;
  border-radius: 20rpx;
}

.menu-item:active {
  background: #F2F3F5;
}

.menu-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2328;
}

.menu-title-danger {
  color: #EF4444;
}

.menu-item-danger:active {
  background: rgba(239, 68, 68, 0.08);
}

.menu-arrow {
  font-size: 42rpx;
  color: #9CA3AF;
}

.logout-btn {
  margin: 48rpx 24rpx 0;
  padding: 24rpx 0;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #6B7280;
  background: rgba(107, 114, 128, 0.08);
  border-radius: 20rpx;
}

.logout-btn:active {
  background: rgba(107, 114, 128, 0.15);
}

.dev-panel {
  margin: 24rpx 24rpx 0;
  padding: 20rpx;
  border-radius: 24rpx;
}

.dev-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #111827;
}

.dev-subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #111827;
}

.dev-tip {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.4;
}

.dev-divider {
  margin-top: 16rpx;
  height: 1rpx;
  background: rgba(229, 231, 235, 0.9);
}

.dev-form {
  margin-top: 14rpx;
}

.dev-field {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(229, 231, 235, 0.9);
}

.dev-label {
  width: 170rpx;
  flex: none;
  font-size: 24rpx;
  color: #374151;
}

.dev-input {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #111827;
}

.dev-actions {
  margin-top: 18rpx;
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
}

.dev-btn {
  padding: 18rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(17, 24, 39, 0.92);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}

.dev-btn-secondary {
  background: rgba(17, 24, 39, 0.65);
}

.dev-btn:active {
  background: rgba(17, 24, 39, 0.78);
}

.dev-result {
  margin-top: 18rpx;
  max-height: 420rpx;
  padding: 14rpx;
  border-radius: 18rpx;
  background: rgba(17, 24, 39, 0.06);
}

.dev-result-text {
  font-size: 22rpx;
  color: #111827;
  word-break: break-all;
  white-space: pre-wrap;
}
