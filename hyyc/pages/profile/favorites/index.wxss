@import "../../../styles/shadcn.wxss";

.favorites-page {
  min-height: 100vh;
}

.tabs {
  display: flex;
  background: #F2F3F5;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
  gap: 6rpx;
}

.tab {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6B7280;
  border-radius: 12rpx;
}

.tab-active {
  background: #ffffff;
  color: #B95E49;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.empty {
  min-height: 280rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2328;
}

.empty-sub {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6B7280;
}

.goods-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.goods-card {
  padding: 18rpx;
}

.goods-main {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
}

.goods-cover {
  width: 176rpx;
  min-width: 176rpx;
  height: 176rpx;
  border-radius: 20rpx;
  background: #F2F3F5;
}

.goods-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #9CA3AF;
}

.goods-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.goods-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.goods-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2328;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods-status {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(185, 94, 73, 0.12);
  color: #B95E49;
  font-size: 22rpx;
}

.goods-price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 14rpx;
}

.goods-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF5040;
}

.goods-original {
  font-size: 22rpx;
  color: #9CA3AF;
  text-decoration: line-through;
}

.goods-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6B7280;
}

.goods-time {
  margin-top: auto;
  padding-top: 18rpx;
  font-size: 22rpx;
  color: #9CA3AF;
}

.goods-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
}

.action-btn {
  min-width: 144rpx;
  padding: 16rpx 24rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #F2F3F5;
  color: #6B7280;
  font-size: 24rpx;
}

.action-btn-active {
  background: rgba(185, 94, 73, 0.12);
  color: #B95E49;
}
