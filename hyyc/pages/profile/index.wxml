<view class="profile-page">
  <view class="profile-header">
    <view class="profile-kicker"><text></text>MY KNOWLEDGE</view>
    <view class="profile-title">我的</view>
    <view class="profile-deck">查看当前身份、Pro 权益和个人保存的阅读线索。</view>
  </view>

  <view wx:if="{{loading}}" class="profile-loading"><loading-state label="正在确认当前身份" /></view>
  <view wx:elif="{{error}}" class="profile-error">
    <empty-state
      title="当前身份暂时没有确认成功"
      copy="{{error}}"
      action-label="重新加载"
      bindaction="loadMembership"
    />
  </view>
  <block wx:else>
    <view class="user-profile-card" bindtap="openProfileEditor">
      <view class="user-avatar-wrap">
        <image wx:if="{{userProfile.displayAvatarUrl}}" class="user-avatar" src="{{userProfile.displayAvatarUrl}}" mode="aspectFill" />
        <view wx:else class="user-avatar user-avatar-empty">{{userProfile.initial}}</view>
        <view wx:if="{{userProfile.reviewPending}}" class="user-avatar-review">审核中</view>
      </view>
      <view class="user-profile-copy">
        <view class="user-profile-headline">
          <text class="user-profile-name">{{userProfile.displayNickname || '设置头像和昵称'}}</text>
          <view class="user-role-badge user-role-{{membership.role}}" catchtap="openMembership">
            <text wx:if="{{membership.isPrivileged}}" class="user-role-glyph">◆</text>
            <text class="user-role-text">{{membership.roleLabel}}</text>
          </view>
        </view>
        <view wx:if="{{userProfile.reviewPending}}" class="user-profile-editline">
          <text class="user-profile-editicon"></text>
          <text class="user-profile-edittext">{{userProfile.isComplete ? '资料审核中，通过前评论仍用原资料' : '资料审核中，通过后即可评论'}}</text>
        </view>
        <view wx:elif="{{userProfile.review.status === 'rejected'}}" class="user-profile-editline is-rejected">
          <text class="user-profile-editicon"></text>
          <text class="user-profile-edittext">{{userProfile.review.message}}</text>
        </view>
        <view wx:else class="user-profile-editline">
          <text class="user-profile-editicon"></text>
          <text class="user-profile-edittext">{{userProfile.isComplete ? '编辑资料，展示我的头像和昵称' : '完善头像昵称，用作评论身份'}}</text>
        </view>
      </view>
      <text class="user-profile-arrow">›</text>
    </view>

    <view class="list-group">
      <view class="list-row list-row-vip" bindtap="openMembership">
        <view class="list-icon list-icon-vip"></view>
        <text class="list-label">会员中心</text>
        <view class="list-trailing">
          <text wx:if="{{membership.isAdmin}}" class="list-hint is-vip">管理员</text>
          <text wx:elif="{{membership.isPrivileged}}" class="list-hint is-vip">Pro 会员{{membership.periodEndLabel ? ' · 到期 ' + membership.periodEndLabel : ''}}</text>
          <text wx:else class="list-hint is-vip">开通 Pro 会员</text>
        </view>
        <text class="list-caret">›</text>
      </view>
    </view>

    <view class="list-group">
      <view class="list-row" bindtap="openMessages">
        <view class="list-icon list-icon-message"></view>
        <text class="list-label">消息</text>
        <view class="list-trailing">
          <text wx:if="{{messageCenter.hasUnread}}" class="list-badge">{{messageCenter.unreadCount > 99 ? '99+' : messageCenter.unreadCount}}</text>
        </view>
        <text class="list-caret">›</text>
      </view>
      <view class="list-divider"></view>
      <view class="list-row" bindtap="openCards">
        <view class="list-icon list-icon-bookmark"></view>
        <text class="list-label">我的收藏</text>
        <view class="list-trailing"></view>
        <text class="list-caret">›</text>
      </view>
    </view>

    <view wx:if="{{membership.isActualAdmin}}" class="list-group">
      <view class="list-row" bindtap="openColumnAdmin">
        <view class="list-icon list-icon-admin"></view>
        <text class="list-label">专栏内容管理</text>
        <view class="list-trailing"><text class="list-hint">草稿 · 预览 · 发布</text></view>
        <text class="list-caret">›</text>
      </view>
    </view>

    <view wx:if="{{membership.canPreviewRoles}}" class="role-preview-block">
      <view class="role-preview-kicker">管理员测试工具</view>
      <view class="role-preview-title">切换当前账号看到的身份</view>
      <view class="role-preview-copy">只改变这个管理员账号的服务端权限预览，不会创建真实付费记录，也不会影响其他用户。</view>
      <view class="role-preview-options">
        <button
          wx:for="{{membership.roleOptions}}"
          wx:key="key"
          class="role-preview-button {{item.active ? 'is-active' : ''}}"
          data-role="{{item.key}}"
          bindtap="selectRolePreview"
          disabled="{{roleSwitching}}"
          loading="{{roleSwitching && switchingRole === item.key}}"
        >{{item.label}}</button>
      </view>
      <view wx:if="{{membership.isRolePreview}}" class="role-preview-status">正在以 {{membership.roleLabel}} 查看小程序；切到资讯、专栏或简报，或从资讯顶部打开精选，即可检查对应体验。</view>
    </view>

    <view wx:if="{{membership.isAdmin}}" class="admin-note">管理员可以查看项目实际已归档的全部资讯；“全部”不代表平台之外未收录的数据。</view>
  </block>
</view>
