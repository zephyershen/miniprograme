<view class="profile-page">
  <view class="profile-header">
    <view class="profile-kicker"><text></text>MY KNOWLEDGE</view>
    <view class="profile-title">我的</view>
    <view class="profile-deck">查看当前身份、Pro 权益和个人保存的阅读线索。</view>
  </view>

  <view wx:if="{{loading}}" class="profile-loading">正在确认当前身份…</view>
  <view wx:elif="{{error}}" class="profile-error"><view>{{error}}</view><view class="text-action" bindtap="loadMembership">重新加载 →</view></view>
  <block wx:else>
    <view class="user-profile-card" bindtap="openProfileEditor">
      <view class="user-avatar-wrap">
        <image wx:if="{{userProfile.displayAvatarUrl}}" class="user-avatar" src="{{userProfile.displayAvatarUrl}}" mode="aspectFill" />
        <view wx:else class="user-avatar user-avatar-empty">{{userProfile.initial}}</view>
        <view wx:if="{{userProfile.reviewPending}}" class="user-avatar-review">审核中</view>
      </view>
      <view class="user-profile-copy">
        <view class="user-profile-name">{{userProfile.displayNickname || '设置头像和昵称'}}</view>
        <view wx:if="{{userProfile.reviewPending}}" class="user-profile-hint">
          {{userProfile.isComplete ? '审核通过前，评论仍使用原资料' : '资料审核中，通过后即可评论'}}
        </view>
        <view wx:elif="{{userProfile.review.status === 'rejected'}}" class="user-profile-hint user-profile-rejected">{{userProfile.review.message}}</view>
        <view wx:else class="user-profile-hint">{{userProfile.isComplete ? '用于评论区展示，点击可修改' : '发布评论前需要完成个人资料'}}</view>
      </view>
      <text class="user-profile-arrow">→</text>
    </view>

    <view class="identity-block">
      <view class="identity-label">当前身份</view>
      <view class="identity-title">{{membership.roleLabel}}</view>
      <view class="identity-copy">{{membership.roleCopy}}</view>
      <view wx:if="{{membership.periodEndLabel}}" class="identity-meta">有效期至 {{membership.periodEndLabel}}</view>
      <view wx:if="{{membership.renewalLabel}}" class="identity-meta">{{membership.renewalLabel}}</view>
    </view>

    <view wx:if="{{!membership.isAdmin}}" class="pro-pass {{membership.isPrivileged ? 'pro-pass-active' : ''}}">
      <view class="pro-pass-body">
        <view class="pro-pass-topline">
          <view class="pro-pass-kicker">Pro 会员</view>
          <view class="pro-pass-status">{{membership.isPrivileged ? '已开通' : (billing.plan.durationLabel || '会员方案')}}</view>
        </view>

        <view class="pro-pass-title">{{membership.isPrivileged ? '你的 Pro 权益' : '把值得读的内容和实用课程留在一起'}}</view>
        <view class="pro-pass-copy">精选资讯、30 天回看、基础课、动手课和三档简报，一次开通即可使用。</view>

        <view wx:if="{{billing.loading}}" class="pro-offer-loading">正在读取会员价格</view>
        <view wx:elif="{{billing.available && billing.plan.priceCents}}" class="pro-offer">
          <view class="pro-offer-main">
            <view class="pro-offer-label">{{billing.plan.offerTag || '当前会员价'}}</view>
            <view class="pro-offer-line">
              <view class="pro-offer-price"><text>{{billing.plan.priceLabel}}</text><label>/ {{billing.plan.durationLabel}}</label></view>
              <view wx:if="{{billing.plan.hasDiscount}}" class="pro-offer-saving">
                <text class="pro-offer-discount">{{billing.plan.discountLabel}}</text>
                <text>· 立省 {{billing.plan.savingsLabel}}</text>
              </view>
            </view>
            <view wx:if="{{billing.plan.compareAtPriceLabel}}" class="pro-offer-compare">日常价 {{billing.plan.compareAtPriceLabel}}</view>
          </view>
        </view>
        <view wx:else class="pro-offer-loading">会员服务即将开放</view>

        <view class="pro-benefits-head"><view>包含以下权益</view><text>共 {{membership.benefits.length}} 项</text></view>
        <view class="pro-benefit-list">
          <view wx:for="{{membership.benefits}}" wx:key="key" class="pro-benefit-row">
            <view class="pro-benefit-check">✓</view>
            <view class="pro-benefit-copybox">
              <view class="pro-benefit-title">{{item.title}}</view>
              <view class="pro-benefit-copy">{{item.copy}}</view>
            </view>
          </view>
        </view>

        <view class="pro-support-boundary">{{membership.membershipTerms.supportBoundary}}</view>
        <button
          wx:if="{{billing.available}}"
          class="pro-purchase-button"
          bindtap="purchaseMembership"
          loading="{{billing.purchasing}}"
          disabled="{{billing.purchasing}}"
        >订阅</button>
        <view wx:else class="pro-purchase-footnote">当前暂不可购买，请稍后再试。</view>
        <view class="pro-renewal-note">{{membership.membershipTerms.renewalCopy}}</view>
      </view>
    </view>

    <view wx:if="{{membership.canPreviewRoles}}" class="role-preview-block">
      <view class="role-preview-kicker">管理员测试工具</view>
      <view class="role-preview-title">切换当前账号看到的身份</view>
      <view class="role-preview-copy">只改变这个管理员账号的服务端权限预览，不会创建真实付费记录，也不会影响其他用户。</view>
      <view class="role-preview-options">
        <button
          wx:for="{{membership.roleOptions}}"
          wx:key="key"
          class="role-preview-button {{item.active ? 'is-active' : ''}}"
          data-role="{{item.key}}"
          bindtap="selectRolePreview"
          disabled="{{roleSwitching}}"
          loading="{{roleSwitching && switchingRole === item.key}}"
        >{{item.label}}</button>
      </view>
      <view wx:if="{{membership.isRolePreview}}" class="role-preview-status">正在以 {{membership.roleLabel}} 查看小程序；切到资讯、专栏或简报，或从资讯顶部打开精选，即可检查对应体验。</view>
    </view>

    <view class="profile-section">
      <view class="section-title">个人内容</view>
      <view class="profile-link" bindtap="openCards"><view><view class="link-title">我的收藏</view><view class="link-copy">用一行摘要保留阅读线索，回看时仍会校验当前权限。</view></view><text>→</text></view>
    </view>

    <view wx:if="{{membership.isAdmin}}" class="admin-note">管理员可以查看项目实际已归档的全部资讯；“全部”不代表平台之外未收录的数据。</view>
  </block>
</view>
