@import "../../../styles/shadcn.wxss";

.wallet-page {
  height: 100vh;
  background: #F5F6F8;
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.wallet-error-page {
  display: flex;
  align-items: center;
  justify-content: center;
}

.error-card {
  width: 100%;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 56rpx 40rpx;
  border: 1rpx solid #EDEFF2;
  box-sizing: border-box;
  text-align: center;
}

.error-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2328;
}

.error-text {
  display: block;
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #6B7280;
}

.error-btn {
  margin-top: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #B95E49;
  border-radius: 9999rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}

.balance-card {
  flex-shrink: 0;
  background: #1F2328;
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  color: #ffffff;
  box-shadow: 0 10rpx 32rpx rgba(17, 24, 39, 0.18);
}

.balance-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.wallet-icon {
  width: 44rpx;
  height: 44rpx;
}

.balance-title {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 500;
}

.balance-amount {
  display: block;
  margin-top: 20rpx;
  font-size: 72rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.1;
  letter-spacing: -2rpx;
}

.balance-tip {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.balance-tip-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.5;
}

.balance-alert {
  font-size: 24rpx;
  color: #FFD7A8;
  line-height: 1.5;
}

.withdraw-btn {
  margin-top: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #B95E49;
  border-radius: 9999rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(185, 94, 73, 0.36);
}

.withdraw-btn:active {
  opacity: 0.88;
}

.withdraw-btn-disabled {
  background: rgba(255, 255, 255, 0.15);
  color: rgba(255, 255, 255, 0.4);
  box-shadow: none;
}

.withdraw-btn-disabled:active {
  opacity: 1;
}

.section {
  margin-top: 32rpx;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.section-panel {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  background: #EEF2F5;
  border-radius: 28rpx;
  border: 1rpx solid #E2E7EC;
  overflow: hidden;
}

.section-head {
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2328;
  flex: 1;
}

.filter-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
  flex-wrap: wrap;
}

.filter-chip {
  min-width: 132rpx;
  padding: 16rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #D8DDE6;
  background: rgba(255, 255, 255, 0.78);
  color: #6B7280;
  font-size: 24rpx;
  text-align: center;
  box-sizing: border-box;
}

.filter-chip-active {
  background: #1F2328;
  border-color: #1F2328;
  color: #ffffff;
}

.filter-chip-disabled {
  opacity: 0.72;
}

.date-filter-trigger {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 260rpx;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid #D8DDE6;
}

.date-filter-label {
  min-width: 0;
  font-size: 24rpx;
  color: #1F2328;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.date-filter-arrow {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #6B7280;
}

.empty-box {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 240rpx;
  margin: 0 24rpx 24rpx;
  background: #F8F9FB;
  border-radius: 24rpx;
}

.tx-scroll {
  height: 100%;
  min-height: 0;
}

.tx-scroll-wrap {
  position: relative;
  flex: 1;
  min-height: 0;
}

.panel-loading-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  background: rgba(238, 242, 245, 0.88);
}

.panel-loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(31, 35, 40, 0.08);
  border-top-color: #B95E49;
  animation: wallet-spin 0.8s linear infinite;
}

.panel-loading-text {
  font-size: 24rpx;
  color: #6B7280;
}

.tx-scroll-inner {
  min-height: 100%;
  box-sizing: border-box;
}

.tx-list {
  background: #ffffff;
  border-radius: 22rpx;
  border: 1rpx solid #E6EBF0;
  overflow: hidden;
}

.tx-scrollbar {
  position: absolute;
  top: 18rpx;
  right: 8rpx;
  bottom: 18rpx;
  width: 8rpx;
  border-radius: 999rpx;
  background: rgba(31, 35, 40, 0.05);
  pointer-events: none;
}

.tx-scrollbar-thumb {
  width: 100%;
  border-radius: 999rpx;
  background: rgba(31, 35, 40, 0.14);
}

.tx-item {
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #F2F3F5;
}

.tx-item:last-child {
  border-bottom: none;
}

.tx-main {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.tx-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.tx-type {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2328;
  line-height: 1.4;
}

.tx-summary {
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.5;
}

.tx-time {
  font-size: 22rpx;
  color: #9CA3AF;
}

.tx-amount {
  font-size: 30rpx;
  font-weight: 700;
}

.tx-income {
  color: #447244;
}

.tx-expense {
  color: #EF4444;
}

.load-more-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0 0;
}

.load-more-text {
  font-size: 22rpx;
  color: #9CA3AF;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.32);
}

.sheet-card {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2328;
}

.sheet-reset {
  font-size: 24rpx;
  color: #B95E49;
}

.sheet-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.sheet-chip {
  min-width: 132rpx;
  padding: 16rpx 18rpx;
  text-align: center;
  font-size: 24rpx;
  color: #6B7280;
  border-radius: 999rpx;
  background: #F5F6F8;
  border: 1rpx solid #E4E8EE;
  box-sizing: border-box;
}

.sheet-chip-active {
  background: #1F2328;
  border-color: #1F2328;
  color: #ffffff;
}

.sheet-date-box {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.sheet-date-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #F8F9FB;
  border: 1rpx solid #E7EBF0;
}

.sheet-date-label {
  font-size: 24rpx;
  color: #6B7280;
}

.sheet-date-value {
  font-size: 26rpx;
  color: #1F2328;
  font-weight: 600;
}

.sheet-action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.sheet-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.sheet-btn-secondary {
  background: #F2F4F7;
  color: #4B5563;
}

.sheet-btn-primary {
  background: #B95E49;
  color: #ffffff;
}

@keyframes wallet-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
