@import "../../../styles/shadcn.wxss";

.wallet-page {
  min-height: 100vh;
  background: #F5F6F8;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 余额卡片 */
.balance-card {
  background: #1F2328;
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  color: #ffffff;
  box-shadow: 0 10rpx 32rpx rgba(17, 24, 39, 0.18);
}

.balance-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.wallet-icon {
  width: 44rpx;
  height: 44rpx;
}

.balance-title {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 500;
}

.balance-amount {
  display: block;
  margin-top: 20rpx;
  font-size: 72rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.1;
  letter-spacing: -2rpx;
}

.balance-tip {
  margin-top: 16rpx;
}

.balance-tip-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.withdraw-btn {
  margin-top: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #B95E49;
  border-radius: 9999rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(185, 94, 73, 0.36);
}

.withdraw-btn:active {
  opacity: 0.88;
}

.withdraw-btn-disabled {
  background: rgba(255, 255, 255, 0.15);
  color: rgba(255, 255, 255, 0.4);
  box-shadow: none;
}

.withdraw-btn-disabled:active {
  opacity: 1;
}

/* 交易记录 */
.section {
  margin-top: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2328;
  margin-bottom: 16rpx;
  display: block;
}

.empty-box {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 240rpx;
  background: #ffffff;
  border-radius: 24rpx;
  border: 1rpx solid #EDEFF2;
}

.tx-list {
  background: #ffffff;
  border-radius: 24rpx;
  border: 1rpx solid #EDEFF2;
  overflow: hidden;
}

.tx-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #F2F3F5;
}

.tx-item:last-child {
  border-bottom: none;
}

.tx-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.tx-type {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2328;
}

.tx-time {
  font-size: 22rpx;
  color: #9CA3AF;
}

.tx-amount {
  font-size: 30rpx;
  font-weight: 700;
}

.tx-income {
  color: #447244;
}

.tx-expense {
  color: #EF4444;
}
