.profile-page { box-sizing: border-box; min-height: 100vh; padding: 34rpx var(--ui-gutter) 110rpx; }
.profile-header { padding: 6rpx 4rpx 34rpx; }

.profile-kicker {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--ui-muted);
  font-family: "DIN Alternate", -apple-system, sans-serif;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.profile-kicker text {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--ui-accent);
}

.profile-title { margin-top: 18rpx; font-size: 52rpx; font-weight: 800; letter-spacing: -2rpx; line-height: 1.18; }
.profile-deck { max-width: 590rpx; margin-top: 12rpx; color: var(--ui-muted); font-size: 24rpx; line-height: 1.65; }
.profile-loading, .profile-error { padding: 80rpx 28rpx; border-radius: 32rpx; background: var(--ui-surface); box-shadow: var(--ui-shadow-soft); color: var(--ui-muted); font-size: 23rpx; }
.text-action { margin-top: 20rpx; color: var(--ui-accent); font-weight: 700; }

.user-profile-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 22rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid var(--ui-hairline);
  border-radius: 30rpx;
  background: var(--ui-surface-solid);
  box-shadow: var(--ui-shadow-soft);
}

.user-avatar-wrap { position: relative; flex: none; width: 88rpx; height: 88rpx; }
.user-avatar { width: 88rpx; height: 88rpx; border-radius: 50%; background: var(--ui-accent-soft); }
.user-avatar-empty { display: flex; align-items: center; justify-content: center; color: var(--ui-accent-strong); font-size: 30rpx; font-weight: 760; }
.user-avatar-review { position: absolute; right: -15rpx; bottom: -7rpx; padding: 5rpx 10rpx; border: 3rpx solid var(--ui-surface-solid); border-radius: 999rpx; background: #f2a83b; color: #fff; font-size: 16rpx; font-weight: 750; line-height: 1.2; white-space: nowrap; }
.user-profile-copy { flex: 1; min-width: 0; }
.user-profile-name { overflow: hidden; color: var(--ui-ink); font-size: 29rpx; font-weight: 740; text-overflow: ellipsis; white-space: nowrap; }
.user-profile-hint { margin-top: 7rpx; color: var(--ui-muted); font-size: 20rpx; line-height: 1.5; }
.user-profile-rejected { color: #a34c45; }
.user-profile-arrow { color: var(--ui-accent); font-size: 25rpx; }

.identity-block {
  overflow: hidden;
  padding: 32rpx;
  border: 1rpx solid rgba(29, 155, 240, 0.1);
  border-radius: 38rpx;
  background: var(--ui-surface-solid);
  box-shadow: var(--ui-shadow-card);
}

.identity-label, .internal-status { color: var(--ui-accent); font-size: 19rpx; font-weight: 740; }
.identity-title { margin-top: 10rpx; font-size: 44rpx; font-weight: 770; letter-spacing: -1rpx; }
.identity-copy { margin-top: 12rpx; color: var(--ui-muted); font-size: 24rpx; line-height: 1.65; }
.identity-meta { margin-top: 12rpx; font-size: 21rpx; font-weight: 680; }

.account-session-block {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 22rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid var(--ui-hairline);
  border-radius: 26rpx;
  background: var(--ui-surface-solid);
}

.account-session-copy { flex: 1; min-width: 0; }
.account-session-title { color: var(--ui-ink); font-size: 24rpx; font-weight: 720; }
.account-session-note { margin-top: 7rpx; color: var(--ui-muted); font-size: 18rpx; line-height: 1.55; }
.account-session-button { flex: none; min-height: 64rpx; margin: 0; padding: 0 20rpx; border: 0; border-radius: 18rpx; background: var(--ui-accent-soft); color: var(--ui-accent-strong); font-size: 20rpx; font-weight: 700; line-height: 64rpx; }
.account-session-button::after { border: 0; }
.account-session-button[disabled] { opacity: .58; }
.account-session-logout { background: #fff3f1; color: #a34c45; }

.coverage-line {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 8rpx 20rpx;
  margin-top: 22rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  color: var(--ui-muted);
  font-size: 18rpx;
}

.role-preview-block,
.pro-pass,
.profile-section {
  margin-top: 22rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 34rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-shadow-soft);
}

.role-preview-kicker { color: var(--ui-accent); font-size: 19rpx; font-weight: 740; }
.role-preview-title { margin-top: 10rpx; font-size: 31rpx; font-weight: 750; }
.role-preview-copy { margin-top: 12rpx; color: var(--ui-muted); font-size: 21rpx; line-height: 1.65; }

.role-preview-options {
  display: flex;
  gap: 5rpx;
  margin-top: 24rpx;
  padding: 6rpx;
  border-radius: 24rpx;
  background: var(--ui-surface-muted);
}

.role-preview-button {
  flex: 1;
  width: 0;
  min-width: 0;
  min-height: 70rpx;
  margin: 0;
  padding: 0 6rpx;
  border: 0;
  border-radius: 19rpx;
  background: transparent;
  color: var(--ui-muted);
  font-size: 21rpx;
  font-weight: 680;
  line-height: 70rpx;
}

.role-preview-button::after { border: 0; }
.role-preview-button.is-active { background: var(--ui-surface-solid); box-shadow: 0 5rpx 16rpx rgba(30, 33, 44, 0.09); color: var(--ui-accent-strong); }
.role-preview-button[disabled] { opacity: 0.72; }

.role-preview-status {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: var(--ui-accent-soft);
  color: var(--ui-accent-strong);
  font-size: 20rpx;
  line-height: 1.55;
}

.pro-pass {
  overflow: hidden;
  padding: 0;
  border-color: var(--ui-hairline);
  background: var(--ui-surface-solid);
  box-shadow: var(--ui-shadow-card);
  color: var(--ui-ink);
}

.pro-pass-body { box-sizing: border-box; min-width: 0; padding: 32rpx 30rpx 30rpx; }
.pro-pass-topline { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.pro-pass-kicker { color: var(--ui-ink); font-size: 27rpx; font-weight: 760; }
.pro-pass-status { flex: none; color: var(--ui-faint); font-size: 18rpx; }
.pro-pass-title { max-width: 560rpx; margin-top: 26rpx; font-size: 37rpx; font-weight: 780; line-height: 1.34; letter-spacing: -1rpx; }
.pro-pass-copy { max-width: 570rpx; margin-top: 10rpx; color: var(--ui-muted); font-size: 21rpx; line-height: 1.65; }

.pro-offer {
  margin-top: 24rpx;
  padding: 21rpx 0;
  border-top: 1rpx solid var(--ui-hairline);
  border-bottom: 1rpx solid var(--ui-hairline);
  color: var(--ui-ink);
}

.pro-offer-main { min-width: 0; }
.pro-offer-label { color: var(--ui-muted); font-size: 17rpx; font-weight: 680; }
.pro-offer-line { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8rpx 20rpx; margin-top: 2rpx; }
.pro-offer-price { display: flex; align-items: baseline; gap: 9rpx; }
.pro-offer-price text { font-family: "DIN Alternate", -apple-system, sans-serif; font-size: 52rpx; font-weight: 800; letter-spacing: -1rpx; }
.pro-offer-price label { color: var(--ui-muted); font-size: 18rpx; }
.pro-offer-compare { color: var(--ui-faint); font-family: "DIN Alternate", -apple-system, sans-serif; font-size: 18rpx; text-decoration: line-through; text-decoration-thickness: 2rpx; }
.pro-offer-saving { display: flex; flex: none; align-items: center; gap: 7rpx; color: var(--ui-accent-strong); font-size: 17rpx; font-weight: 700; }
.pro-offer-discount { font-family: "DIN Alternate", -apple-system, sans-serif; }
.pro-offer-loading { margin-top: 24rpx; padding: 21rpx 0; border-top: 1rpx solid var(--ui-hairline); border-bottom: 1rpx solid var(--ui-hairline); color: var(--ui-muted); font-size: 21rpx; }

.pro-benefits-head { display: flex; align-items: baseline; justify-content: space-between; gap: 18rpx; margin-top: 28rpx; }
.pro-benefits-head view { font-size: 27rpx; font-weight: 760; }
.pro-benefits-head text { color: var(--ui-faint); font-size: 17rpx; }
.pro-benefit-list { margin-top: 8rpx; border-top: 1rpx solid var(--ui-hairline); }
.pro-benefit-row { display: flex; align-items: flex-start; gap: 14rpx; padding: 21rpx 0; border-bottom: 1rpx solid var(--ui-hairline); }
.pro-benefit-check { flex: none; width: 28rpx; margin-top: 1rpx; color: var(--ui-accent); font-size: 22rpx; font-weight: 800; line-height: 1.45; }
.pro-benefit-copybox { flex: 1; min-width: 0; }
.pro-benefit-title { font-size: 23rpx; font-weight: 720; line-height: 1.4; }
.pro-benefit-copy { margin-top: 5rpx; color: var(--ui-muted); font-size: 18rpx; line-height: 1.55; }
.pro-support-boundary { margin-top: 18rpx; color: var(--ui-faint); font-size: 17rpx; line-height: 1.55; }
.pro-purchase-button { display: flex; width: 100%; min-width: 0; min-height: 80rpx; align-items: center; justify-content: center; margin: 22rpx 0 0; padding: 0 24rpx; border: 0; border-radius: 18rpx; background: var(--ui-accent); color: #fff; font-size: 24rpx; font-weight: 760; line-height: 1; white-space: nowrap; }
.pro-purchase-button::after { border: 0; }
.pro-purchase-button[disabled] { opacity: .72; }
.pro-purchase-footnote { margin-top: 20rpx; color: var(--ui-muted); font-size: 19rpx; line-height: 1.55; text-align: center; }
.pro-account-note { margin-top: 15rpx; color: var(--ui-muted); font-size: 17rpx; line-height: 1.55; text-align: center; }
.pro-renewal-note { margin-top: 15rpx; color: var(--ui-faint); font-size: 17rpx; text-align: center; }

.profile-section { padding-bottom: 18rpx; }
.section-title { padding: 0 2rpx 12rpx; font-size: 29rpx; font-weight: 750; }

.profile-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 12rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: var(--ui-surface-muted);
}

.profile-link > view { flex: 1; min-width: 0; }
.profile-link > text { color: var(--ui-accent); font-size: 24rpx; }
.link-title { font-size: 27rpx; font-weight: 710; }
.link-title-with-badge { display: flex; align-items: center; gap: 12rpx; }
.message-count-badge { display: inline-flex; min-width: 34rpx; height: 34rpx; box-sizing: border-box; align-items: center; justify-content: center; padding: 0 9rpx; border-radius: 999rpx; background: var(--ui-accent); color: #fff; font-size: 17rpx; font-weight: 760; line-height: 34rpx; }
.link-copy { margin-top: 8rpx; color: var(--ui-muted); font-size: 20rpx; line-height: 1.55; }

.admin-note {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(29, 155, 240, 0.1);
  border-radius: 22rpx;
  background: var(--ui-accent-soft);
  color: var(--ui-muted);
  font-size: 20rpx;
  line-height: 1.65;
}
