<ui-loading show="{{isLoading}}" />

<view class="px-24 py-16">
  <view class="tabs">
    <view class="tab {{tab==='all' ? 'tab-active' : ''}}" data-k="all" bindtap="setTab">全部</view>
    <view class="tab {{tab==='pending' ? 'tab-active' : ''}}" data-k="pending" bindtap="setTab">审核中</view>
    <view class="tab {{tab==='need_fix' ? 'tab-active' : ''}}" data-k="need_fix" bindtap="setTab">需修改</view>
    <view class="tab {{tab==='posted' ? 'tab-active' : ''}}" data-k="posted" bindtap="setTab">已上架</view>
    <view class="tab {{tab==='off_shelf' ? 'tab-active' : ''}}" data-k="off_shelf" bindtap="setTab">已下架</view>
    <view class="tab {{tab==='sold' ? 'tab-active' : ''}}" data-k="sold" bindtap="setTab">已售出</view>
  </view>

  <view wx:if="{{!isLoading && (!list || list.length===0)}}" class="empty center">
    <text class="c-muted">暂无商品</text>
  </view>

  <view class="gap-12" wx:if="{{list && list.length>0}}">
    <block wx:for="{{list}}" wx:key="id">
      <view class="card goods-item">
        <view class="row space-between goods-top">
          <view class="goods-title">{{item.title || '未命名商品'}}</view>
          <view class="{{'badge ' + item.statusBadge}}">{{item.statusText}}</view>
        </view>

        <view class="goods-sub mt-8">
          <text>¥ {{item.priceText}}</text>
          <text class="sep">·</text>
          <text>{{item.createdAtText}}</text>
        </view>

        <view wx:if="{{item.needFixText}}" class="need-fix mt-8">
          {{item.needFixText}}
        </view>
        <view wx:if="{{item.auditError}}" class="need-fix mt-8">
          {{item.auditError}}
        </view>

        <view class="row row-gap-8 mt-12">
          <view
            wx:if="{{item.status==='need_fix'}}"
            class="btn btn-outline row-gap-item"
            data-id="{{item.id}}"
            bindtap="onEdit"
          >
            去修改
          </view>
          <view
            wx:if="{{item.status==='need_fix' || item.status==='pending'}}"
            class="btn btn-outline row-gap-item"
            data-id="{{item.id}}"
            bindtap="onRetryAudit"
          >
            重新审核
          </view>
          <view
            wx:if="{{item.status==='posted' || item.status==='off_shelf' || item.status==='sold'}}"
            class="btn btn-primary row-gap-item"
            data-id="{{item.id}}"
            bindtap="onView"
          >
            查看
          </view>
          <view
            wx:if="{{goodsChatEnabled && (item.status==='posted' || item.status==='off_shelf' || item.status==='sold')}}"
            class="btn btn-outline row-gap-item goods-chat-btn"
            data-id="{{item.id}}"
            data-owner-id="{{item.ownerId}}"
            data-owner-openid="{{item._openid}}"
            data-title="{{item.title || item.desc || '商品咨询'}}"
            bindtap="onConsultSessions"
          >
            咨询会话
            <view
              wx:if="{{item.goodsChatUnreadCount > 0}}"
              class="goods-chat-badge"
            >
              {{item.goodsChatUnreadCount > 99 ? '99+' : item.goodsChatUnreadCount}}
            </view>
          </view>
          <view
            wx:if="{{item.status==='posted' || item.status==='off_shelf'}}"
            class="btn btn-outline row-gap-item"
            data-id="{{item.id}}"
            data-status="{{item.status}}"
            data-payment-lock-active="{{item.paymentLockActive}}"
            bindtap="onToggleShelf"
          >
            {{item.status==='posted' ? '下架' : '重新上架'}}
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
