@import "../../../styles/shadcn.wxss";

.tabs {
  display: flex;
  background: #F2F3F5;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 16rpx;
  gap: 6rpx;
}

.tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6B7280;
  border-radius: 12rpx;
}

.tab-active {
  background: #ffffff;
  color: #B95E49;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.empty {
  height: 50vh;
}

.goods-item {
  padding: 18rpx 18rpx;
}

.goods-top {
  gap: 12rpx;
}

.goods-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2328;
  max-width: 460rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sub {
  font-size: 24rpx;
  color: #6B7280;
}

.sep {
  margin: 0 8rpx;
}

.need-fix {
  font-size: 24rpx;
  color: #EF4444;
}

.goods-chat-btn {
  position: relative;
}

.goods-chat-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #E85D4A;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
  box-shadow: 0 0 0 2rpx #ffffff;
  box-sizing: border-box;
}
