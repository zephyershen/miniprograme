@import "../../../styles/shadcn.wxss";

.tabs {
  display: flex;
  background: #F2F3F5;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 16rpx;
  gap: 6rpx;
}

.mode-tabs {
  margin-bottom: 16rpx;
}

.tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6B7280;
  border-radius: 12rpx;
}

.tab-active {
  background: #ffffff;
  color: #B95E49;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.empty {
  height: 50vh;
}

.goods-item {
  padding: 22rpx 22rpx;
  border-radius: 28rpx;
}

.goods-top {
  gap: 12rpx;
  align-items: flex-start;
}

.goods-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2328;
  flex: 1;
  min-width: 0;
  line-height: 1.35;
}

.goods-sub {
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.5;
}

.sep {
  margin: 0 8rpx;
}

.need-fix {
  font-size: 24rpx;
  color: #EF4444;
  line-height: 1.5;
}

.goods-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.action-chip {
  position: relative;
  min-width: 132rpx;
  height: 60rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 600;
  background: #F4E8E2;
  color: #B95E49;
}

.action-chip-primary {
  background: linear-gradient(135deg, #C86B4D 0%, #B95E49 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(185, 94, 73, 0.18);
}

.action-chip-outline {
  background: #ffffff;
  color: #B95E49;
  border: 2rpx solid rgba(185, 94, 73, 0.35);
}

.action-chip-danger {
  background: #FFF4F1;
  color: #D65A31;
  border: 2rpx solid rgba(214, 90, 49, 0.18);
}

.goods-chat-btn {
  position: relative;
}

.goods-chat-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #E85D4A;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
  box-shadow: 0 0 0 2rpx #ffffff;
  box-sizing: border-box;
}
