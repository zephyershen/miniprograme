@import "../../../styles/shadcn.wxss";

.withdraw-page {
  min-height: 100vh;
  background: #F5F6F8;
  padding: 24rpx;
  box-sizing: border-box;
}

.hero-card {
  background: linear-gradient(135deg, #1F2328 0%, #30363D 100%);
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  color: #ffffff;
  box-shadow: 0 10rpx 32rpx rgba(17, 24, 39, 0.18);
}

.hero-label {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hero-amount {
  display: block;
  margin-top: 20rpx;
  font-size: 72rpx;
  line-height: 1.1;
  font-weight: 800;
}

.hero-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.62);
  line-height: 1.5;
}

.hero-sub.warning {
  color: #FFE29A;
}

.section-card {
  margin-top: 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #EDEFF2;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2328;
}

.status-tag {
  min-width: 112rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 700;
  padding: 0 18rpx;
  box-sizing: border-box;
}

.status-success {
  background: rgba(68, 114, 68, 0.12);
  color: #447244;
}

.status-processing {
  background: rgba(185, 94, 73, 0.12);
  color: #B95E49;
}

.status-failed {
  background: rgba(239, 68, 68, 0.12);
  color: #EF4444;
}

.status-unbound {
  background: #F3F4F6;
  color: #6B7280;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
}

.info-row:last-of-type {
  margin-bottom: 8rpx;
}

.info-label {
  font-size: 24rpx;
  color: #6B7280;
}

.info-value {
  font-size: 24rpx;
  color: #1F2328;
  text-align: right;
}

.field-row {
  margin-top: 18rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: #374151;
  font-weight: 600;
}

.field-input,
.field-select {
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 18rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #111827;
}

.field-input {
  line-height: 88rpx;
}

.field-select {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.select-arrow {
  font-size: 34rpx;
  color: #9CA3AF;
}

.btn-primary {
  margin-top: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #B95E49;
  border-radius: 9999rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(185, 94, 73, 0.26);
}

.btn-primary:active {
  opacity: 0.88;
}

.btn-secondary {
  margin-top: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #F5F1EE;
  border: 1rpx solid rgba(185, 94, 73, 0.22);
  border-radius: 9999rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #B95E49;
}

.btn-secondary:active {
  opacity: 0.88;
}

.btn-secondary-disabled {
  opacity: 0.72;
}

.tip-box {
  padding: 20rpx 22rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 18rpx;
}

.tip-box.subtle {
  margin-top: 18rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.6;
}

.debug-text {
  font-family: monospace;
  color: #374151;
}

.amount-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.amount-hint {
  font-size: 24rpx;
  color: #6B7280;
}

.fill-all {
  font-size: 24rpx;
  color: #B95E49;
  font-weight: 700;
}
