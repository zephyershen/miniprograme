<ui-loading show="{{isLoading}}" />

<view class="withdraw-page">
  <view class="hero-card">
    <text class="hero-label">可提现余额（元）</text>
    <text class="hero-amount">{{availableBalanceText}}</text>
    <text class="hero-sub">消费记录会显示在钱包明细里，但不会影响这里的余额</text>
    <text class="hero-sub warning" wx:if="{{activeWithdraw}}">当前有一笔提现处理中，预计次日到账，请留意银行卡余额变动。</text>
    <view class="btn-secondary {{isSyncingWithdraw ? 'btn-secondary-disabled' : ''}}" wx:if="{{activeWithdraw}}" bindtap="onSyncActiveWithdraw">
      {{isSyncingWithdraw ? '同步中...' : '立即同步提现状态'}}
    </view>
  </view>

  <view class="section-card">
    <view class="section-head">
      <text class="section-title">步骤1：绑定提现银行卡</text>
      <view class="section-head-actions">
        <text class="section-toggle" wx:if="{{hasBoundCard}}" bindtap="onToggleCardForm">{{isCardFormExpanded ? '收起' : '修改'}}</text>
        <text class="status-tag status-{{cardStatus}}">{{cardStatusText}}</text>
      </view>
    </view>

    <view class="info-row" wx:if="{{hasBoundCard && boundCardNoMask}}">
      <text class="info-label">当前已绑卡</text>
      <text class="info-value">{{boundCardNoMask}}</text>
    </view>
    <block wx:if="{{!hasBoundCard || isCardFormExpanded}}">
      <view class="field-row">
        <text class="field-label">银行卡号</text>
        <input class="field-input" value="{{form.cardNo}}" bindinput="onInput" data-key="cardNo" type="number" placeholder="{{hasBoundCard ? '不改卡号可留空；换卡请重新输入' : '输入要绑定的银行卡号'}}" />
      </view>
      <view class="field-row">
        <text class="field-label">开户地址(省)</text>
        <picker mode="selector" range="{{provinceNames}}" value="{{provinceIndex}}" bindchange="onProvinceChange">
          <view class="field-select">
            <text>{{form.provName || '请选择省份'}}</text>
            <text class="select-arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="field-row">
        <text class="field-label">开户地址(市)</text>
        <picker mode="selector" range="{{cityNames}}" value="{{cityIndex}}" bindchange="onCityChange">
          <view class="field-select">
            <text>{{form.areaName || '请选择城市'}}</text>
            <text class="select-arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="btn-primary" bindtap="onBindCard">{{hasBoundCard ? '保存银行卡设置' : '绑定银行卡'}}</view>
    </block>
  </view>

  <view class="section-card">
    <view class="section-head">
      <text class="section-title">步骤2：申请提现</text>
    </view>

    <view class="tip-box" wx:if="{{!hasBoundCard}}">
      <text class="tip-text">先完成上一步绑定银行卡。</text>
    </view>
    <view class="tip-box" wx:elif="{{activeWithdraw}}">
      <text class="tip-text">当前有一笔提现处理中，预计次日到账，请留意银行卡余额变动。</text>
    </view>
    <block wx:else>
      <view class="tip-box subtle" wx:if="{{!isSelectedCashTypeOpened}}">
        <text class="tip-text">系统正在准备提现功能，首次使用时可能会慢一点。</text>
      </view>
      <view class="field-row">
        <text class="field-label">提现金额</text>
        <input class="field-input" value="{{form.amount}}" bindinput="onInput" data-key="amount" type="digit" placeholder="最低 1 元" />
      </view>
      <view class="amount-actions">
        <text class="amount-hint">最低提现 {{withdrawMin}} 元</text>
        <text class="fill-all" bindtap="onFillAll">全部提现</text>
      </view>
      <view class="btn-primary" bindtap="onSubmitWithdraw">确认提现</view>
    </block>
  </view>
</view>
