.messages-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 42rpx var(--ui-gutter) 110rpx;
  background: var(--ui-surface-solid);
}

.messages-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 8rpx 4rpx 34rpx;
}

.messages-heading { min-width: 0; }

.messages-title {
  color: var(--ui-ink);
  font-size: 46rpx;
  font-weight: 820;
  letter-spacing: -1rpx;
  line-height: 1.2;
}

.messages-deck {
  max-width: 510rpx;
  margin-top: 12rpx;
  color: var(--ui-muted);
  font-size: 23rpx;
  line-height: 1.65;
}

.read-all-action {
  width: auto;
  min-width: 132rpx;
  min-height: 62rpx;
  flex: none;
  margin: 2rpx 0 0;
  padding: 0 24rpx;
  border: 1rpx solid var(--ui-hairline);
  border-radius: 999rpx;
  background: var(--ui-accent-soft);
  color: var(--ui-accent-strong);
  font-size: 20rpx;
  font-weight: 720;
  line-height: 62rpx;
}

.read-all-action::after { border: 0; }
.read-all-action[disabled] { background: var(--ui-surface-muted); color: var(--ui-faint); opacity: 0.72; }

.messages-state-card {
  display: flex;
  min-height: 390rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 38rpx;
  border: 1rpx solid var(--ui-hairline);
  border-radius: 32rpx;
  background: var(--ui-surface);
  text-align: center;
}

.messages-spinner {
  box-sizing: border-box;
  width: 52rpx;
  height: 52rpx;
  border: 4rpx solid var(--ui-accent-soft);
  border-top-color: var(--ui-accent);
  border-radius: 50%;
  animation: messages-spin 0.8s linear infinite;
}

@keyframes messages-spin { to { transform: rotate(360deg); } }

.state-mark {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--ui-danger-soft);
  color: var(--ui-danger);
  font-size: 32rpx;
  font-weight: 780;
}

.state-mark-empty { background: var(--ui-accent-soft); color: var(--ui-accent); }
.state-title { margin-top: 24rpx; color: var(--ui-ink); font-size: 30rpx; font-weight: 760; }
.state-copy { max-width: 510rpx; margin-top: 12rpx; color: var(--ui-muted); font-size: 22rpx; line-height: 1.65; }

.state-action {
  width: auto;
  min-width: 190rpx;
  min-height: 70rpx;
  margin: 28rpx 0 0;
  padding: 0 30rpx;
  border: 0;
  border-radius: 20rpx;
  background: var(--ui-accent);
  color: var(--ui-on-accent);
  font-size: 22rpx;
  line-height: 70rpx;
}

.state-action::after { border: 0; }

.message-tabs {
  display: flex;
  gap: 10rpx;
  margin: 0 0 16rpx;
  padding: 6rpx;
  border-radius: 16rpx;
  background: var(--ui-surface-muted);
}

.message-tab {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 60rpx;
  border-radius: 12rpx;
  color: var(--ui-muted);
  font-size: 23rpx;
  font-weight: 680;
  line-height: 60rpx;
  text-align: center;
  transition: background 0.15s, color 0.15s;
}

.message-tab.is-active {
  background: var(--ui-surface-solid);
  color: var(--ui-ink);
  box-shadow: 0 2rpx 10rpx rgba(8, 20, 30, 0.06);
}

.message-tab-count {
  min-width: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--ui-accent-soft);
  color: var(--ui-accent-strong);
  font-size: 17rpx;
  font-weight: 760;
  line-height: 30rpx;
  text-align: center;
}

.message-tab.is-active .message-tab-count { background: var(--ui-accent-soft); }

.message-list { border-top: 1rpx solid var(--ui-hairline); }
.interaction-empty { display: flex; min-height: 220rpx; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; color: var(--ui-faint); font-size: 19rpx; text-align: center; }
.interaction-empty text:first-child { color: var(--ui-muted); font-size: 23rpx; font-weight: 700; }

.message-swipe-shell {
  position: relative;
  overflow: hidden;
  background: var(--ui-danger);
}

.message-delete-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  width: 136rpx;
  align-items: center;
  justify-content: center;
  background: var(--ui-danger);
  color: var(--ui-on-accent);
  font-size: 23rpx;
  font-weight: 720;
  letter-spacing: 1rpx;
}

.message-delete-action:active { background: var(--ui-danger); }

.message-swipe-content {
  position: relative;
  z-index: 1;
  width: 100%;
  background: var(--ui-surface-solid);
  transform: translateX(0);
  transition: transform 180ms cubic-bezier(0.2, 0.7, 0.2, 1);
}

.message-swipe-content.is-open { transform: translateX(-136rpx); }

.interaction-row {
  position: relative;
  display: flex;
  gap: 20rpx;
  padding: 28rpx 4rpx;
  border-bottom: 1rpx solid var(--ui-hairline);
}

.interaction-row-unread::before {
  position: absolute;
  top: 30rpx;
  left: -14rpx;
  width: 5rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: var(--ui-accent);
  content: "";
}

.interaction-row-pressed { background: var(--ui-surface-hover); }
.interaction-avatar-wrap { position: relative; width: 76rpx; height: 76rpx; flex: 0 0 76rpx; }
.interaction-avatar { display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; border-radius: 50%; background: var(--ui-accent-soft); }
.interaction-avatar-empty { color: var(--ui-accent-strong); font-size: 24rpx; font-weight: 760; }
.interaction-unread-dot { position: absolute; right: -2rpx; bottom: 0; box-sizing: border-box; width: 18rpx; height: 18rpx; border: 4rpx solid var(--ui-surface-solid); border-radius: 50%; background: var(--ui-accent); }
.interaction-main { min-width: 0; flex: 1; }
.interaction-meta { display: flex; min-width: 0; align-items: baseline; gap: 8rpx; color: var(--ui-muted); font-size: 19rpx; }
.interaction-name { overflow: hidden; max-width: 240rpx; color: var(--ui-ink); font-size: 23rpx; font-weight: 760; text-overflow: ellipsis; white-space: nowrap; }
.interaction-time { margin-left: auto; color: var(--ui-faint); white-space: nowrap; }
.interaction-copy { margin-top: 10rpx; color: var(--ui-ink); font-size: 25rpx; line-height: 1.55; }
.interaction-quote { display: flex; min-width: 0; gap: 10rpx; margin-top: 12rpx; padding: 11rpx 14rpx; border-left: 4rpx solid var(--ui-accent); background: var(--ui-accent-soft); color: var(--ui-muted); font-size: 18rpx; }
.interaction-quote text:first-child { flex: none; color: var(--ui-accent-strong); font-weight: 720; }
.interaction-quote text:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.interaction-context { display: flex; min-width: 0; align-items: center; gap: 12rpx; margin-top: 14rpx; padding: 12rpx 14rpx; border-radius: 16rpx; background: var(--ui-surface-muted); }
.interaction-context-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 4rpx; }
.interaction-context-copy text:first-child { color: var(--ui-accent-strong); font-size: 16rpx; font-weight: 720; letter-spacing: 1rpx; }
.interaction-context-copy text:last-child { overflow: hidden; color: var(--ui-muted); font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.interaction-thumbnail { width: 72rpx; height: 72rpx; flex: 0 0 72rpx; border-radius: 10rpx; background: var(--ui-hairline); }
.interaction-arrow { flex: none; color: var(--ui-accent); font-size: 23rpx; font-weight: 760; }
.system-empty { padding: 32rpx 4rpx; color: var(--ui-faint); font-size: 20rpx; }

.message-row {
  position: relative;
  display: flex;
  gap: 20rpx;
  padding: 28rpx 4rpx;
  border-bottom: 1rpx solid var(--ui-hairline);
}

.message-row::before {
  position: absolute;
  top: 30rpx;
  left: -14rpx;
  width: 5rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: transparent;
  content: "";
}

.message-row-unread::before { background: var(--ui-accent); }
.message-row-pressed { background: var(--ui-surface-hover); }

.message-signal {
  position: relative;
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--ui-accent-soft);
  color: var(--ui-accent-strong);
  font-size: 24rpx;
  font-weight: 790;
}

.message-signal-success { background: var(--ui-success-soft); color: var(--ui-success); }
.message-signal-warning { background: var(--ui-warning-soft); color: var(--ui-amber); }

.message-unread-dot {
  position: absolute;
  top: -5rpx;
  right: -5rpx;
  box-sizing: border-box;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid var(--ui-surface-solid);
  border-radius: 50%;
  background: var(--ui-accent);
}

.message-copy { flex: 1; min-width: 0; }
.message-meta { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; color: var(--ui-accent-strong); font-size: 18rpx; font-weight: 720; }
.message-time { flex: none; color: var(--ui-faint); font-weight: 520; }
.message-title { margin-top: 10rpx; color: var(--ui-ink); font-size: 27rpx; font-weight: 760; line-height: 1.42; }
.message-body { margin-top: 8rpx; color: var(--ui-muted); font-size: 21rpx; line-height: 1.6; }
.message-link { margin-top: 14rpx; color: var(--ui-accent-strong); font-size: 20rpx; font-weight: 700; }
.message-link text { margin-left: 4rpx; color: var(--ui-accent); }
.message-row:not(.message-row-unread) .message-title { color: var(--ui-ink-soft); font-weight: 690; }

@media (prefers-reduced-motion: reduce) {
  .messages-spinner { animation: none; }
  .message-row-pressed { transform: none; }
  .message-swipe-content { transition: none; }
}
