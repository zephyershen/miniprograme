.detail-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 38rpx var(--editorial-gutter) 110rpx;
}

.detail-loading,
.detail-error {
  padding: 180rpx 0;
  color: var(--editorial-muted);
}

.error-code,
.detail-kicker,
.section-label {
  color: var(--editorial-muted);
  font-size: 18rpx;
  font-weight: 750;
  letter-spacing: 2rpx;
}

.error-title {
  margin-top: 22rpx;
  color: var(--editorial-ink);
  font-size: 42rpx;
  font-weight: 800;
}

.error-copy { margin-top: 18rpx; line-height: 1.7; }
.error-action { margin-top: 26rpx; color: var(--editorial-blue); font-size: 23rpx; font-weight: 760; }
.detail-kicker { color: var(--editorial-blue); }

.detail-rule {
  display: inline-block;
  width: 32rpx;
  height: 5rpx;
  margin-right: 14rpx;
  background: var(--editorial-blue);
  vertical-align: middle;
}

.detail-title {
  margin-top: 26rpx;
  font-size: 51rpx;
  font-weight: 820;
  line-height: 1.24;
  letter-spacing: -2rpx;
}

.detail-byline {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 22rpx;
  color: var(--editorial-muted);
  font-size: 20rpx;
  line-height: 1.5;
}

.byline-source { color: var(--editorial-ink); font-weight: 700; }
.byline-separator { color: var(--editorial-faint); }

.detail-cover {
  display: block;
  width: 100%;
  height: 410rpx;
  margin-top: 30rpx;
  background: #e1ded7;
}

.source-preview {
  overflow: hidden;
  margin-top: 30rpx;
  border: 1rpx solid var(--editorial-rule);
  background: #ffffff;
}

.source-preview-image {
  display: block;
  width: 100%;
  height: 100%;
  background: #ffffff;
}

.source-preview-swiper {
  height: 850rpx;
  background: #ffffff;
}

.source-preview-dots {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  min-height: 54rpx;
  padding: 12rpx 20rpx;
  box-sizing: border-box;
  border-top: 1rpx solid var(--editorial-rule);
  background: #ffffff;
}

.source-preview-dot {
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
  background: #c7c4bc;
  transition: background 180ms ease, transform 180ms ease;
}

.source-preview-dot-active {
  background: var(--editorial-blue);
  transform: scale(1.25);
}

.quick-read {
  margin-top: 28rpx;
  padding: 30rpx 28rpx 34rpx;
  border-left: 7rpx solid var(--editorial-blue);
  background: #eceff8;
}

.quick-read-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.quick-index {
  color: var(--editorial-blue);
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.quick-title { font-size: 25rpx; font-weight: 800; }

.quick-copy {
  margin-top: 17rpx;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.6;
}

.key-section,
.related-section,
.source-section {
  padding: 46rpx 0 0;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--editorial-ink);
}

.section-title { font-size: 33rpx; font-weight: 820; }
.section-label { color: var(--editorial-blue); }

.key-row {
  display: flex;
  gap: 26rpx;
  padding: 27rpx 0;
  border-bottom: 1rpx solid var(--editorial-rule);
}

.key-index {
  flex: none;
  width: 48rpx;
  color: var(--editorial-blue);
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.7;
}

.key-copy {
  flex: 1;
  font-size: 27rpx;
  font-weight: 620;
  line-height: 1.68;
}

.related-row {
  display: flex;
  gap: 22rpx;
  min-height: 176rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--editorial-rule);
}

.related-row-no-image {
  min-height: 0;
  padding: 30rpx 0;
}

.related-row-no-image .related-copy {
  padding-left: 20rpx;
  border-left: 5rpx solid var(--editorial-rule);
}

.related-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.related-meta,
.related-source,
.source-note,
.copyright-note {
  color: var(--editorial-muted);
  font-size: 18rpx;
  line-height: 1.5;
}

.related-meta { color: var(--editorial-blue); font-weight: 700; }

.related-title {
  margin-top: 10rpx;
  font-size: 25rpx;
  font-weight: 760;
  line-height: 1.42;
}

.related-source {
  overflow: hidden;
  margin-top: auto;
  padding-top: 10rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.related-image {
  flex: none;
  width: 176rpx;
  height: 124rpx;
  background: #e1ded7;
}

.source-heading { border-bottom-color: var(--editorial-rule); }

.source-line {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 28rpx 0 24rpx;
  border-bottom: 1rpx solid var(--editorial-rule);
}

.source-copy {
  flex: 1;
  min-width: 0;
}

.source-name { font-size: 24rpx; font-weight: 750; }

.source-url-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  margin-top: 8rpx;
}

.source-url-row-expanded { align-items: flex-start; }

.source-url {
  overflow: hidden;
  flex: 1;
  min-width: 0;
  color: var(--editorial-muted);
  font-size: 19rpx;
  line-height: 1.55;
  text-decoration: underline;
  text-decoration-color: var(--editorial-rule);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.source-url-expanded {
  overflow: visible;
  overflow-wrap: anywhere;
  text-overflow: clip;
  white-space: normal;
  word-break: break-all;
}

.source-url-toggle {
  flex: none;
  color: var(--editorial-blue);
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1.55;
}

.source-open-hint {
  display: inline-block;
  margin-top: 13rpx;
  color: var(--editorial-blue);
  font-size: 20rpx;
  font-weight: 720;
}

.source-copy-action {
  flex: 0 0 108rpx;
  width: 108rpx;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--editorial-ink);
  border-radius: 0;
  background: transparent;
  color: var(--editorial-ink);
  font-size: 20rpx;
  line-height: 52rpx;
}

.source-note { margin-top: 18rpx; }
.copyright-note { margin-top: 8rpx; }
