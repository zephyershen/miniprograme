.detail-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 38rpx var(--editorial-gutter) 110rpx;
}

.detail-loading,
.detail-error {
  padding: 180rpx 0;
  color: var(--editorial-muted);
}

.error-code,
.detail-kicker,
.section-label {
  color: var(--editorial-muted);
  font-size: 18rpx;
  font-weight: 750;
  letter-spacing: 2rpx;
}

.error-title {
  margin-top: 22rpx;
  color: var(--editorial-ink);
  font-size: 42rpx;
  font-weight: 800;
}

.error-copy { margin-top: 18rpx; line-height: 1.7; }
.detail-kicker { color: var(--editorial-blue); }

.detail-rule {
  display: inline-block;
  width: 32rpx;
  height: 5rpx;
  margin-right: 14rpx;
  background: var(--editorial-blue);
  vertical-align: middle;
}

.detail-title {
  margin-top: 26rpx;
  font-size: 51rpx;
  font-weight: 820;
  line-height: 1.24;
  letter-spacing: -2rpx;
}

.detail-byline {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 22rpx;
  color: var(--editorial-muted);
  font-size: 20rpx;
  line-height: 1.5;
}

.byline-source { color: var(--editorial-ink); font-weight: 700; }
.byline-separator { color: var(--editorial-faint); }

.detail-cover {
  display: block;
  width: 100%;
  height: 410rpx;
  margin-top: 30rpx;
  background: #e1ded7;
}

.quick-read {
  margin-top: 28rpx;
  padding: 30rpx 28rpx 34rpx;
  border-left: 7rpx solid var(--editorial-blue);
  background: #eceff8;
}

.quick-read-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.quick-index {
  color: var(--editorial-blue);
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.quick-title { font-size: 25rpx; font-weight: 800; }

.quick-copy {
  margin-top: 17rpx;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.6;
}

.key-section,
.related-section,
.source-section {
  padding: 46rpx 0 0;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--editorial-ink);
}

.section-title { font-size: 33rpx; font-weight: 820; }
.section-label { color: var(--editorial-blue); }

.key-row {
  display: flex;
  gap: 26rpx;
  padding: 27rpx 0;
  border-bottom: 1rpx solid var(--editorial-rule);
}

.key-index {
  flex: none;
  width: 48rpx;
  color: var(--editorial-blue);
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.7;
}

.key-copy {
  flex: 1;
  font-size: 27rpx;
  font-weight: 620;
  line-height: 1.68;
}

.related-row {
  display: flex;
  gap: 22rpx;
  min-height: 176rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--editorial-rule);
}

.related-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.related-meta,
.related-source,
.source-host,
.source-note,
.copyright-note {
  color: var(--editorial-muted);
  font-size: 18rpx;
  line-height: 1.5;
}

.related-meta { color: var(--editorial-blue); font-weight: 700; }

.related-title {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 10rpx;
  font-size: 25rpx;
  font-weight: 760;
  line-height: 1.42;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.related-source {
  overflow: hidden;
  margin-top: auto;
  padding-top: 10rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.related-image {
  flex: none;
  width: 176rpx;
  height: 124rpx;
  background: #e1ded7;
}

.source-heading { border-bottom-color: var(--editorial-rule); }

.source-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 116rpx;
  border-bottom: 1rpx solid var(--editorial-rule);
}

.source-name { font-size: 24rpx; font-weight: 750; }
.source-host { margin-top: 5rpx; }
.source-mark { color: var(--editorial-blue); font-size: 35rpx; }

.primary-action,
.copy-action {
  width: 100%;
  margin: 24rpx 0 0;
  border-radius: 0;
  font-size: 25rpx;
  line-height: 86rpx;
}

.primary-action { background: var(--editorial-ink); color: #ffffff; }

.copy-action {
  margin-top: 14rpx;
  border: 1rpx solid var(--editorial-ink);
  background: transparent;
  color: var(--editorial-ink);
}

.source-note { margin-top: 18rpx; }
.copyright-note { margin-top: 8rpx; padding-bottom: 46rpx; border-bottom: 1rpx solid var(--editorial-rule); }
