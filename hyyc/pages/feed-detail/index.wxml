<view class="detail-page">
  <view wx:if="{{loading}}" class="detail-loading">正在读取资讯…</view>

  <view wx:elif="{{error}}" class="detail-error">
    <view class="error-code">内容暂不可用</view>
    <view class="error-title">这条资讯暂时无法打开</view>
    <view class="error-copy">{{error}}</view>
    <view wx:if="{{entitlementRequired}}" class="error-action" bindtap="openMembership">查看会员权益 →</view>
  </view>

  <block wx:elif="{{item}}">
    <view class="detail-kicker"><text class="detail-rule"></text>{{item.categoryLabel}}</view>
    <view class="detail-title">{{item.title}}</view>

    <view class="detail-byline">
      <text class="byline-source">{{item.source}}</text>
      <text class="byline-separator">·</text>
      <text>{{item.publishedLabel}}</text>
    </view>

    <image wx:if="{{item.coverFileId}}" class="detail-cover" src="{{item.coverFileId}}" mode="aspectFill" />
    <view wx:elif="{{item.previewFileIds.length}}" class="source-preview">
      <swiper
        class="source-preview-swiper"
          autoplay="{{previewAutoplay && item.previewFileIds.length > 1}}"
        circular="{{item.previewFileIds.length > 1}}"
        interval="4000"
        duration="450"
        bindchange="onPreviewChange"
      >
        <swiper-item
            wx:for="{{item.previewSlides}}"
            wx:for-item="previewSlide"
          wx:for-index="previewImageIndex"
            wx:key="fileId"
        >
          <image
            wx:if="{{previewSlide.shouldLoad}}"
            class="source-preview-image"
            src="{{previewSlide.fileId}}"
            mode="aspectFit"
            lazy-load="{{true}}"
            data-index="{{previewImageIndex}}"
            bindtap="previewSourceScreenshots"
          />
          <view wx:else class="source-preview-image source-preview-placeholder"></view>
        </swiper-item>
      </swiper>
      <view wx:if="{{item.previewFileIds.length > 1}}" class="source-preview-dots">
        <view
          wx:for="{{item.previewFileIds}}"
          wx:key="*this"
          class="source-preview-dot {{previewIndex === index ? 'source-preview-dot-active' : ''}}"
        ></view>
      </view>
    </view>

    <view wx:if="{{item.readingGuide.brief}}" class="quick-read">
      <view class="quick-read-head">
        <text class="quick-index">30″</text>
        <text class="quick-title">先抓重点</text>
      </view>
      <view class="quick-copy">{{item.readingGuide.brief}}</view>
    </view>

    <view wx:if="{{item.readingGuide.keyPoints.length}}" class="key-section">
      <view class="section-heading">
        <view class="section-title">完整摘要</view>
        <view class="section-label">其余 {{item.readingGuide.keyPoints.length}} 段</view>
      </view>
      <view wx:for="{{item.readingGuide.keyPoints}}" wx:key="indexLabel" class="key-row">
        <text class="key-index">{{item.indexLabel}}</text>
        <text class="key-copy">{{item.text}}</text>
      </view>
    </view>

    <view class="source-section">
      <view class="section-heading source-heading">
        <view class="section-title">来源与原文</view>
        <view class="section-label">原始出处</view>
      </view>
      <view class="source-line">
        <view class="source-copy">
          <view class="source-name">{{item.source}}</view>
          <view class="source-url-row {{sourceUrlExpanded ? 'source-url-row-expanded' : ''}}">
            <view
              class="source-url {{sourceUrlExpanded ? 'source-url-expanded' : ''}}"
              bindtap="openOriginal"
            >{{item.url}}</view>
            <view
              wx:if="{{sourceUrlCanExpand}}"
              class="source-url-toggle"
              catchtap="toggleSourceUrl"
            >{{sourceUrlExpanded ? '收起' : '展开'}}</view>
          </view>
          <view class="source-open-hint" bindtap="openOriginal">
            {{item.originAction.canOpen ? '打开原始页面' : '复制后在浏览器打开'}} ↗
          </view>
        </view>
        <button class="source-copy-action" bindtap="copyOriginal">复制</button>
      </view>
      <view class="source-note">{{item.originAction.note}}</view>
      <view class="copyright-note">站内仅整理公开资讯要点，不复制原文正文。</view>
    </view>

    <view wx:if="{{item.relatedItems.length}}" class="related-section">
      <view class="section-heading">
        <view class="section-title">接着看</view>
        <view class="section-label">同类更新</view>
      </view>
      <view
        wx:for="{{item.relatedItems}}"
        wx:key="id"
        class="related-row {{item.listVisualFileId ? '' : 'related-row-no-image'}}"
        data-id="{{item.id}}"
        bindtap="openRelated"
      >
        <view class="related-copy">
          <view class="related-meta">{{item.categoryLabel}} · {{item.publishedLabel}}</view>
          <view class="related-title">{{item.title}}</view>
          <view class="related-source">{{item.source}} →</view>
        </view>
        <image wx:if="{{item.listVisualFileId}}" class="related-image" src="{{item.listVisualFileId}}" mode="aspectFill" lazy-load="{{true}}" />
      </view>
    </view>
  </block>
</view>
