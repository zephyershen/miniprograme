<page-meta page-style="{{commentsOpen || membershipPromptVisible ? 'overflow: hidden;' : ''}}" />
<view class="detail-page">
  <view wx:if="{{loading}}" class="detail-loading">正在读取资讯…</view>

  <view wx:elif="{{error}}" class="detail-error">
    <view class="error-code">内容暂不可用</view>
    <view class="error-title">这条资讯暂时无法打开</view>
    <view class="error-copy">{{error}}</view>
    <view wx:if="{{entitlementRequired}}" class="error-action" bindtap="openMembership">查看会员权益 →</view>
  </view>

  <block wx:elif="{{item}}">
    <view class="detail-author">
      <view class="detail-author-avatar" aria-hidden="true">
        <text class="detail-author-initial">{{item.sourceAuthor.avatarInitial}}</text>
        <image wx:if="{{item.sourceAuthor.avatarUrl || item.sourceAuthor.fallbackAvatarUrl}}" class="detail-author-image" src="{{item.sourceAuthor.avatarUrl || item.sourceAuthor.fallbackAvatarUrl}}" mode="aspectFill" data-media-key="detail:{{item.id}}:avatar" data-file-id="{{item.sourceAuthor.avatarFileId}}" data-media-url="{{item.sourceAuthor.avatarUrl || item.sourceAuthor.fallbackAvatarUrl}}" data-media-fallback="{{item.sourceAuthor.fallbackAvatarUrl}}" data-media-path="item.sourceAuthor.avatarUrl" binderror="handleMediaError" />
      </view>
      <view class="detail-author-copy">
        <view wx:if="{{item.sourceAuthor.hasIdentity}}" class="detail-author-line">
          <text class="detail-author-name">{{item.sourceAuthor.displayName}}</text>
          <text wx:if="{{item.sourceAuthor.handleLabel}}" class="detail-author-handle">{{item.sourceAuthor.handleLabel}}</text>
        </view>
        <text wx:else class="detail-author-fallback">{{item.sourceAuthor.fallbackLabel}}</text>
        <text class="detail-time">{{item.publishedLabel}}</text>
      </view>
    </view>
    <view class="detail-title">{{item.title}}</view>

    <image wx:if="{{item.coverUrl}}" class="detail-cover" src="{{item.coverUrl}}" mode="aspectFill" data-media-key="detail:{{item.id}}:cover" data-file-id="{{item.coverFileId}}" data-media-url="{{item.coverUrl}}" data-media-path="item.coverUrl" binderror="handleMediaError" />
    <view wx:elif="{{item.previewFileIds.length}}" class="source-preview">
      <swiper
        class="source-preview-swiper"
          autoplay="{{previewAutoplay && item.previewFileIds.length > 1}}"
        circular="{{item.previewFileIds.length > 1}}"
        interval="4000"
        duration="450"
        bindchange="onPreviewChange"
      >
        <swiper-item
            wx:for="{{item.previewSlides}}"
            wx:for-item="previewSlide"
          wx:for-index="previewImageIndex"
            wx:key="fileId"
        >
          <image
            wx:if="{{previewSlide.shouldLoad && previewSlide.url}}"
            class="source-preview-image"
            src="{{previewSlide.url}}"
            mode="aspectFit"
            lazy-load="{{true}}"
            data-index="{{previewImageIndex}}"
            data-media-key="detail:{{item.id}}:preview:{{previewImageIndex}}"
            data-file-id="{{previewSlide.fileId}}"
            data-media-url="{{previewSlide.url}}"
            data-media-path="item.previewSlides[{{previewImageIndex}}].url"
            bindtap="previewSourceScreenshots"
            binderror="handleMediaError"
          />
          <view wx:else class="source-preview-image source-preview-placeholder"></view>
        </swiper-item>
      </swiper>
      <view wx:if="{{item.previewFileIds.length > 1}}" class="source-preview-dots">
        <view
          wx:for="{{item.previewFileIds}}"
          wx:key="*this"
          class="source-preview-dot {{previewIndex === index ? 'source-preview-dot-active' : ''}}"
        ></view>
      </view>
    </view>

    <view wx:if="{{item.sourceTags.length}}" class="detail-tags" aria-label="来源标签">
      <text wx:for="{{item.sourceTags}}" wx:for-item="sourceTag" wx:key="*this" class="detail-source-tag">{{sourceTag}}</text>
    </view>

    <view class="detail-actions">
      <view class="detail-action" bindtap="openComments"><view class="action-icon icon-comment"></view><text class="detail-action-label">评论{{item.engagement.commentLabel ? ' ' + item.engagement.commentLabel : ''}}</text></view>
      <view class="detail-action" bindtap="handleLike"><view class="action-icon icon-like {{item.engagement.liked ? 'icon-like-active' : ''}}"></view><text class="detail-action-label">喜欢{{item.engagement.likeLabel ? ' ' + item.engagement.likeLabel : ''}}</text></view>
      <view class="detail-action" bindtap="handleFavorite"><view class="action-icon icon-bookmark {{item.engagement.favorited ? 'icon-bookmark-active' : ''}}"></view><text class="detail-action-label">收藏</text></view>
      <button class="detail-action detail-share" open-type="share"><view class="action-icon icon-share"></view><text class="detail-action-label">分享</text></button>
    </view>

    <view wx:if="{{item.readingGuide.brief}}" class="quick-read">
      <view class="quick-read-head">
        <text class="quick-index">30″</text>
        <text class="quick-title">先抓重点</text>
      </view>
      <view class="quick-copy">{{item.readingGuide.brief}}</view>
    </view>

    <view wx:if="{{item.readingGuide.keyPoints.length}}" class="key-section">
      <view class="section-heading">
        <view class="section-title">完整摘要</view>
        <view class="section-label">其余 {{item.readingGuide.keyPoints.length}} 段</view>
      </view>
      <view wx:for="{{item.readingGuide.keyPoints}}" wx:key="indexLabel" class="key-row">
        <text class="key-index">{{item.indexLabel}}</text>
        <text class="key-copy">{{item.text}}</text>
      </view>
    </view>

    <view class="source-section">
      <view class="section-heading source-heading">
        <view class="section-title">来源与原文</view>
        <view class="section-label">原始出处</view>
      </view>
      <view class="source-line">
        <view class="source-copy">
          <view class="source-profile">
            <view class="source-profile-avatar" aria-hidden="true">
              <text class="source-profile-initial">{{item.sourceAuthor.avatarInitial}}</text>
              <image wx:if="{{item.sourceAuthor.avatarUrl || item.sourceAuthor.fallbackAvatarUrl}}" class="source-profile-image" src="{{item.sourceAuthor.avatarUrl || item.sourceAuthor.fallbackAvatarUrl}}" mode="aspectFill" data-media-key="detail:{{item.id}}:avatar" data-file-id="{{item.sourceAuthor.avatarFileId}}" data-media-url="{{item.sourceAuthor.avatarUrl || item.sourceAuthor.fallbackAvatarUrl}}" data-media-fallback="{{item.sourceAuthor.fallbackAvatarUrl}}" data-media-path="item.sourceAuthor.avatarUrl" binderror="handleMediaError" />
            </view>
            <view class="source-profile-copy">
              <view wx:if="{{item.sourceAuthor.hasIdentity}}" class="source-profile-line">
                <text class="source-name">{{item.sourceAuthor.displayName}}</text>
                <text wx:if="{{item.sourceAuthor.handleLabel}}" class="source-handle">{{item.sourceAuthor.handleLabel}}</text>
              </view>
              <view wx:else class="source-name">{{item.sourceAuthor.fallbackLabel}}</view>
            </view>
          </view>
          <view class="source-url-row {{sourceUrlExpanded ? 'source-url-row-expanded' : ''}}">
            <view
              class="source-url {{sourceUrlExpanded ? 'source-url-expanded' : ''}}"
              bindtap="openOriginal"
            >{{item.url}}</view>
            <view
              wx:if="{{sourceUrlCanExpand}}"
              class="source-url-toggle"
              catchtap="toggleSourceUrl"
            >{{sourceUrlExpanded ? '收起' : '展开'}}</view>
          </view>
          <view class="source-open-hint" bindtap="openOriginal">
            {{item.originAction.canOpen ? '打开原始页面' : '复制后在浏览器打开'}} ↗
          </view>
        </view>
        <button class="source-copy-action" bindtap="copyOriginal">复制</button>
      </view>
      <view class="source-note">{{item.originAction.note}}</view>
      <view class="copyright-note">站内仅整理公开资讯要点，不复制原文正文。</view>
    </view>

    <view wx:if="{{item.relatedItems.length}}" class="related-section">
      <view class="section-heading">
        <view class="section-title">接着看</view>
        <view class="section-label">同类更新</view>
      </view>
      <view
        wx:for="{{item.relatedItems}}"
        wx:for-index="relatedIndex"
        wx:key="id"
        class="related-row {{item.listVisualUrl ? '' : 'related-row-no-image'}}"
        data-id="{{item.id}}"
        bindtap="openRelated"
      >
        <view class="related-copy">
          <view class="related-author">
            <view class="related-avatar" aria-hidden="true">
              <text class="related-avatar-initial">{{item.sourceAuthor.avatarInitial}}</text>
              <image wx:if="{{item.sourceAuthor.avatarUrl || item.sourceAuthor.fallbackAvatarUrl}}" class="related-avatar-image" src="{{item.sourceAuthor.avatarUrl || item.sourceAuthor.fallbackAvatarUrl}}" mode="aspectFill" lazy-load="{{true}}" data-media-key="related:{{item.id}}:avatar" data-file-id="{{item.sourceAuthor.avatarFileId}}" data-media-url="{{item.sourceAuthor.avatarUrl || item.sourceAuthor.fallbackAvatarUrl}}" data-media-fallback="{{item.sourceAuthor.fallbackAvatarUrl}}" data-media-path="item.relatedItems[{{relatedIndex}}].sourceAuthor.avatarUrl" binderror="handleMediaError" />
            </view>
            <view class="related-author-copy">
              <view class="related-author-line">
                <text class="related-author-name">{{item.sourceAuthor.hasIdentity ? item.sourceAuthor.displayName : item.sourceAuthor.fallbackLabel}}</text>
                <text wx:if="{{item.sourceAuthor.handleLabel}}" class="related-handle">{{item.sourceAuthor.handleLabel}}</text>
              </view>
              <text class="related-time">{{item.publishedLabel}}</text>
            </view>
          </view>
          <view class="related-title">{{item.title}}</view>
          <view wx:if="{{item.sourceTags.length}}" class="related-tags" aria-label="来源标签">
            <text wx:for="{{item.sourceTags}}" wx:for-item="sourceTag" wx:key="*this" class="related-tag">{{sourceTag}}</text>
          </view>
        </view>
        <image wx:if="{{item.listVisualUrl}}" class="related-image" src="{{item.listVisualUrl}}" mode="aspectFill" lazy-load="{{true}}" data-media-key="related:{{item.id}}:list" data-file-id="{{item.listVisualFileId || item.visualFileId}}" data-media-url="{{item.listVisualUrl}}" data-media-path="item.relatedItems[{{relatedIndex}}].listVisualUrl" binderror="handleMediaError" />
      </view>
    </view>
  </block>

  <comment-sheet
    visible="{{commentsOpen}}"
    item-id="{{item.id}}"
    comment-count="{{item.engagement.commentCount}}"
    bindclose="closeComments"
    bindlocked="handleCommentsLocked"
    bindpublished="onCommentPublished"
    bindchanged="onCommentPublished"
  />

  <membership-prompt
    visible="{{membershipPromptVisible}}"
    feature-key="{{membershipPromptFeature}}"
    bindclose="closeMembershipPrompt"
    bindviewbenefits="openMembershipFromPrompt"
  />
</view>
