.source-error {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 150rpx var(--editorial-gutter) 80rpx;
}

.source-error-kicker {
  color: var(--editorial-blue);
  font-size: 20rpx;
  font-weight: 750;
  letter-spacing: 2rpx;
}

.source-error-title {
  margin-top: 22rpx;
  font-size: 44rpx;
  font-weight: 820;
}

.source-error-copy {
  margin-top: 20rpx;
  color: var(--editorial-muted);
  font-size: 25rpx;
  line-height: 1.7;
}

.source-copy-action {
  width: 100%;
  margin: 40rpx 0 0;
  border-radius: 0;
  background: var(--editorial-ink);
  color: #ffffff;
  font-size: 25rpx;
  line-height: 86rpx;
}
