.source-error {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 120rpx var(--ui-gutter) 80rpx;
}

.source-error::before {
  display: block;
  width: 70rpx;
  height: 70rpx;
  margin-bottom: 28rpx;
  border-radius: 24rpx;
  background: var(--ui-accent);
  content: "↗";
  color: var(--ui-on-accent);
  font-size: 32rpx;
  line-height: 70rpx;
  text-align: center;
}

.source-error-kicker { color: var(--ui-accent); font-size: 20rpx; font-weight: 700; letter-spacing: 1rpx; }
.source-error-title { margin-top: 20rpx; font-size: 43rpx; font-weight: 760; }
.source-error-copy { margin-top: 20rpx; color: var(--ui-muted); font-size: 25rpx; line-height: 1.7; }

.source-copy-action {
  width: 100%;
  margin: 38rpx 0 0;
  border-radius: 24rpx;
  background: var(--ui-ink);
  color: var(--ui-on-accent);
  font-size: 25rpx;
  line-height: 88rpx;
}
