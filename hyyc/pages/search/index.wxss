.search-page { box-sizing: border-box; min-height: 100vh; padding: 0 var(--ui-gutter) 120rpx; background: var(--ui-canvas); }
.search-head { position: sticky; z-index: 10; top: 0; margin: 0 calc(var(--ui-gutter) * -1); padding: 20rpx var(--ui-gutter) 18rpx; border-bottom: 1rpx solid var(--ui-hairline); background: rgba(246, 248, 250, .96); backdrop-filter: blur(18rpx); }
.search-box { display: flex; min-height: 84rpx; box-sizing: border-box; align-items: center; gap: 16rpx; padding: 0 12rpx 0 24rpx; border: 1rpx solid var(--ui-rule-strong); border-radius: 999rpx; background: var(--ui-surface-solid); box-shadow: var(--ui-shadow-soft); }
.search-icon { position: relative; box-sizing: border-box; width: 25rpx; height: 25rpx; flex: none; border: 4rpx solid var(--ui-muted); border-radius: 50%; }
.search-icon::after { position: absolute; right: -10rpx; bottom: -7rpx; width: 12rpx; height: 4rpx; border-radius: 99rpx; background: var(--ui-muted); content: ""; transform: rotate(45deg); transform-origin: left center; }
.search-input { min-width: 0; height: 84rpx; flex: 1; color: var(--ui-ink); font-size: 25rpx; }
.search-clear { display: flex; min-height: 60rpx; align-items: center; padding: 0 8rpx; color: var(--ui-muted-soft); font-size: 19rpx; }
.search-submit { display: flex; min-width: 96rpx; min-height: 64rpx; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--ui-ink); color: var(--ui-on-accent); font-size: 22rpx; font-weight: 740; }
.search-summary { margin-top: 14rpx; color: var(--ui-muted); font-size: 19rpx; }
.search-intro { margin-top: 34rpx; padding: 42rpx 34rpx; border: 1rpx solid var(--ui-hairline); border-radius: var(--ui-radius-xl); background: var(--ui-surface-solid); box-shadow: var(--ui-shadow-card); }
.intro-kicker { color: var(--ui-accent-strong); font-size: 17rpx; font-weight: 780; letter-spacing: 1.5rpx; }
.intro-title { margin-top: 18rpx; color: var(--ui-ink); font-size: 40rpx; font-weight: 820; line-height: 1.25; }
.intro-copy { margin-top: 16rpx; color: var(--ui-muted); font-size: 23rpx; line-height: 1.7; }
.history-block { margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid var(--ui-hairline); }
.history-head { display: flex; align-items: center; justify-content: space-between; color: var(--ui-ink-soft); font-size: 20rpx; font-weight: 720; }
.history-clear { display: flex; min-height: 60rpx; align-items: center; padding-left: 24rpx; color: var(--ui-muted-soft); font-size: 18rpx; font-weight: 500; }
.suggestion-head { margin-top: 28rpx; color: var(--ui-ink-soft); font-size: 20rpx; font-weight: 720; }
.suggestion-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 28rpx; }
.history-list { margin-top: 14rpx; }
.suggestion { display: flex; min-height: 88rpx; align-items: center; padding: 0 22rpx; border-radius: 999rpx; background: var(--ui-surface-muted); color: var(--ui-ink-soft); font-size: 21rpx; font-weight: 680; }
.history-item { background: var(--ui-surface-solid); box-shadow: inset 0 0 0 1rpx var(--ui-hairline); }
.search-state { min-height: 440rpx; margin-top: 28rpx; padding: 90rpx 30rpx; box-sizing: border-box; border-radius: var(--ui-radius-xl); background: var(--ui-surface-solid); }
.result-list { display: flex; flex-direction: column; gap: 18rpx; margin-top: 24rpx; }
.result-card { display: flex; min-height: 190rpx; box-sizing: border-box; align-items: stretch; gap: 22rpx; padding: 24rpx; border: 1rpx solid var(--ui-hairline); border-radius: var(--ui-radius-lg); background: var(--ui-surface-solid); box-shadow: var(--ui-shadow-soft); }
.result-copy { min-width: 0; flex: 1; }
.result-byline { display: flex; align-items: center; gap: 14rpx; color: var(--ui-muted-soft); font-size: 17rpx; }
.result-byline text:first-child { overflow: hidden; max-width: 260rpx; color: var(--ui-accent-strong); font-weight: 720; text-overflow: ellipsis; white-space: nowrap; }
.result-title { display: -webkit-box; overflow: hidden; margin-top: 12rpx; color: var(--ui-ink); font-size: 27rpx; font-weight: 780; line-height: 1.42; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.result-summary { display: -webkit-box; overflow: hidden; margin-top: 10rpx; color: var(--ui-muted); font-size: 21rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.search-highlight { border-radius: 4rpx; background: var(--ui-accent-soft); color: var(--ui-accent-strong); }
.result-meta { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 15rpx; color: var(--ui-faint); font-size: 17rpx; }
.result-recommendation-heat { color: var(--ui-accent-strong); font-weight: 700; }
.result-image, .result-mark { width: 156rpx; height: 156rpx; flex: none; align-self: center; border-radius: var(--ui-radius-md); background: var(--ui-surface-muted); }
.result-image { display: block; }
.result-mark { display: flex; align-items: center; justify-content: center; color: var(--ui-accent-strong); font-size: 24rpx; font-weight: 820; letter-spacing: 1rpx; }
.result-error { padding: 18rpx 22rpx; border-radius: var(--ui-radius-md); background: var(--ui-danger-soft); color: var(--ui-danger); font-size: 20rpx; }
.search-more { display: flex; min-height: 88rpx; align-items: center; justify-content: center; color: var(--ui-muted); font-size: 20rpx; }
.search-more-action { color: var(--ui-accent-strong); font-weight: 720; }
